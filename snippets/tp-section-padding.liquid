{%- assign min_vw = min_vw | default: 390 -%}
{%- assign max_vw = max_vw | default: 1440 -%}

{%- capture pad_top -%}
  {% render 'tp-clamp',
    min_px: pad_top_min,
    max_px: pad_top_max,
    min_vw: min_vw,
    max_vw: max_vw,
    use_rem: true,
    base_font: 10
  %}
{%- endcapture -%}

{%- capture pad_bottom -%}
  {% render 'tp-clamp',
    min_px: pad_bottom_min,
    max_px: pad_bottom_max,
    min_vw: min_vw,
    max_vw: max_vw,
    use_rem: true,
    base_font: 10
  %}
{%- endcapture -%}

<style>
  #section-wrapper-{{ section.id }}{
    --tp-pad-top: {{ pad_top | strip }};
    --tp-pad-bottom: {{ pad_bottom | strip }};
  }
  {% if enable_pad_top_mobile or enable_pad_bottom_mobile %}
    @media screen and (max-width: 1023px) {
      #section-wrapper-{{ section.id }}{
        {% if enable_pad_top_mobile %}
          --tp-pad-top: {{ pad_top_mobile }}px;
        {% endif %}
        {% if enable_pad_bottom_mobile %}
          --tp-pad-bottom: {{ pad_bottom_mobile }}px;
        {% endif %}
      }
    }
  {% endif %}
  {% if enable_pad_top_desktop or enable_pad_bottom_desktop %}
    @media screen and (min-width: 1024px) {
      #section-wrapper-{{ section.id }}{
        {% if enable_pad_top_desktop %}
          --tp-pad-top: {{ pad_top_desktop }}px;
        {% endif %}
        {% if enable_pad_bottom_desktop %}
          --tp-pad-bottom: {{ pad_bottom_desktop }}px;
        {% endif %}
      }
    }
  {% endif %}
</style>


