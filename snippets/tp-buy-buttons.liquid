{% comment %}
  Accepts:
  - product: {Object}
  - block: {Object}
  - product_form_id: {String}
  - section_id: {String}
{% endcomment %}

{%- assign btn_text = block.settings.button_text | default: 'Comprar agora' -%}
{%- assign variant = product.selected_or_first_available_variant -%}

{% comment %} Form oculto com input[name="id"] — product-info.js::updateVariantInputs atualiza este input ao trocar variante {% endcomment %}
<form id="{{ product_form_id }}" style="display:none" aria-hidden="true">
  <input
    type="hidden"
    name="id"
    value="{{ variant.id }}"
    class="product-variant-id"
    {% unless variant.available %}disabled{% endunless %}
  >
</form>

<tp-buy-buttons
  class="tp-buy-buttons"
  data-section-id="{{ section_id }}"
  data-form-id="{{ product_form_id }}"
  data-variant-id="{{ variant.id }}"
  {{ block.shopify_attributes }}
>
  <div class="tp-buy-buttons__qty" aria-label="Quantidade">
    <button class="tp-buy-buttons__qty-btn" type="button" data-action="minus" aria-label="Diminuir">−</button>
    <span class="tp-buy-buttons__qty-value" aria-live="polite" aria-label="Quantidade: ">1</span>
    <button class="tp-buy-buttons__qty-btn" type="button" data-action="plus" aria-label="Aumentar">+</button>
  </div>

  <button
    class="tp-buy-buttons__submit"
    type="button"
    id="TpSubmitButton-{{ section_id }}"
    {% unless variant.available %}disabled{% endunless %}
  >
    <span>
      {%- if variant.available -%}
        {{ btn_text }}
      {%- else -%}
        {{ 'products.product.sold_out' | t }}
      {%- endif -%}
    </span>
    {%- render 'loading-spinner' -%}
  </button>
</tp-buy-buttons>

<script>
  if (!customElements.get('tp-buy-buttons')) {
    customElements.define('tp-buy-buttons', class TpBuyButtons extends HTMLElement {
      connectedCallback() {
        this._qty = 1;
        this._qtyEl = this.querySelector('.tp-buy-buttons__qty-value');
        this._submitBtn = this.querySelector('.tp-buy-buttons__submit');
        this._submitText = this._submitBtn.querySelector('span');
        this._spinner = this._submitBtn.querySelector('.loading__spinner');
        this._defaultText = this._submitText.textContent.trim();

        this.querySelector('[data-action="minus"]').addEventListener('click', () => this._changeQty(-1));
        this.querySelector('[data-action="plus"]').addEventListener('click', () => this._changeQty(1));
        this._submitBtn.addEventListener('click', () => this._addToCart());

        // Sincroniza com vehicle model
        this._syncVehicleModel();

        // Escuta variant-change (PUB_SUB_EVENTS.variantChange = 'variant-change') só para estado do botão.
        // O variant ID real é sempre lido de input.product-variant-id no form oculto,
        // que product-info.js::updateVariantInputs atualiza diretamente.
        document.addEventListener('variant-change', (e) => {
          const detail = e.detail?.data ?? e.detail;
          if (detail?.sectionId !== this.dataset.sectionId) return;
          const variant = detail.variant;
          if (!variant) return;
          this._submitBtn.toggleAttribute('disabled', !variant.available);
          this._submitText.textContent = variant.available
            ? (this._submitBtn.dataset.text || this._defaultText)
            : window.variantStrings?.soldOut || 'Esgotado';
        });
      }

      _changeQty(delta) {
        this._qty = Math.max(1, this._qty + delta);
        this._qtyEl.textContent = this._qty;
      }

      _syncVehicleModel() {
        const sectionId = this.dataset.sectionId;
        const input = document.getElementById('VehicleModel-' + sectionId);
        if (!input || input.dataset.vehicleModelRequired !== 'true') return;

        const update = () => this._submitBtn.toggleAttribute('disabled', input.value.trim() === '');
        update();
        input.addEventListener('input', update);
      }

      _getVariantId() {
        const form = document.getElementById(this.dataset.formId);
        return form?.querySelector('.product-variant-id')?.value || this.dataset.variantId;
      }

      _getProperties() {
        const formId = this.dataset.formId;
        const entries = [];

        const form = document.getElementById(formId);
        if (form) {
          form.querySelectorAll('input[name^="properties["]').forEach(el => {
            entries.push([el.name, el.value]);
          });
        }

        document.querySelectorAll(`input[name^="properties["][form="${formId}"]`).forEach(el => {
          if (el.value.trim()) entries.push([el.name, el.value]);
        });

        return entries;
      }

      _addToCart() {
        if (this._submitBtn.hasAttribute('disabled')) return;

        // Valida vehicle model
        const sectionId = this.dataset.sectionId;
        const vehicleInput = document.getElementById('VehicleModel-' + sectionId);
        if (vehicleInput?.dataset.vehicleModelRequired === 'true' && !vehicleInput.value.trim()) {
          const errorEl = document.getElementById('VehicleModelError-' + sectionId);
          errorEl?.removeAttribute('hidden');
          vehicleInput.setAttribute('aria-invalid', 'true');
          vehicleInput.focus();
          return;
        }

        this._setLoading(true);

        const cartEl = document.querySelector('cart-drawer') || document.querySelector('cart-notification');

        // Mesmo padrão do product-form.js: FormData + fetchConfig
        const config = fetchConfig('javascript');
        config.headers['X-Requested-With'] = 'XMLHttpRequest';
        delete config.headers['Content-Type'];

        const formData = new FormData();
        formData.append('id', this._getVariantId());
        formData.append('quantity', this._qty);

        this._getProperties().forEach(([name, val]) => {
          formData.append(name, val);
        });

        if (cartEl) {
          formData.append('sections', cartEl.getSectionsToRender().map(s => s.id));
          formData.append('sections_url', window.location.pathname);
          cartEl.setActiveElement(document.activeElement);
        }

        config.body = formData;

        fetch(routes.cart_add_url, config)
          .then(res => res.json())
          .then(response => {
            if (response.status) {
              console.error('[tp-buy-buttons]', response.description);
              return;
            }
            if (!cartEl) {
              window.location = window.routes.cart_url;
              return;
            }
            publish(PUB_SUB_EVENTS.cartUpdate, {
              source: 'product-form',
              productVariantId: this._getVariantId(),
              cartData: response,
            });
            cartEl.renderContents(response);
          })
          .catch(e => console.error('[tp-buy-buttons]', e))
          .finally(() => {
            this._setLoading(false);
            if (cartEl?.classList.contains('is-empty')) cartEl.classList.remove('is-empty');
          });
      }

      _setLoading(on) {
        if (on) {
          this._submitBtn.setAttribute('disabled', '');
          this._submitText.classList.add('hidden');
          this._spinner?.classList.remove('hidden');
        } else {
          this._submitBtn.removeAttribute('disabled');
          this._submitText.classList.remove('hidden');
          this._spinner?.classList.add('hidden');
          // Re-sync vehicle model após loading
          this._syncVehicleModel();
        }
      }
    });
  }
</script>
