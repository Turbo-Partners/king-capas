{% comment %}
  Accepts:
  - product: {Object}
  - block: {Object}
  - product_form_id: {String}
  - section_id: {String}
{% endcomment %}

{%- assign btn_text = block.settings.button_text | default: 'Comprar agora' -%}
{%- assign variant = product.selected_or_first_available_variant -%}

<tp-buy-buttons
  class="tp-buy-buttons"
  data-section-id="{{ section_id }}"
  data-form-id="{{ product_form_id }}"
  data-variant-id="{{ variant.id }}"
  {{ block.shopify_attributes }}
>
  <div class="tp-buy-buttons__qty" aria-label="Quantidade">
    <button class="tp-buy-buttons__qty-btn" type="button" data-action="minus" aria-label="Diminuir">−</button>
    <span class="tp-buy-buttons__qty-value" aria-live="polite" aria-label="Quantidade: ">1</span>
    <button class="tp-buy-buttons__qty-btn" type="button" data-action="plus" aria-label="Aumentar">+</button>
  </div>

<div {{ block.shopify_attributes }}>
  {%- if product != blank -%}
    {%- liquid
      assign gift_card_recipient_feature_active = false
      if block.settings.show_gift_card_recipient and product.gift_card?
        assign gift_card_recipient_feature_active = true
      endif

      assign show_dynamic_checkout = false
      if block.settings.show_dynamic_checkout and gift_card_recipient_feature_active == false
        assign show_dynamic_checkout = true
      endif
    -%}

    <product-form
      class="product-form"
      data-hide-errors="{{ gift_card_recipient_feature_active }}"
      data-section-id="{{ section.id }}"
    >
      <div class="product-form__error-message-wrapper" role="alert" hidden>
        <span class="svg-wrapper">
          {{- 'icon-error.svg' | inline_asset_content -}}
        </span>
        <span class="product-form__error-message"></span>
      </div>

      {%- form 'product',
        product,
        id: product_form_id,
        class: 'form',
        novalidate: 'novalidate',
        data-type: 'add-to-cart-form'
      -%}
        <input
          type="hidden"
          name="id"
          value="{{ product.selected_or_first_available_variant.id }}"
          {% if product.selected_or_first_available_variant.available == false
            or quantity_rule_soldout
            or product.selected_or_first_available_variant == null
          %}
            disabled
          {% endif %}
          class="product-variant-id"
        >

        {%- if gift_card_recipient_feature_active -%}
          {%- render 'gift-card-recipient-form', product: product, form: form, section: section -%}
        {%- endif -%}

        <div class="product-form__buttons">
          {%- liquid
            assign check_against_inventory = true
            if product.selected_or_first_available_variant.inventory_management != 'shopify' or product.selected_or_first_available_variant.inventory_policy == 'continue'
              assign check_against_inventory = false
            endif
            if product.selected_or_first_available_variant.quantity_rule.min > product.selected_or_first_available_variant.inventory_quantity and check_against_inventory
              assign quantity_rule_soldout = true
            endif
          -%}
          <button
            id="ProductSubmitButton-{{ section_id }}"
            type="submit"
            name="add"
            class="product-form__submit button button--full-width {% if show_dynamic_checkout %}button--secondary{% else %}button--primary{% endif %}"
            {% if product.selected_or_first_available_variant.available == false
              or quantity_rule_soldout
              or product.selected_or_first_available_variant == null
            %}
              disabled
            {% endif %}
          >
            <span>
              {%- if product.selected_or_first_available_variant == null -%}
                {{ 'products.product.unavailable' | t }}
              {%- elsif product.selected_or_first_available_variant.available == false or quantity_rule_soldout -%}
                {{ 'products.product.sold_out' | t }}
              {%- else -%}
                {{ 'products.product.add_to_cart' | t }}
              {%- endif -%}
            </span>
            {%- render 'loading-spinner' -%}
          </button>
          {%- if show_dynamic_checkout -%}
            {{ form | payment_button }}
          {%- endif -%}
        </div>
      {%- endform -%}
    </product-form>
  {%- else -%}
    <div class="product-form">
      <div class="product-form__buttons form">
        <button
          type="submit"
          name="add"
          class="product-form__submit button button--full-width button--primary"
          disabled
        >
          {{ 'products.product.sold_out' | t }}
        </button>
      </div>
    </div>
  {%- endif -%}

  {%- if show_pickup_availability -%}
    {{ 'component-pickup-availability.css' | asset_url | stylesheet_tag }}

    {%- assign pick_up_availabilities = product.selected_or_first_available_variant.store_availabilities
      | where: 'pick_up_enabled', true
    -%}

    <pickup-availability
      class="product__pickup-availabilities quick-add-hidden"
      {% if product.selected_or_first_available_variant.available and pick_up_availabilities.size > 0 %}
        available
      {% endif %}
      data-root-url="{{ routes.root_url }}"
      data-variant-id="{{ product.selected_or_first_available_variant.id }}"
      data-has-only-default-variant="{{ product.has_only_default_variant }}"
      data-product-page-color-scheme="gradient color-{{ section.settings.color_scheme }}"
    >
      <template>
        <pickup-availability-preview class="pickup-availability-preview">
          <span class="svg-wrapper">
            {{- 'icon-unavailable.svg' | inline_asset_content -}}
          </span>
          <div class="pickup-availability-info">
            <p class="caption-large">{{ 'products.product.pickup_availability.unavailable' | t }}</p>
            <button class="pickup-availability-button link link--text underlined-link">
              {{ 'products.product.pickup_availability.refresh' | t }}
            </button>
          </div>
        </pickup-availability-preview>
      </template>
    </pickup-availability>

    <script src="{{ 'pickup-availability.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}
</div>
</tp-buy-buttons>

<script>
  if (!customElements.get('tp-buy-buttons')) {
    customElements.define('tp-buy-buttons', class TpBuyButtons extends HTMLElement {
      connectedCallback() {
        this._qty = 1;
        this._qtyEl = this.querySelector('.tp-buy-buttons__qty-value');
        this._submitBtn = this.querySelector('.tp-buy-buttons__submit');
        this._submitText = this._submitBtn.querySelector('span');
        this._spinner = this._submitBtn.querySelector('.loading__spinner');
        this._defaultText = this._submitText.textContent.trim();

        this.querySelector('[data-action="minus"]').addEventListener('click', () => this._changeQty(-1));
        this.querySelector('[data-action="plus"]').addEventListener('click', () => this._changeQty(1));
        this._submitBtn.addEventListener('click', () => this._addToCart());

        // Sincroniza com vehicle model
        this._syncVehicleModel();

        console.log('[tp-buy-buttons] init — sectionId:', this.dataset.sectionId, '| formId:', this.dataset.formId, '| variantId:', this.dataset.variantId);

        // 'variant-change' é o nome correto em PUB_SUB_EVENTS.variantChange (constants.js)
        document.addEventListener('variant-change', (e) => {
          const detail = e.detail?.data ?? e.detail;
          console.log('[tp-buy-buttons] variant-change — detail.sectionId:', detail?.sectionId, '| meu sectionId:', this.dataset.sectionId, '| variant.id:', detail?.variant?.id);

          if (detail?.sectionId !== this.dataset.sectionId) return;
          const variant = detail.variant;
          if (!variant) return;
          this.dataset.variantId = variant.id;
          console.log('[tp-buy-buttons] variantId atualizado para:', variant.id);
          this._submitBtn.toggleAttribute('disabled', !variant.available);
          this._submitText.textContent = variant.available
            ? (this._submitBtn.dataset.text || this._defaultText)
            : window.variantStrings?.soldOut || 'Esgotado';
        });
      }

      _changeQty(delta) {
        this._qty = Math.max(1, this._qty + delta);
        this._qtyEl.textContent = this._qty;
      }

      _syncVehicleModel() {
        const sectionId = this.dataset.sectionId;
        const input = document.getElementById('VehicleModel-' + sectionId);
        if (!input || input.dataset.vehicleModelRequired !== 'true') return;

        const update = () => this._submitBtn.toggleAttribute('disabled', input.value.trim() === '');
        update();
        input.addEventListener('input', update);
      }

      _getVariantId() {
        const form = document.getElementById(this.dataset.formId);
        return form?.querySelector('.product-variant-id')?.value || this.dataset.variantId;
      }

      _getProperties() {
        const formId = this.dataset.formId;
        const props = {};

        // Inputs dentro do <form>
        const form = document.getElementById(formId);
        if (form) {
          form.querySelectorAll('input[name^="properties["]').forEach(el => {
            const key = el.name.slice(12, -1);
            if (key) props[key] = el.value;
          });
        }

        // Inputs externos com form="<id>"
        document.querySelectorAll(`input[name^="properties["][form="${formId}"]`).forEach(el => {
          const key = el.name.slice(12, -1);
          if (key && el.value.trim()) props[key] = el.value;
        });

        return props;
      }

      _addToCart() {
        if (this._submitBtn.hasAttribute('disabled')) return;

        // Valida vehicle model
        const sectionId = this.dataset.sectionId;
        const vehicleInput = document.getElementById('VehicleModel-' + sectionId);
        if (vehicleInput?.dataset.vehicleModelRequired === 'true' && !vehicleInput.value.trim()) {
          const errorEl = document.getElementById('VehicleModelError-' + sectionId);
          errorEl?.removeAttribute('hidden');
          vehicleInput.setAttribute('aria-invalid', 'true');
          vehicleInput.focus();
          return;
        }

        this._setLoading(true);

        const cartEl = document.querySelector('cart-drawer') || document.querySelector('cart-notification');

        // Mesmo padrão do product-form.js: FormData + fetchConfig
        const config = fetchConfig('javascript');
        config.headers['X-Requested-With'] = 'XMLHttpRequest';
        delete config.headers['Content-Type'];

        const formData = new FormData();
        formData.append('id', this._getVariantId());
        formData.append('quantity', this._qty);

        Object.entries(this._getProperties()).forEach(([key, val]) => {
          formData.append(`properties[${key}]`, val);
        });

        if (cartEl) {
          formData.append('sections', cartEl.getSectionsToRender().map(s => s.id));
          formData.append('sections_url', window.location.pathname);
          cartEl.setActiveElement(document.activeElement);
        }

        config.body = formData;

        fetch(routes.cart_add_url, config)
          .then(res => res.json())
          .then(response => {
            if (response.status) {
              console.error('[tp-buy-buttons]', response.description);
              return;
            }
            if (!cartEl) {
              window.location = window.routes.cart_url;
              return;
            }
            publish(PUB_SUB_EVENTS.cartUpdate, {
              source: 'product-form',
              productVariantId: this._getVariantId(),
              cartData: response,
            });
            cartEl.renderContents(response);
          })
          .catch(e => console.error('[tp-buy-buttons]', e))
          .finally(() => {
            this._setLoading(false);
            if (cartEl?.classList.contains('is-empty')) cartEl.classList.remove('is-empty');
          });
      }

      _setLoading(on) {
        if (on) {
          this._submitBtn.setAttribute('disabled', '');
          this._submitText.classList.add('hidden');
          this._spinner?.classList.remove('hidden');
        } else {
          this._submitBtn.removeAttribute('disabled');
          this._submitText.classList.remove('hidden');
          this._spinner?.classList.add('hidden');
          // Re-sync vehicle model após loading
          this._syncVehicleModel();
        }
      }
    });
  }
</script>
