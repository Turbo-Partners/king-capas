{% schema %}
{
  "name": "Ícones Sociais",
  "presets": [
    {
      "name": "Ícones Sociais",
      "category": "Mídia"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Redes Sociais"
    },
    {
      "type": "url",
      "id": "facebook",
      "label": "Facebook"
    },
    {
      "type": "url",
      "id": "instagram",
      "label": "Instagram"
    },
    {
      "type": "url",
      "id": "twitter",
      "label": "X (Twitter)"
    },
    {
      "type": "url",
      "id": "youtube",
      "label": "YouTube"
    },
    {
      "type": "url",
      "id": "tiktok",
      "label": "TikTok"
    },
    {
      "type": "url",
      "id": "linkedin",
      "label": "LinkedIn"
    },
    {
      "type": "url",
      "id": "pinterest",
      "label": "Pinterest"
    },
    {
      "type": "text",
      "id": "whatsapp",
      "label": "WhatsApp",
      "info": "Número com código do país (ex: +5511999999999)"
    },
    {
      "type": "header",
      "content": "Aparência"
    },
    {
      "type": "select",
      "id": "style",
      "label": "Estilo",
      "options": [
        { "value": "minimal", "label": "Mínimo" },
        { "value": "circle", "label": "Círculo" },
        { "value": "square", "label": "Quadrado" }
      ],
      "default": "minimal"
    },
    {
      "type": "range",
      "id": "size",
      "label": "Tamanho do container",
      "min": 32,
      "max": 60,
      "step": 4,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Tamanho do ícone",
      "min": 16,
      "max": 32,
      "step": 2,
      "default": 20,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Espaçamento",
      "min": 4,
      "max": 24,
      "step": 2,
      "default": 12,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alinhamento",
      "options": [
        { "value": "flex-start", "label": "Esquerda" },
        { "value": "center", "label": "Centro" },
        { "value": "flex-end", "label": "Direita" }
      ],
      "default": "center"
    }
  ]
}
{% endschema %}
