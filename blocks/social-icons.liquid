{% style %}
.tp-block-social-icons-{{ block.id }} {
  display: flex;
  gap: {{ block.settings.gap }}px;
  justify-content: {{ block.settings.alignment }};
  flex-wrap: wrap;
}

.tp-block-social-icons-{{ block.id }} a {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: {{ block.settings.size }}px;
  height: {{ block.settings.size }}px;
  color: inherit;
  transition: opacity 0.3s ease, transform 0.3s ease;
  
  {% if block.settings.style == 'circle' %}
    background: rgba(0,0,0,0.05);
    border-radius: 50%;
  {% elsif block.settings.style == 'square' %}
    background: rgba(0,0,0,0.05);
    border-radius: 4px;
  {% endif %}
}

.tp-block-social-icons-{{ block.id }} a:hover {
  opacity: 0.7;
  transform: scale(1.1);
}

.tp-block-social-icons-{{ block.id }} svg {
  width: {{ block.settings.icon_size }}px;
  height: {{ block.settings.icon_size }}px;
}
{% endstyle %}

<div class="tp-block-social-icons tp-block-social-icons-{{ block.id }}" {{ block.shopify_attributes }}>
  {% if block.settings.facebook != blank %}
    <a href="{{ block.settings.facebook }}" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.477 2 2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.879V14.89h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.989C18.343 21.129 22 16.99 22 12c0-5.523-4.477-10-10-10z"/></svg>
