{% style %}
.tp-block-email-signup-{{ block.id }} {
  {% if block.settings.width == 'fill' %}
    width: 100%;
  {% elsif block.settings.width == 'custom' %}
    width: {{ block.settings.custom_width }}%;
  {% else %}
    width: fit-content;
  {% endif %}
}

.tp-block-email-signup-{{ block.id }} form {
  display: flex;
  {% if block.settings.integrated_button %}
    flex-direction: row;
    gap: 0;
  {% else %}
    flex-direction: column;
    gap: 12px;
  {% endif %}
}

.tp-block-email-signup-{{ block.id }} input[type="email"] {
  flex: 1;
  padding: 14px 16px;
  border: 1px solid rgba(0,0,0,0.2);
  {% if block.settings.integrated_button %}
    border-right: none;
    border-radius: 4px 0 0 4px;
  {% else %}
    border-radius: 4px;
  {% endif %}
  font-size: 1rem;
  background: transparent;
}

.tp-block-email-signup-{{ block.id }} input[type="email"]:focus {
  outline: 2px solid var(--color-button, #000);
  outline-offset: -2px;
}

.tp-block-email-signup-{{ block.id }} button {
  padding: 14px 24px;
  border: none;
  cursor: pointer;
  font-size: 1rem;
  font-weight: 600;
  transition: opacity 0.3s ease;
  
  {% if block.settings.integrated_button %}
    border-radius: 0 4px 4px 0;
  {% else %}
    border-radius: 4px;
  {% endif %}
  
  {% case block.settings.style_class %}
    {% when 'button' %}
      background-color: var(--color-button, #000);
      color: var(--color-button-text, #fff);
    {% when 'button-secondary' %}
      background-color: transparent;
      color: var(--color-text, #000);
      border: 1px solid currentColor;
    {% when 'button-unstyled' %}
      background-color: transparent;
      color: var(--color-text, #000);
  {% endcase %}
}

.tp-block-email-signup-{{ block.id }} button:hover {
  opacity: 0.8;
}

.tp-block-email-signup-{{ block.id }} .success-message {
  color: #22c55e;
  font-weight: 500;
}

@media (max-width: 749px) {
  .tp-block-email-signup-{{ block.id }} {
    {% if block.settings.width_mobile == 'fill' %}
      width: 100%;
    {% elsif block.settings.width_mobile == 'custom' %}
      width: {{ block.settings.custom_width_mobile }}%;
    {% else %}
      width: fit-content;
    {% endif %}
  }
  
  .tp-block-email-signup-{{ block.id }} form {
    {% if block.settings.stack_on_mobile %}
      flex-direction: column;
      gap: 12px;
    {% endif %}
  }
  
  {% if block.settings.stack_on_mobile %}
  .tp-block-email-signup-{{ block.id }} input[type="email"],
  .tp-block-email-signup-{{ block.id }} button {
    border-radius: 4px;
    border: 1px solid rgba(0,0,0,0.2);
  }
  {% endif %}
}
{% endstyle %}

<div class="tp-block-email-signup tp-block-email-signup-{{ block.id }}" {{ block.shopify_attributes }}>
  {% form 'customer', id: block.id %}
    <input type="hidden" name="contact[tags]" value="newsletter">
    <input 
      type="email" 
      name="contact[email]" 
      placeholder="{{ block.settings.placeholder | default: 'Digite seu e-mail' }}"
      required
      autocomplete="email"
    >
    <button type="submit">
      {% if block.settings.display_type == 'arrow' %}
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
        </svg>
      {% else %}
        {{ block.settings.label | default: 'Inscrever-se' }}
      {% endif %}
    </button>
  {% endform %}
</div>

{% schema %}
{
  "name": "Cadastro de Email",
  "presets": [
    {
      "name": "Cadastro de Email",
      "category": "Formulários"
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "placeholder",
      "label": "Placeholder",
      "default": "Digite seu e-mail"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Texto do botão",
      "default": "Inscrever-se"
    },
    {
      "type": "select",
      "id": "display_type",
      "label": "Tipo do botão",
      "options": [
        { "value": "text", "label": "Texto" },
        { "value": "arrow", "label": "Seta" }
      ],
      "default": "text"
    },
    {
      "type": "checkbox",
      "id": "integrated_button",
      "label": "Botão integrado",
      "default": true,
      "info": "Botão conectado ao campo de email"
    },
    {
      "type": "checkbox",
      "id": "stack_on_mobile",
      "label": "Empilhar no mobile",
      "default": false
    },
    {
      "type": "header",
      "content": "Estilo"
    },
    {
      "type": "select",
      "id": "style_class",
      "label": "Estilo do botão",
      "options": [
        { "value": "button", "label": "Primário" },
        { "value": "button-secondary", "label": "Secundário" },
        { "value": "button-unstyled", "label": "Sem estilo" }
      ],
      "default": "button"
    },
    {
      "type": "header",
      "content": "Tamanho"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Largura",
      "options": [
        { "value": "fit-content", "label": "Ajustar ao conteúdo" },
        { "value": "fill", "label": "Preencher" },
        { "value": "custom", "label": "Personalizado" }
      ],
      "default": "fill"
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "Largura personalizada",
      "min": 10,
      "max": 100,
      "step": 5,
      "default": 50,
      "unit": "%",
      "visible_if": "{{ block.settings.width == 'custom' }}"
    },
    {
      "type": "select",
      "id": "width_mobile",
      "label": "Largura (mobile)",
      "options": [
        { "value": "fit-content", "label": "Ajustar ao conteúdo" },
        { "value": "fill", "label": "Preencher" },
        { "value": "custom", "label": "Personalizado" }
      ],
      "default": "fill"
    },
    {
      "type": "range",
      "id": "custom_width_mobile",
      "label": "Largura mobile",
      "min": 10,
      "max": 100,
      "step": 5,
      "default": 100,
      "unit": "%",
      "visible_if": "{{ block.settings.width_mobile == 'custom' }}"
    }
  ]
}
{% endschema %}
