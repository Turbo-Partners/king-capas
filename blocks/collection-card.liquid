{% style %}
.tp-block-collection-card-{{ block.id }} {
  {% if block.settings.width == 'fill' %}
    width: 100%;
  {% elsif block.settings.width == 'custom' %}
    width: {{ block.settings.custom_width }}%;
  {% else %}
    width: fit-content;
  {% endif %}
}

.tp-block-collection-card-{{ block.id }} .collection-card {
  display: block;
  position: relative;
  text-decoration: none;
  color: inherit;
  overflow: hidden;
  border-radius: {{ block.settings.border_radius }}px;
  
  {% case block.settings.image_ratio %}
    {% when 'square' %}
      aspect-ratio: 1 / 1;
    {% when 'portrait' %}
      aspect-ratio: 3 / 4;
    {% when 'landscape' %}
      aspect-ratio: 16 / 9;
    {% when 'wide' %}
      aspect-ratio: 21 / 9;
  {% endcase %}
}

.tp-block-collection-card-{{ block.id }} .collection-card__image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.tp-block-collection-card-{{ block.id }} .collection-card__image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.5s ease;
}

.tp-block-collection-card-{{ block.id }} .collection-card:hover .collection-card__image img {
  transform: scale(1.1);
}

.tp-block-collection-card-{{ block.id }} .collection-card__overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(to top, rgba(0,0,0,0.6) 0%, rgba(0,0,0,0) 60%);
  z-index: 1;
}

.tp-block-collection-card-{{ block.id }} .collection-card__content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24px;
  z-index: 2;
  color: white;
  text-align: {{ block.settings.text_align }};
}

.tp-block-collection-card-{{ block.id }} .collection-card__title {
  font-size: 1.5rem;
  font-weight: 600;
  margin: 0 0 4px 0;
}

.tp-block-collection-card-{{ block.id }} .collection-card__count {
  font-size: 0.875rem;
  opacity: 0.8;
}

@media (max-width: 749px) {
  .tp-block-collection-card-{{ block.id }} {
    {% if block.settings.width_mobile == 'fill' %}
      width: 100%;
    {% elsif block.settings.width_mobile == 'custom' %}
      width: {{ block.settings.custom_width_mobile }}%;
    {% else %}
      width: fit-content;
    {% endif %}
  }
  
  .tp-block-collection-card-{{ block.id }} .collection-card__title {
    font-size: 1.25rem;
  }
}
{% endstyle %}

<div class="tp-block-collection-card tp-block-collection-card-{{ block.id }}" {{ block.shopify_attributes }}>
  {% if block.settings.collection != blank %}
    {% assign collection = block.settings.collection %}
    <a href="{{ collection.url }}" class="collection-card">
      <div class="collection-card__image">
        {% if collection.featured_image %}
          <img 
            src="{{ collection.featured_image | image_url: width: 800 }}"
            srcset="{{ collection.featured_image | image_url: width: 400 }} 400w,
                    {{ collection.featured_image | image_url: width: 800 }} 800w,
                    {{ collection.featured_image | image_url: width: 1200 }} 1200w"
            sizes="(max-width: 749px) 100vw, 50vw"
            alt="{{ collection.featured_image.alt | default: collection.title | escape }}"
            loading="lazy"
          >
        {% else %}
          {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {% endif %}
      </div>
      
      {% if block.settings.show_overlay %}
        <div class="collection-card__overlay"></div>
      {% endif %}
      
      <div class="collection-card__content">
        <h3 class="collection-card__title">{{ block.settings.custom_title | default: collection.title }}</h3>
        {% if block.settings.show_count %}
          <p class="collection-card__count">{{ collection.products_count }} {{ collection.products_count | pluralize: 'produto', 'produtos' }}</p>
        {% endif %}
      </div>
    </a>
  {% else %}
    <div class="collection-card">
      <div class="collection-card__image">
        {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
      </div>
      {% if block.settings.show_overlay %}
        <div class="collection-card__overlay"></div>
      {% endif %}
      <div class="collection-card__content">
        <h3 class="collection-card__title">Nome da Coleção</h3>
        <p class="collection-card__count">0 produtos</p>
      </div>
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Cartão de Coleção",
  "presets": [
    {
      "name": "Cartão de Coleção",
      "category": "Produtos"
    }
  ],
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Coleção"
    },
    {
      "type": "text",
      "id": "custom_title",
      "label": "Título personalizado",
      "info": "Deixe vazio para usar o título da coleção"
    },
    {
      "type": "header",
      "content": "Informações"
    },
    {
      "type": "checkbox",
      "id": "show_count",
      "label": "Mostrar contagem de produtos",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_overlay",
      "label": "Mostrar overlay",
      "default": true
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Alinhamento do texto",
      "options": [
        { "value": "left", "label": "Esquerda" },
        { "value": "center", "label": "Centro" },
        { "value": "right", "label": "Direita" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Imagem"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Proporção",
      "options": [
        { "value": "square", "label": "Quadrado (1:1)" },
        { "value": "portrait", "label": "Retrato (3:4)" },
        { "value": "landscape", "label": "Paisagem (16:9)" },
        { "value": "wide", "label": "Ultra-wide (21:9)" }
      ],
      "default": "landscape"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Arredondamento",
      "min": 0,
      "max": 30,
      "step": 2,
      "default": 8,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Tamanho"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Largura",
      "options": [
        { "value": "fit-content", "label": "Ajustar ao conteúdo" },
        { "value": "fill", "label": "Preencher" },
        { "value": "custom", "label": "Personalizado" }
      ],
      "default": "fill"
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "Largura personalizada",
      "min": 10,
      "max": 100,
      "step": 5,
      "default": 100,
      "unit": "%",
      "visible_if": "{{ block.settings.width == 'custom' }}"
    },
    {
      "type": "select",
      "id": "width_mobile",
      "label": "Largura (mobile)",
      "options": [
        { "value": "fit-content", "label": "Ajustar ao conteúdo" },
        { "value": "fill", "label": "Preencher" },
        { "value": "custom", "label": "Personalizado" }
      ],
      "default": "fill"
    },
    {
      "type": "range",
      "id": "custom_width_mobile",
      "label": "Largura mobile",
      "min": 10,
      "max": 100,
      "step": 5,
      "default": 100,
      "unit": "%",
      "visible_if": "{{ block.settings.width_mobile == 'custom' }}"
    }
  ]
}
{% endschema %}
