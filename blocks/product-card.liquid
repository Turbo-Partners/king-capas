{% style %}
.tp-block-product-card-{{ block.id }} {
  {% if block.settings.width == 'fill' %}
    width: 100%;
  {% elsif block.settings.width == 'custom' %}
    width: {{ block.settings.custom_width }}%;
  {% else %}
    width: fit-content;
  {% endif %}
}

.tp-block-product-card-{{ block.id }} .product-card {
  display: flex;
  flex-direction: column;
  gap: 12px;
  text-decoration: none;
  color: inherit;
}

.tp-block-product-card-{{ block.id }} .product-card__image {
  position: relative;
  overflow: hidden;
  border-radius: {{ block.settings.image_radius }}px;
  
  {% case block.settings.image_ratio %}
    {% when 'square' %}
      aspect-ratio: 1 / 1;
    {% when 'portrait' %}
      aspect-ratio: 3 / 4;
    {% when 'landscape' %}
      aspect-ratio: 4 / 3;
  {% endcase %}
}

.tp-block-product-card-{{ block.id }} .product-card__image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.3s ease;
}

.tp-block-product-card-{{ block.id }} .product-card:hover .product-card__image img {
  transform: scale(1.05);
}

.tp-block-product-card-{{ block.id }} .product-card__info {
  display: flex;
  flex-direction: column;
  gap: 4px;
  text-align: {{ block.settings.text_align }};
}

.tp-block-product-card-{{ block.id }} .product-card__vendor {
  font-size: 0.75rem;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  opacity: 0.7;
}

.tp-block-product-card-{{ block.id }} .product-card__title {
  font-size: 1rem;
  font-weight: 500;
  margin: 0;
}

.tp-block-product-card-{{ block.id }} .product-card__price {
  font-size: 0.875rem;
}

.tp-block-product-card-{{ block.id }} .product-card__price--sale {
  color: #dc2626;
}

.tp-block-product-card-{{ block.id }} .product-card__price--compare {
  text-decoration: line-through;
  opacity: 0.5;
}

.tp-block-product-card-{{ block.id }} .product-card__badge {
  position: absolute;
  top: 8px;
  left: 8px;
  background: #dc2626;
  color: white;
  padding: 4px 8px;
  font-size: 0.75rem;
  font-weight: 600;
  border-radius: 4px;
}

@media (max-width: 749px) {
  .tp-block-product-card-{{ block.id }} {
    {% if block.settings.width_mobile == 'fill' %}
      width: 100%;
    {% elsif block.settings.width_mobile == 'custom' %}
      width: {{ block.settings.custom_width_mobile }}%;
    {% else %}
      width: fit-content;
    {% endif %}
  }
}
{% endstyle %}

<div class="tp-block-product-card tp-block-product-card-{{ block.id }}" {{ block.shopify_attributes }}>
  {% if block.settings.product != blank %}
    {% assign product = block.settings.product %}
    <a href="{{ product.url }}" class="product-card">
      <div class="product-card__image">
        {% if product.featured_image %}
          <img 
            src="{{ product.featured_image | image_url: width: 600 }}"
            srcset="{{ product.featured_image | image_url: width: 300 }} 300w,
                    {{ product.featured_image | image_url: width: 600 }} 600w,
                    {{ product.featured_image | image_url: width: 900 }} 900w"
            sizes="(max-width: 749px) 100vw, 300px"
            alt="{{ product.featured_image.alt | default: product.title | escape }}"
            loading="lazy"
          >
        {% else %}
          {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {% endif %}
        
        {% if product.compare_at_price > product.price and block.settings.show_badge %}
          <span class="product-card__badge">
            {% assign discount = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price %}
            -{{ discount }}%
          </span>
        {% endif %}
      </div>
      
      <div class="product-card__info">
        {% if block.settings.show_vendor and product.vendor %}
          <span class="product-card__vendor">{{ product.vendor }}</span>
        {% endif %}
        
        <h3 class="product-card__title">{{ product.title }}</h3>
        
        {% if block.settings.show_price %}
          <div class="product-card__price">
            {% if product.compare_at_price > product.price %}
              <span class="product-card__price--sale">{{ product.price | money }}</span>
              <span class="product-card__price--compare">{{ product.compare_at_price | money }}</span>
            {% else %}
              {{ product.price | money }}
            {% endif %}
          </div>
        {% endif %}
      </div>
    </a>
  {% else %}
    <div class="product-card">
      <div class="product-card__image">
        {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
      </div>
      <div class="product-card__info">
        <h3 class="product-card__title">Nome do Produto</h3>
        <div class="product-card__price">R$ 99,90</div>
      </div>
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Cartão de Produto",
  "presets": [
    {
      "name": "Cartão de Produto",
      "category": "Produtos"
    }
  ],
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Produto"
    },
    {
      "type": "header",
      "content": "Informações"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Mostrar marca",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Mostrar preço",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_badge",
      "label": "Mostrar badge de desconto",
      "default": true
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Alinhamento do texto",
      "options": [
        { "value": "left", "label": "Esquerda" },
        { "value": "center", "label": "Centro" },
        { "value": "right", "label": "Direita" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Imagem"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Proporção da imagem",
      "options": [
        { "value": "natural", "label": "Natural" },
        { "value": "square", "label": "Quadrado (1:1)" },
        { "value": "portrait", "label": "Retrato (3:4)" },
        { "value": "landscape", "label": "Paisagem (4:3)" }
      ],
      "default": "portrait"
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "Arredondamento",
      "min": 0,
      "max": 30,
      "step": 2,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Tamanho"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Largura",
      "options": [
        { "value": "fit-content", "label": "Ajustar ao conteúdo" },
        { "value": "fill", "label": "Preencher" },
        { "value": "custom", "label": "Personalizado" }
      ],
      "default": "fill"
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "Largura personalizada",
      "min": 10,
      "max": 100,
      "step": 5,
      "default": 100,
      "unit": "%",
      "visible_if": "{{ block.settings.width == 'custom' }}"
    },
    {
      "type": "select",
      "id": "width_mobile",
      "label": "Largura (mobile)",
      "options": [
        { "value": "fit-content", "label": "Ajustar ao conteúdo" },
        { "value": "fill", "label": "Preencher" },
        { "value": "custom", "label": "Personalizado" }
      ],
      "default": "fill"
    },
    {
      "type": "range",
      "id": "custom_width_mobile",
      "label": "Largura mobile",
      "min": 10,
      "max": 100,
      "step": 5,
      "default": 100,
      "unit": "%",
      "visible_if": "{{ block.settings.width_mobile == 'custom' }}"
    }
  ]
}
{% endschema %}
