{{ 'tp-e-image-with-text-v1.css' | asset_url | stylesheet_tag }}

{% render 'tp-section-padding',
  pad_top_min: section.settings.pad_top_min,
  pad_top_max: section.settings.pad_top_max,
  pad_bottom_min: section.settings.pad_bottom_min,
  pad_bottom_max: section.settings.pad_bottom_max,
  enable_pad_top_mobile: section.settings.enable_pad_top_mobile,
  pad_top_mobile: section.settings.pad_top_mobile,
  enable_pad_bottom_mobile: section.settings.enable_pad_bottom_mobile,
  pad_bottom_mobile: section.settings.pad_bottom_mobile,
  enable_pad_top_desktop: section.settings.enable_pad_top_desktop,
  pad_top_desktop: section.settings.pad_top_desktop,
  enable_pad_bottom_desktop: section.settings.enable_pad_bottom_desktop,
  pad_bottom_desktop: section.settings.pad_bottom_desktop
%}

{% liquid
  assign background_type = section.settings.background_type
  assign media_type = section.settings.media_type
  assign image_position_desktop = section.settings.image_position_desktop
  assign image_position_mobile = section.settings.image_position_mobile
  assign image_padding_inline_mobile = section.settings.image_padding_inline_mobile
  assign image_padding_inline_desktop = section.settings.image_padding_inline_desktop
  assign section_image = section.settings.image_desktop | default: section.settings.image_mobile
  assign section_image_alt = section_image.alt | escape
  assign title_bar_position = section.settings.title_bar_position
  assign title_bar_align = section.settings.title_bar_align

  assign loading = 'eager'
  assign fetch_priority = 'high'
  if section.settings.loading_image == true
    assign loading = 'lazy'
    assign fetch_priority = 'low'
  endif
%}

{% style %}
  .{{ section.id }} {
    {% if background_type == "image" and section.settings.background_image_mobile != blank %}
      background-image: url('{{ section.settings.background_image_mobile | image_url }}');
    {% elsif background_type == "color" and section.settings.background_color != blank %}
      background: {{ section.settings.background_color }};
    {% elsif background_type == "gradient" and section.settings.background_gradient != blank %}
      background: {{ section.settings.background_gradient }};
    {% endif %}
  }

  {% if background_type == "image" and section.settings.background_image_desktop != blank %}
    @media screen and (min-width: 1024px) {
      .{{ section.id }} {
        background-image: url('{{ section.settings.background_image_desktop | image_url }}');
      }
    }
  {% endif %}

  {% if section.settings.title_above_image_mobile %}
    @media screen and (max-width: 1023px) {
      .{{ section.id }} .tp-e-image-with-text-v1__title--in-wrapper { display: none; }
    }
    @media screen and (min-width: 1024px) {
      .{{ section.id }} .tp-e-image-with-text-v1__title--above-image { display: none; }
    }
  {% else %}
    .{{ section.id }} .tp-e-image-with-text-v1__title--above-image { display: none; }
  {% endif %}

  {% if section.settings.title_bar %}
    .{{ section.id }} .tp-e-image-with-text-v1__bar {
      display: block;
      width: {{ section.settings.title_bar_width_mobile }}px;
      height: {{ section.settings.title_bar_height }}px;
      background: {{ section.settings.title_bar_color }};
    }

    @media screen and (min-width: 1024px) {
      .{{ section.id }} .tp-e-image-with-text-v1__bar {
        width: {{ section.settings.title_bar_width_desktop }}px;
      }
    }
  {% endif %}

  {% if section.settings.title_custom %}
    .{{ section.id }} .tp-e-image-with-text-v1__title * {
      color: {{ section.settings.text_color_title }};
      font-size: {{ section.settings.font_size_title }}px;
      font-weight: {{ section.settings.font_weight | times: 1 }};
    }

    @media screen and (max-width: 749px) {
      .{{ section.id }} .tp-e-image-with-text-v1__title * {
        font-size: {{ section.settings.font_size_title_mobile }}px;
      }
    }
  {% endif %}

  {% if section.settings.content_custom %}
    .{{ section.id }} .tp-e-image-with-text-v1__content * {
      color: {{ section.settings.text_color_content }};
      font-size: {{ section.settings.font_size_content }}px;
      font-weight: {{ section.settings.content_font_weight | times: 1 }};
    }

    @media screen and (max-width: 749px) {
      .{{ section.id }} .tp-e-image-with-text-v1__content * {
        font-size: {{ section.settings.font_size_content_mobile }}px;
      }
    }
  {% endif %}

  {% if section.settings.button_custom %}
    .{{ section.id }} .tp-e-image-with-text-v1__button {
      color: {{ section.settings.text_color_btn }};
      background-color: {{ section.settings.bg_color_btn }};
      border-radius: {{ section.settings.radius_btn }}px;
      font-size: {{ section.settings.button_font_size_desktop }}px;
      font-weight: {{ section.settings.button_font_weight | times: 1 }};
    }

    @media screen and (max-width: 749px) {
      .{{ section.id }} .tp-e-image-with-text-v1__button {
        font-size: {{ section.settings.button_font_size_mobile }}px;
      }
    }

    .{{ section.id }} .tp-e-image-with-text-v1__button:hover {
      box-shadow: var(--tp-shadow-sm);
    }
  {% endif %}
{% endstyle %}

{%- assign css_blocks = section.blocks | where: "type", "css" -%}
{%- if css_blocks.size > 0 -%}
  {%- for block in css_blocks -%}
    {%- if block.settings.custom_css != blank -%}
      <style>
        @scope (.{{ section.id }}) {
          {{ block.settings.custom_css }}
        }
      </style>
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}

<section class="tp-e-image-with-text-v1 {{ section.id }} scroll-trigger slider-in--animation">
  <div
    class="tp-wrapper
      tp-e-image-with-text-v1__wrapper
      {% if image_position_desktop == 'right' %}tp-e-image-with-text-v1__wrapper--image-right
      {% elsif image_position_desktop == 'left' %}tp-e-image-with-text-v1__wrapper--image-left
      {% endif %}
      {% if image_position_mobile == 'first' %}tp-e-image-with-text-v1__wrapper--image-up
      {% elsif image_position_mobile == 'second' %}tp-e-image-with-text-v1__wrapper--image-down
      {% endif %}
      {% if image_padding_inline_mobile == false %} tp-e-image-with-text-v1__wrapper--no-padding-mobile
      {% endif %}
      {% if image_padding_inline_desktop == false %} tp-e-image-with-text-v1__wrapper--no-padding-desktop
      {% endif %}
    "
    id="section-wrapper-{{ section.id }}"
  >
    {% if section.settings.title != blank %}
      <div class="tp-e-image-with-text-v1__title tp-e-image-with-text-v1__title--above-image">
        {% if section.settings.title_bar and title_bar_position == 'title' %}
          <span class="tp-e-image-with-text-v1__bar" aria-hidden="true"></span>
        {% endif %}
        {{ section.settings.title }}
      </div>
    {% endif %}

    <div class="tp-e-image-with-text-v1__media">
      {% if media_type == 'video' %}
        {% if section.settings.video_source == 'hosted' and section.settings.video_file != blank %}
          {{ section.settings.video_file | video_tag:
            autoplay: section.settings.video_autoplay,
            loop: true,
            muted: true,
            controls: false,
            class: 'tp-e-image-with-text-v1__video',
            playsinline: true
          }}
        {% elsif section.settings.video_source == 'external' and section.settings.video_url != blank %}
          {% liquid
            assign video_id = section.settings.video_url.id
            assign video_type = section.settings.video_url.type
            assign params = 'loop=1&'
            if section.settings.video_autoplay
              assign params = params | append: 'autoplay=1&'
            endif
            if video_type == 'youtube'
              assign params = params | append: 'mute=1&controls=0&playlist=' | append: video_id | append: '&'
              assign video_embed_src = 'https://www.youtube.com/embed/' | append: video_id | append: '?' | append: params
            elsif video_type == 'vimeo'
              assign params = params | append: 'muted=1&'
              assign video_embed_src = 'https://player.vimeo.com/video/' | append: video_id | append: '?' | append: params
            endif
          %}
          {% if video_embed_src != blank %}
            <iframe
              src="{{ video_embed_src }}"
              class="tp-e-image-with-text-v1__video tp-e-image-with-text-v1__video--iframe"
              frameborder="0"
              allow="autoplay; fullscreen; picture-in-picture"
              allowfullscreen
              title="{{ section.settings.title | strip_html | escape }}"
            ></iframe>
          {% endif %}
        {% else %}
          {{ 'detailed-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {% endif %}
      {% else %}
        {% if section.settings.image_desktop != blank or section.settings.image_mobile != blank %}
          <picture class="tp-e-image-with-text-v1__picture">
            {% if section.settings.image_mobile != blank %}
              <source
                media="(max-width: 749px)"
                srcset="{{ section.settings.image_mobile | image_url: width: 750 }} 750w, {{ section.settings.image_mobile | image_url: width: 1100 }} 1100w"
              >
            {% endif %}
            {% if section.settings.image_desktop != blank %}
              <source
                media="(min-width: 750px)"
                srcset="{{ section.settings.image_desktop | image_url: width: 1100 }} 1100w, {{ section.settings.image_desktop | image_url: width: 1500 }} 1500w, {{ section.settings.image_desktop | image_url: width: 2000 }} 2000w"
              >
            {% endif %}
            {% if section_image != blank %}
              <img
                src="{{ section_image | image_url: width: 1500 }}"
                alt="{{ section_image_alt }}"
                class="tp-e-image-with-text-v1__img"
                loading="{{ loading }}"
                fetchpriority="{{ fetch_priority }}"
              >
            {% endif %}
          </picture>
        {% else %}
          {{ 'detailed-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {% endif %}
      {% endif %}
    </div>
    <div class="tp-e-image-with-text-v1__text-wrapper">
      {% if section.settings.title_bar and title_bar_position == 'wrapper' %}
        <span class="tp-e-image-with-text-v1__bar tp-e-image-with-text-v1__bar--{{ title_bar_align }}" aria-hidden="true"></span>
      {% endif %}
      {% if section.settings.title_image != blank %}
        <div class="tp-e-image-with-text-v1__title-bar">
          <img src="{{ section.settings.title_image | image_url }}" alt="" aria-hidden="true">
        </div>
      {% endif %}
      {% if section.settings.title != blank %}
        <div class="tp-e-image-with-text-v1__title tp-e-image-with-text-v1__title--in-wrapper">
          {% if section.settings.title_bar and title_bar_position == 'title' %}
            <span class="tp-e-image-with-text-v1__bar" aria-hidden="true"></span>
          {% endif %}
          {{ section.settings.title }}
        </div>
      {% endif %}
      {% if section.settings.richtext != blank %}
        <div class="tp-e-image-with-text-v1__content">
          {{ section.settings.richtext }}
        </div>
      {% endif %}

      {% assign benefit_blocks = section.blocks | where: "type", "benefit" %}
      {% if benefit_blocks.size > 0 %}
        <div class="tp-e-image-with-text-v1__block-wrapper">
          {% for block in benefit_blocks %}
            <div class="tp-e-image-with-text-v1__block" {{ block.shopify_attributes }}>
              {% if block.settings.image != blank %}
                <img
                  src="{{ block.settings.image | image_url }}"
                  alt="{{ block.settings.image.alt | escape }}"
                  class="tp-e-image-with-text-v1__block-image"
                >
              {% endif %}
              <div class="tp-e-image-with-text-v1__block-text-wrapper">
                {{ block.settings.richtext }}
              </div>
            </div>
          {% endfor %}
        </div>
      {% endif %}

      {% assign data_blocks = section.blocks | where: "type", "dado" %}
      {% if data_blocks.size > 0 %}
        <tp-data-counter class="tp-e-image-with-text-v1__data-wrapper" data-animate="{{ section.settings.data_animate }}">
          {% for block in data_blocks %}
            <div class="tp-e-image-with-text-v1__data-item" {{ block.shopify_attributes }} data-percentage="{{ block.settings.percentage }}">
              <div class="tp-e-image-with-text-v1__data-circle">
                <svg viewBox="0 0 88 88" class="tp-e-image-with-text-v1__data-svg">
                  <circle cx="44" cy="44" r="40" class="tp-e-image-with-text-v1__data-track"/>
                  <circle cx="44" cy="44" r="40" class="tp-e-image-with-text-v1__data-progress" style="--data-percentage: {{ block.settings.percentage }};"/>
                </svg>
                <span class="tp-e-image-with-text-v1__data-value">
                  <span class="tp-e-image-with-text-v1__data-number">{{ block.settings.percentage }}</span><span class="tp-e-image-with-text-v1__data-percent">%</span>
                </span>
              </div>
              {% if block.settings.text != blank %}
                <p class="tp-e-image-with-text-v1__data-text">{{ block.settings.text | escape }}</p>
              {% endif %}
            </div>
          {% endfor %}
        </tp-data-counter>
      {% endif %}

      {% assign faq_blocks = section.blocks | where: "type", "pergunta" %}
      {% if faq_blocks.size > 0 %}
        <tp-faq-accordion class="tp-e-image-with-text-v1__faq" data-icon-type="{{ section.settings.faq_icon_type }}">
          {% for block in faq_blocks %}
            <details class="tp-e-image-with-text-v1__faq-item" {{ block.shopify_attributes }}{% if forloop.first and section.settings.faq_first_open %} open{% endif %}>
              <summary class="tp-e-image-with-text-v1__faq-question">
                <span class="tp-e-image-with-text-v1__faq-question-text">{{ block.settings.question | escape }}</span>
                <span class="tp-e-image-with-text-v1__faq-icon" aria-hidden="true">
                  {% if section.settings.faq_icon_type == 'x' %}
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M12 5V19" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                      <path d="M5 12H19" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  {% else %}
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M6 9L12 15L18 9" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  {% endif %}
                </span>
              </summary>
              <div class="tp-e-image-with-text-v1__faq-answer">
                {{ block.settings.answer }}
              </div>
            </details>
          {% endfor %}
        </tp-faq-accordion>
      {% endif %}

      {% if section.settings.button_text != blank and section.settings.button_url != blank %}
        <a class="tp-e-image-with-text-v1__button" href="{{ section.settings.button_url }}">
          {{- section.settings.button_text -}}
        </a>
      {% endif %}
    </div>
  </div>
</section>

<script defer>
  if (!customElements.get('tp-faq-accordion')) {
    class TpFaqAccordion extends HTMLElement {
      connectedCallback() {
        this.querySelectorAll('summary').forEach((summary) => {
          summary.addEventListener('click', (e) => {
            const details = summary.closest('details');
            const isOpen = details.hasAttribute('open');
            if (!isOpen) {
              this.querySelectorAll('details[open]').forEach((openItem) => {
                if (openItem !== details) openItem.removeAttribute('open');
              });
            }
          });
        });
      }
    }
    customElements.define('tp-faq-accordion', TpFaqAccordion);
  }

  if (!customElements.get('tp-data-counter')) {
    class TpDataCounter extends HTMLElement {
      connectedCallback() {
        if (this.dataset.animate !== 'true') return;

        this.items = this.querySelectorAll('.tp-e-image-with-text-v1__data-item');
        this.animated = false;

        this.observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting && !this.animated) {
              this.animated = true;
              this.animateAll();
              this.observer.disconnect();
            }
          });
        }, { threshold: 0.3 });

        this.observer.observe(this);
      }

      disconnectedCallback() {
        if (this.observer) this.observer.disconnect();
      }

      animateAll() {
        const duration = 1200;
        this.items.forEach((item) => {
          const target = parseInt(item.dataset.percentage, 10);
          const numberEl = item.querySelector('.tp-e-image-with-text-v1__data-number');
          const progressEl = item.querySelector('.tp-e-image-with-text-v1__data-progress');
          const circumference = 251.327;

          progressEl.style.strokeDashoffset = circumference;
          numberEl.textContent = '0';

          let start = null;
          const step = (timestamp) => {
            if (!start) start = timestamp;
            const progress = Math.min((timestamp - start) / duration, 1);
            const eased = 1 - Math.pow(1 - progress, 3);
            const current = Math.round(eased * target);

            numberEl.textContent = current;
            progressEl.style.strokeDashoffset = circumference - (circumference * eased * target / 100);

            if (progress < 1) requestAnimationFrame(step);
          };

          requestAnimationFrame(step);
        });
      }
    }
    customElements.define('tp-data-counter', TpDataCounter);
  }
</script>

{% schema %}
{
  "name": "Imagem Com Texto V1",
  "class": "E__IMAGE_WITH_TEXT__V1",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Configuração da imagem"
    },
    {
      "type": "select",
      "id": "media_type",
      "label": "Tipo de mídia",
      "default": "image",
      "options": [
        { "label": "Imagem", "value": "image" },
        { "label": "Vídeo", "value": "video" }
      ]
    },
    {
      "type": "select",
      "id": "image_position_desktop",
      "label": "Posição da imagem no desktop",
      "default": "left",
      "options": [
        { "value": "left", "label": "Esquerda" },
        { "value": "right", "label": "Direita" }
      ]
    },
    {
      "type": "select",
      "id": "image_position_mobile",
      "label": "Posição da imagem no mobile",
      "options": [
        { "label": "Primeiro", "value": "first" },
        { "label": "Segundo", "value": "second" }
      ],
      "default": "first"
    },
    {
      "type": "checkbox",
      "id": "title_above_image_mobile",
      "label": "Título acima da imagem (mobile)",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "image_padding_inline_mobile",
      "label": "Padding lateral da imagem no mobile",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "image_padding_inline_desktop",
      "label": "Padding lateral da imagem no desktop",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "loading_image",
      "label": "Carregar imagem com lazy loading",
      "default": true,
      "visible_if": "{{ section.settings.media_type == 'image' }}"
    },
    {
      "type": "image_picker",
      "id": "image_desktop",
      "label": "Imagem para desktop",
      "visible_if": "{{ section.settings.media_type == 'image' }}"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Imagem para mobile",
      "visible_if": "{{ section.settings.media_type == 'image' }}"
    },
    {
      "type": "header",
      "content": "Configuração do vídeo",
      "visible_if": "{{ section.settings.media_type == 'video' }}"
    },
    {
      "type": "select",
      "id": "video_source",
      "label": "Fonte",
      "default": "hosted",
      "options": [
        { "label": "Vídeo hospedado (Shopify)", "value": "hosted" },
        { "label": "YouTube / Vimeo", "value": "external" }
      ],
      "visible_if": "{{ section.settings.media_type == 'video' }}"
    },
    {
      "type": "video",
      "id": "video_file",
      "label": "Vídeo",
      "visible_if": "{{ section.settings.media_type == 'video' and section.settings.video_source == 'hosted' }}"
    },
    {
      "type": "video_url",
      "id": "video_url",
      "label": "URL do vídeo (YouTube / Vimeo)",
      "accept": ["youtube", "vimeo"],
      "visible_if": "{{ section.settings.media_type == 'video' and section.settings.video_source == 'external' }}"
    },
    {
      "type": "checkbox",
      "id": "video_autoplay",
      "label": "Reprodução automática",
      "default": true,
      "visible_if": "{{ section.settings.media_type == 'video' }}"
    },
    {
      "type": "header",
      "content": "Textos e botão"
    },
    {
      "type": "image_picker",
      "id": "title_image",
      "label": "Imagem / barrinha acima do título"
    },
    {
      "type": "checkbox",
      "id": "title_bar",
      "label": "Exibir barra colorida acima do título",
      "default": false
    },
    {
      "type": "select",
      "id": "title_bar_position",
      "label": "Posição da barra",
      "default": "title",
      "options": [
        { "value": "title", "label": "Acima do título" },
        { "value": "wrapper", "label": "Acima do texto" }
      ],
      "visible_if": "{{ section.settings.title_bar }}"
    },
    {
      "type": "select",
      "id": "title_bar_align",
      "label": "Alinhamento",
      "default": "left",
      "options": [
        { "value": "left", "label": "Esquerda" },
        { "value": "right", "label": "Direita" }
      ],
      "visible_if": "{{ section.settings.title_bar and section.settings.title_bar_position == 'wrapper' }}"
    },
    {
      "type": "color",
      "id": "title_bar_color",
      "label": "Cor da barra",
      "default": "#F7D046",
      "visible_if": "{{ section.settings.title_bar }}"
    },
    {
      "type": "range",
      "id": "title_bar_width_desktop",
      "label": "Largura da barra (desktop)",
      "min": 40,
      "max": 300,
      "step": 4,
      "default": 120,
      "unit": "px",
      "visible_if": "{{ section.settings.title_bar }}"
    },
    {
      "type": "range",
      "id": "title_bar_width_mobile",
      "label": "Largura da barra (mobile)",
      "min": 40,
      "max": 300,
      "step": 4,
      "default": 80,
      "unit": "px",
      "visible_if": "{{ section.settings.title_bar }}"
    },
    {
      "type": "range",
      "id": "title_bar_height",
      "label": "Espessura da barra",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4,
      "unit": "px",
      "visible_if": "{{ section.settings.title_bar }}"
    },
    {
      "type": "richtext",
      "id": "title",
      "label": "Título",
      "default": "<h2>Titulo da seção</h2>"
    },
    {
      "type": "richtext",
      "id": "richtext",
      "label": "Texto",
      "default": "<p>Conteúdo da seção</p>"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "URL do botão"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Texto do botão",
      "default": "Texto do botão"
    },
    {
      "type": "header",
      "content": "FAQ"
    },
    {
      "type": "select",
      "id": "faq_icon_type",
      "label": "Ícone de abertura",
