    },
    {
      "type": "range",
      "id": "pad_bottom_desktop",
      "label": "Padding inferior desktop (px)",
      "min": 0,
      "max": 200,
      "step": 4,
      "default": 0,
      "visible_if": "{{ section.settings.enable_pad_bottom_desktop }}"
    }
  ],
  "presets": [
    {
      "name": "Newsletter",
      "category": "Newsletter",
      "settings": {
        "title": "Lorem ipsum dolor sit amet",
        "subtitle": "Lorem ipsum dolor sit amet, consectetur adipiscing elit",
        "placeholder": "Seu melhor e-mail",
        "button_text": "Enviar",
        "success_message": "Obrigado por se inscrever!"
      }
    }
  ]
}
{% endschema %}
