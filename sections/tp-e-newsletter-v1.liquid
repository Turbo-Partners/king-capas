{{ 'tp-e-newsletter-v1.css' | asset_url | stylesheet_tag }}

{% render 'tp-section-padding',
  pad_top_min: section.settings.pad_top_min,
  pad_top_max: section.settings.pad_top_max,
  pad_bottom_min: section.settings.pad_bottom_min,
  pad_bottom_max: section.settings.pad_bottom_max,
  enable_pad_top_mobile: section.settings.enable_pad_top_mobile,
  pad_top_mobile: section.settings.pad_top_mobile,
  enable_pad_bottom_mobile: section.settings.enable_pad_bottom_mobile,
  pad_bottom_mobile: section.settings.pad_bottom_mobile,
  enable_pad_top_desktop: section.settings.enable_pad_top_desktop,
  pad_top_desktop: section.settings.pad_top_desktop,
  enable_pad_bottom_desktop: section.settings.enable_pad_bottom_desktop,
  pad_bottom_desktop: section.settings.pad_bottom_desktop
%}

{% style %}
{% if section.settings.bg_custom %}
  .{{ section.id }} .tp-e-newsletter-v1__card {
    {% if section.settings.background_type == 'gradient' and section.settings.bg_gradient != blank %}
      background: {{ section.settings.bg_gradient }};
    {% elsif section.settings.bg_color != blank %}
      background: {{ section.settings.bg_color }};
    {% endif %}
  }
{% endif %}

{% if section.settings.border_custom %}
  .{{ section.id }} .tp-e-newsletter-v1__form {
    border-bottom-color: {{ section.settings.border_color }};
  }
{% endif %}

{% if section.settings.title_custom %}
  .{{ section.id }} .tp-e-newsletter-v1__title {
    color: {{ section.settings.title_color }};
    font-size: {{ section.settings.title_size_mobile }}px;
    font-weight: {{ section.settings.title_weight }};
  }

  @media screen and (min-width: 768px) {
    .{{ section.id }} .tp-e-newsletter-v1__title {
      font-size: {{ section.settings.title_size_desktop }}px;
    }
  }
{% endif %}

{% if section.settings.subtitle_custom %}
  .{{ section.id }} .tp-e-newsletter-v1__subtitle {
    color: {{ section.settings.subtitle_color }};
    font-size: {{ section.settings.subtitle_size_mobile }}px;
    font-weight: {{ section.settings.subtitle_weight }};
  }

  @media screen and (min-width: 768px) {
    .{{ section.id }} .tp-e-newsletter-v1__subtitle {
      font-size: {{ section.settings.subtitle_size_desktop }}px;
    }
  }
{% endif %}

{% if section.settings.radius_custom %}
  .{{ section.id }} .tp-e-newsletter-v1__card {
    border-radius: var(--tp-radius-{{ section.settings.card_radius }});
  }
{% endif %}

{% if section.settings.btn_custom %}
  .{{ section.id }} .tp-e-newsletter-v1__button {
    {% if section.settings.btn_bg_color != blank %}
      background: {{ section.settings.btn_bg_color }};
    {% endif %}
    {% if section.settings.btn_text_color != blank %}
      color: {{ section.settings.btn_text_color }};
    {% endif %}
    border-radius: var(--tp-radius-{{ section.settings.btn_radius }});
    font-size: {{ section.settings.btn_font_size }}px;
    font-weight: {{ section.settings.btn_font_weight }};
  }
{% endif %}
{% endstyle %}

<section class="tp-e-newsletter-v1 {{ section.id }} scroll-trigger animate--fade-in">
  <div class="tp-wrapper tp-e-newsletter-v1__wrapper">
    <div class="tp-e-newsletter-v1__card tp-e-newsletter-v1__card--{{ section.settings.layout }}">
      {% if section.settings.layout == 'image' %}
        <div class="tp-e-newsletter-v1__image">
          {% if section.settings.image != blank %}
            {{ section.settings.image | image_url: width: 1500 | image_tag:
              class: 'tp-e-newsletter-v1__img',
              loading: 'lazy',
              sizes: '(min-width: 768px) 50vw, 100vw',
              widths: '375, 750, 1100, 1500'
            }}
          {% else %}
            <div class="tp-e-newsletter-v1__img-placeholder">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>
      {% endif %}

      <div class="tp-e-newsletter-v1__content">
      <div class="tp-e-newsletter-v1__text">
        {% if section.settings.title != blank %}
          <h2 class="tp-e-newsletter-v1__title">{{ section.settings.title | escape }}</h2>
        {% endif %}

        {% if section.settings.subtitle != blank %}
          <p class="tp-e-newsletter-v1__subtitle">{{ section.settings.subtitle | escape }}</p>
        {% endif %}
      </div>

      {% form 'customer', class: 'tp-e-newsletter-v1__form' %}
        <input type="hidden" name="contact[tags]" value="newsletter">

        <input
          type="email"
          name="contact[email]"
          class="tp-e-newsletter-v1__input"
          placeholder="{{ section.settings.placeholder | escape }}"
          required
          autocomplete="email"
          aria-label="{{ section.settings.placeholder | escape }}"
        >

        <button type="submit" class="tp-e-newsletter-v1__button">
          {{ section.settings.button_text | escape }}
        </button>

        {% if form.posted_successfully? %}
          <p class="tp-e-newsletter-v1__success">{{ section.settings.success_message | escape }}</p>
        {% endif %}
      {% endform %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "class": "E__NEWSLETTER__V1",
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "default": "horizontal",
      "options": [
        { "label": "Horizontal (V1)", "value": "horizontal" },
        { "label": "Centralizado (V2)", "value": "centered" },
        { "label": "Com imagem (V3)", "value": "image" }
      ]
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagem",
      "visible_if": "{{ section.settings.layout == 'image' }}"
    },
    {
      "type": "header",
      "content": "Conteúdo"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Título",
      "default": "Lorem ipsum dolor sit amet"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtítulo",
      "default": "Lorem ipsum dolor sit amet, consectetur adipiscing elit"
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Placeholder do e-mail",
      "default": "Seu melhor e-mail"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Mensagem de sucesso",
      "default": "Obrigado por se inscrever!"
    },
    {
      "type": "header",
      "content": "Botão"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Texto",
      "default": "Enviar"
    },
    {
      "type": "checkbox",
      "id": "btn_custom",
      "label": "Personalizar",
      "default": false
    },
    {
      "type": "color",
      "id": "btn_bg_color",
      "label": "Cor de fundo",
      "visible_if": "{{ section.settings.btn_custom }}"
    },
    {
      "type": "color",
      "id": "btn_text_color",
      "label": "Cor do texto",
      "visible_if": "{{ section.settings.btn_custom }}"
    },
    {
      "type": "select",
      "id": "btn_radius",
      "label": "Arredondamento",
      "default": "full",
      "options": [
        { "label": "Nenhum", "value": "none" },
        { "label": "Pequeno", "value": "sm" },
        { "label": "Médio", "value": "md" },
        { "label": "Grande", "value": "lg" },
        { "label": "Extra Grande", "value": "xl" },
        { "label": "Completo", "value": "full" }
      ],
      "visible_if": "{{ section.settings.btn_custom }}"
    },
    {
      "type": "range",
      "id": "btn_font_size",
      "label": "Tamanho do texto (px)",
      "min": 12,
      "max": 24,
      "step": 2,
      "default": 16,
      "visible_if": "{{ section.settings.btn_custom }}"
    },
    {
      "type": "select",
      "id": "btn_font_weight",
      "label": "Peso",
      "default": "600",
      "options": [
        { "label": "Regular (400)", "value": "400" },
        { "label": "Médio (500)", "value": "500" },
        { "label": "Semi-negrito (600)", "value": "600" },
        { "label": "Negrito (700)", "value": "700" }
      ],
      "visible_if": "{{ section.settings.btn_custom }}"
    },
    {
      "type": "header",
      "content": "Aparência"
    },
    {
      "type": "select",
      "id": "background_type",
      "label": "Tipo de fundo",
      "default": "color",
      "options": [
        { "label": "Cor sólida", "value": "color" },
        { "label": "Gradiente", "value": "gradient" }
      ]
    },
    {
      "type": "checkbox",
      "id": "bg_custom",
      "label": "Personalizar fundo",
      "default": false
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Cor de fundo",
      "default": "#443FD2",
      "visible_if": "{{ section.settings.bg_custom and section.settings.background_type == 'color' }}"
    },
    {
      "type": "color_background",
      "id": "bg_gradient",
      "label": "Gradiente",
      "visible_if": "{{ section.settings.bg_custom and section.settings.background_type == 'gradient' }}"
    },
    {
      "type": "checkbox",
      "id": "radius_custom",
      "label": "Personalizar arredondamento",
      "default": false
    },
    {
      "type": "select",
      "id": "card_radius",
      "label": "Arredondamento",
      "default": "xl",
      "options": [
        { "label": "Nenhum", "value": "none" },
        { "label": "Pequeno", "value": "sm" },
        { "label": "Médio", "value": "md" },
        { "label": "Grande", "value": "lg" },
        { "label": "Extra Grande", "value": "xl" }
      ],
      "visible_if": "{{ section.settings.radius_custom }}"
    },
    {
      "type": "checkbox",
      "id": "border_custom",
      "label": "Personalizar borda do campo",
      "default": false
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Cor da borda",
      "default": "#7C77F7",
      "visible_if": "{{ section.settings.border_custom }}"
    },
    {
      "type": "header",
      "content": "Tipografia — Título"
    },
    {
      "type": "checkbox",
      "id": "title_custom",
      "label": "Personalizar",
      "default": false
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Cor",
      "visible_if": "{{ section.settings.title_custom }}"
    },
    {
      "type": "range",
      "id": "title_size_desktop",
      "label": "Tamanho desktop (px)",
      "min": 18,
      "max": 56,
      "step": 2,
      "default": 32,
      "visible_if": "{{ section.settings.title_custom }}"
    },
    {
      "type": "range",
      "id": "title_size_mobile",
      "label": "Tamanho mobile (px)",
      "min": 16,
      "max": 40,
      "step": 2,
      "default": 24,
      "visible_if": "{{ section.settings.title_custom }}"
    },
    {
      "type": "select",
      "id": "title_weight",
      "label": "Peso",
      "default": "700",
      "options": [
        { "label": "Regular (400)", "value": "400" },
        { "label": "Médio (500)", "value": "500" },
        { "label": "Semi-negrito (600)", "value": "600" },
        { "label": "Negrito (700)", "value": "700" }
      ],
      "visible_if": "{{ section.settings.title_custom }}"
    },
    {
      "type": "header",
      "content": "Tipografia — Subtítulo"
    },
    {
      "type": "checkbox",
      "id": "subtitle_custom",
      "label": "Personalizar",
      "default": false
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "Cor",
      "visible_if": "{{ section.settings.subtitle_custom }}"
    },
    {
      "type": "range",
      "id": "subtitle_size_desktop",
      "label": "Tamanho desktop (px)",
      "min": 14,
      "max": 32,
      "step": 2,
      "default": 18,
      "visible_if": "{{ section.settings.subtitle_custom }}"
    },
    {
      "type": "range",
      "id": "subtitle_size_mobile",
      "label": "Tamanho mobile (px)",
      "min": 14,
      "max": 24,
      "step": 2,
      "default": 16,
      "visible_if": "{{ section.settings.subtitle_custom }}"
    },
    {
      "type": "select",
      "id": "subtitle_weight",
      "label": "Peso",
      "default": "400",
      "options": [
        { "label": "Regular (400)", "value": "400" },
        { "label": "Médio (500)", "value": "500" },
        { "label": "Semi-negrito (600)", "value": "600" },
        { "label": "Negrito (700)", "value": "700" }
      ],
      "visible_if": "{{ section.settings.subtitle_custom }}"
    },
    {
      "type": "header",
      "content": "Espaçamento"
    },
    {
      "type": "range",
      "id": "pad_top_min",
      "label": "Padding superior mínimo (px)",
      "min": 0,
      "max": 200,
      "step": 4,
      "default": 20
    },
    {
      "type": "range",
      "id": "pad_top_max",
      "label": "Padding superior máximo (px)",
      "min": 0,
      "max": 200,
      "step": 4,
      "default": 40
    },
    {
      "type": "range",
      "id": "pad_bottom_min",
      "label": "Padding inferior mínimo (px)",
      "min": 0,
      "max": 200,
      "step": 4,
      "default": 20
    },
    {
      "type": "range",
      "id": "pad_bottom_max",
      "label": "Padding inferior máximo (px)",
      "min": 0,
      "max": 200,
      "step": 4,
      "default": 40
    },
    {
      "type": "header",
      "content": "Personalizar espaçamento por dispositivo"
    },
    {
      "type": "checkbox",
      "id": "enable_pad_top_mobile",
      "label": "Ativar padding superior no mobile",
      "default": false
    },
    {
      "type": "range",
      "id": "pad_top_mobile",
      "label": "Padding superior mobile (px)",
      "min": 0,
      "max": 200,
      "step": 4,
      "default": 0,
      "visible_if": "{{ section.settings.enable_pad_top_mobile }}"
    },
    {
      "type": "checkbox",
      "id": "enable_pad_bottom_mobile",
      "label": "Ativar padding inferior no mobile",
      "default": false
    },
    {
      "type": "range",
      "id": "pad_bottom_mobile",
      "label": "Padding inferior mobile (px)",
      "min": 0,
      "max": 200,
      "step": 4,
      "default": 0,
      "visible_if": "{{ section.settings.enable_pad_bottom_mobile }}"
    },
    {
      "type": "checkbox",
      "id": "enable_pad_top_desktop",
      "label": "Ativar padding superior no desktop",
      "default": false
    },
    {
      "type": "range",
      "id": "pad_top_desktop",
      "label": "Padding superior desktop (px)",
      "min": 0,
      "max": 200,
      "step": 4,
      "default": 0,
      "visible_if": "{{ section.settings.enable_pad_top_desktop }}"
    },
    {
      "type": "checkbox",
      "id": "enable_pad_bottom_desktop",
      "label": "Ativar padding inferior no desktop",
