{{ 'tp-e-banner-cta-v1.css' | asset_url | stylesheet_tag }}

{% render 'tp-section-padding',
  pad_top_min: section.settings.pad_top_min,
  pad_top_max: section.settings.pad_top_max,
  pad_bottom_min: section.settings.pad_bottom_min,
  pad_bottom_max: section.settings.pad_bottom_max,
  enable_pad_top_mobile: section.settings.enable_pad_top_mobile,
  pad_top_mobile: section.settings.pad_top_mobile,
  enable_pad_bottom_mobile: section.settings.enable_pad_bottom_mobile,
  pad_bottom_mobile: section.settings.pad_bottom_mobile,
  enable_pad_top_desktop: section.settings.enable_pad_top_desktop,
  pad_top_desktop: section.settings.pad_top_desktop,
  enable_pad_bottom_desktop: section.settings.enable_pad_bottom_desktop,
  pad_bottom_desktop: section.settings.pad_bottom_desktop
%}

{% liquid
  assign button_animation = section.settings.button_animation
%}

{% style %}
.{{ section.id }} .tp-banner-cta__container::before {
  background: {{ section.settings.section_bg_color }};
  {% if section.settings.card_border_radius == "none" %}
    border-radius: 0;
  {% else %}
    border-radius: var(--tp-radius-{{ section.settings.card_border_radius }});
  {% endif %}
}

.{{ section.id }} .tp-banner-cta__bg {
  {% if section.settings.card_border_radius == "none" %}
    border-radius: 0;
  {% else %}
    border-radius: var(--tp-radius-{{ section.settings.card_border_radius }});
  {% endif %}
  {% if section.settings.background_type == "image" and section.settings.background_image_mobile != blank %}
    background-image: url('{{ section.settings.background_image_mobile | image_url }}');
    background-size: cover;
    background-repeat: no-repeat;
    background-position: center;
  {% elsif section.settings.background_type == "color" %}
    background: {{ section.settings.card_bg_color }};
  {% elsif section.settings.background_type == "gradient" and section.settings.background_gradient != blank %}
    background: {{ section.settings.background_gradient }};
  {% endif %}
}

{% if section.settings.background_type == "image" and section.settings.background_image_desktop != blank %}
  @media screen and (min-width: 768px) {
    .{{ section.id }} .tp-banner-cta__bg {
      background-image: url('{{ section.settings.background_image_desktop | image_url }}');
    }
  }
{% endif %}

.{{ section.id }} .tp-banner-cta__image,
.{{ section.id }} .tp-banner-cta__placeholder {
  object-fit: {{ section.settings.image_fit }};
  object-position: {{ section.settings.image_position }};
}

.{{ section.id }} .tp-banner-cta__media {
  width: {{ section.settings.image_width_desktop }}%;
  height: {{ section.settings.image_height_desktop }}%;
}

@media screen and (max-width: 767px) {
  .{{ section.id }} .tp-banner-cta__media {
    width: {{ section.settings.image_width_mobile }}%;
    height: {{ section.settings.image_height_mobile }}%;
    bottom: {{ section.settings.image_offset_mobile }}%;
  }
}

{% if section.settings.title_custom %}
  .{{ section.id }} .tp-banner-cta__title {
    color: {{ section.settings.title_color }};
    font-size: {{ section.settings.title_font_size_mobile }}px;
    font-weight: {{ section.settings.title_font_weight }};
  }
  @media screen and (min-width: 768px) {
    .{{ section.id }} .tp-banner-cta__title {
      font-size: {{ section.settings.title_font_size_desktop }}px;
    }
  }
{% endif %}

{% if section.settings.description_custom %}
  .{{ section.id }} .tp-banner-cta__description {
    color: {{ section.settings.description_color }};
    font-size: {{ section.settings.description_font_size_mobile }}px;
    font-weight: {{ section.settings.description_font_weight }};
  }
  @media screen and (min-width: 768px) {
    .{{ section.id }} .tp-banner-cta__description {
      font-size: {{ section.settings.description_font_size_desktop }}px;
    }
  }
{% endif %}

{% if section.settings.button_custom %}
  .{{ section.id }} .tp-banner-cta__button {
    {% if section.settings.button_bg_color != blank %}
      background: {{ section.settings.button_bg_color }};
    {% endif %}
    {% if section.settings.button_text_color != blank %}
      color: {{ section.settings.button_text_color }};
    {% endif %}
    {% if section.settings.button_border_radius != "default" %}
      {% if section.settings.button_border_radius == "none" %}
        border-radius: 0;
      {% else %}
        border-radius: var(--tp-radius-{{ section.settings.button_border_radius }});
      {% endif %}
    {% endif %}
    font-size: {{ section.settings.button_font_size }}px;
    font-weight: {{ section.settings.button_font_weight }};
  }
{% endif %}
{% endstyle %}

<section class="tp-banner-cta {{ section.id }}">
  <div class="tp-wrapper" id="section-wrapper-{{ section.id }}">
    <div class="tp-banner-cta__container">
      <div class="tp-banner-cta__bg"></div>
      <div class="tp-banner-cta__content">
        <div class="tp-banner-cta__text">
          <div class="tp-banner-cta__text-inner">
            {% if section.settings.title != blank %}
              <h2 class="tp-banner-cta__title">{{ section.settings.title }}</h2>
            {% endif %}
            {% if section.settings.description != blank %}
              <div class="tp-banner-cta__description">{{ section.settings.description }}</div>
            {% endif %}
          </div>
        </div>

        <div class="tp-banner-cta__media">
          {% if section.settings.image_mobile != blank %}
            {{ section.settings.image_mobile | image_url: width: 750 | image_tag:
              class: 'tp-banner-cta__image tp-banner-cta__image--mobile',
              loading: 'lazy',
              sizes: '70vw',
              widths: '375, 550, 750'
            }}
            {% if section.settings.image != blank %}
              {{ section.settings.image | image_url: width: 1200 | image_tag:
                class: 'tp-banner-cta__image tp-banner-cta__image--desktop',
                loading: 'lazy',
                sizes: '35vw',
                widths: '550, 750, 1000, 1200'
              }}
            {% endif %}
          {% elsif section.settings.image != blank %}
            {{ section.settings.image | image_url: width: 1200 | image_tag:
              class: 'tp-banner-cta__image',
              loading: 'lazy',
              sizes: '(min-width: 768px) 35vw, 70vw',
              widths: '375, 550, 750, 1000, 1200'
            }}
          {% else %}
            {{ 'image' | placeholder_svg_tag: 'tp-banner-cta__image tp-banner-cta__placeholder' }}
          {% endif %}
        </div>

        {% if section.settings.button_text != blank and section.settings.button_url != blank %}
          <div class="tp-banner-cta__action">
            <a
              class="tp-banner-cta__button{% if button_animation != 'none' %} tp-banner-cta__button--{{ button_animation }}{% endif %}"
              href="{{ section.settings.button_url }}"
            >
              {{ section.settings.button_text }}
            </a>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
