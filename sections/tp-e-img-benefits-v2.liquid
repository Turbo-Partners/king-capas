{{ 'tp-e-img-benefits-v2.css' | asset_url | stylesheet_tag }}

{% render 'tp-section-padding',
  pad_top_min: section.settings.pad_top_min,
  pad_top_max: section.settings.pad_top_max,
  pad_bottom_min: section.settings.pad_bottom_min,
  pad_bottom_max: section.settings.pad_bottom_max,
  enable_pad_top_mobile: section.settings.enable_pad_top_mobile,
  pad_top_mobile: section.settings.pad_top_mobile,
  enable_pad_bottom_mobile: section.settings.enable_pad_bottom_mobile,
  pad_bottom_mobile: section.settings.pad_bottom_mobile,
  enable_pad_top_desktop: section.settings.enable_pad_top_desktop,
  pad_top_desktop: section.settings.pad_top_desktop,
  enable_pad_bottom_desktop: section.settings.enable_pad_bottom_desktop,
  pad_bottom_desktop: section.settings.pad_bottom_desktop
%}

{% liquid
  assign background_type = section.settings.background_type
%}

{% style %}
.{{ section.id }} {
	background-size: cover;
	background-repeat: no-repeat;
	background-position: center;

	{% if background_type == "image" and section.settings.background_image_mobile != blank %}
		background-image: url('{{ section.settings.background_image_mobile | image_url }}');

		{% if section.settings.background_image_desktop != blank %}
			@media screen and (min-width: 1024px) {
				background-image: url('{{ section.settings.background_image_desktop | image_url }}');
			}
		{% endif %}
	{% elsif background_type == "color" and section.settings.background_color != blank %}
		background: {{ section.settings.background_color }};
	{% elsif background_type == "gradient" and section.settings.background_gradient != blank %}
		background: {{ section.settings.background_gradient }};
	{% endif %}
}
{% endstyle %}

<section class="tp-e-img-benefits-v2 {{ section.id }} scroll-trigger animate--slide-in">
    <div class="tp-wrapper tp-e-img-benefits-v2__wrapper" id="section-wrapper-{{ section.id }}">
        <div class="tp-e-img-benefits-v2__text-wrapper">
            {{ section.settings.title }}
        </div>
        <div class="tp-e-img-benefits-v2__grid">
            <div class="tp-e-img-benefits-v2__media">
                {% if section.settings.image_desktop != blank %}
                    {{ section.settings.image_desktop | image_url: width: 1200 | image_tag:
                        class: 'tp-e-img-benefits-v2__image tp-e-img-benefits-v2__image--desktop',
                        loading: 'lazy',
                        widths: '375, 750, 1100, 1500, 1780, 2000'
                    }}
                {% else %}
                    {{ 'image' | placeholder_svg_tag: 'tp-e-img-benefits-v2__image tp-e-img-benefits-v2__image--desktop tp-e-img-benefits-v2__image--placeholder' }}
                {% endif %}
                {% if section.settings.image_mobile != blank %}
                    {{ section.settings.image_mobile | image_url: width: 750 | image_tag:
                        class: 'tp-e-img-benefits-v2__image tp-e-img-benefits-v2__image--mobile',
                        loading: 'lazy',
                        widths: '375, 750, 1100'
                    }}
                {% else %}
                    {{ 'image' | placeholder_svg_tag: 'tp-e-img-benefits-v2__image tp-e-img-benefits-v2__image--mobile tp-e-img-benefits-v2__image--placeholder' }}
                {% endif %}
            </div>
            <div class="tp-e-img-benefits-v2__block-wrapper tp-e-img-benefits-v2__block-wrapper--first">
                {% for block in section.blocks limit: 2 %}
                    <div class="tp-e-img-benefits-v2__block" {{ block.shopify_attributes }}>
                        {% if block.settings.image != blank %}
                            <img src="{{ block.settings.image | image_url }}" class="tp-e-img-benefits-v2__block-image" loading="lazy">
                        {% endif %}
                        <div class="tp-e-img-benefits-v2__block-text-wrapper">
                            {{ block.settings.richtext }}
                        </div>
                    </div>
                {% endfor %}
            </div>
            <div class="tp-e-img-benefits-v2__block-wrapper tp-e-img-benefits-v2__block-wrapper--second">
                {% for block in section.blocks offset: 2 limit: 2 %}
                    <div class="tp-e-img-benefits-v2__block" {{ block.shopify_attributes }}>
                        {% if block.settings.image != blank %}
                            <img src="{{ block.settings.image | image_url }}" class="tp-e-img-benefits-v2__block-image" loading="lazy">
                        {% endif %}
                        <div class="tp-e-img-benefits-v2__block-text-wrapper">
                            {{ block.settings.richtext }}
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>
</section>

{% schema %}
{
  "name": "Imagem com Benefícios V2",
  "class": "E__IMG_BENEFITS__V2",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Conteúdo"
    },
    {
      "type": "richtext",
      "id": "title",
      "label": "Título",
      "default": "<h2>Imagem com benefícios</h2>"
    },
    {
      "type": "image_picker",
      "id": "image_desktop",
      "label": "Imagem desktop"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Imagem mobile"
    },
    {
      "type": "header",
      "content": "Fundo"
    },
    {
      "type": "select",
      "id": "background_type",
      "label": "Tipo de fundo",
      "default": "color",
      "options": [
        { "label": "Cor sólida", "value": "color" },
        { "label": "Gradiente", "value": "gradient" },
        { "label": "Imagem", "value": "image" }
      ]
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Cor de fundo",
      "default": "#FFFFFF",
      "visible_if": "{{ section.settings.background_type == 'color' }}"
    },
    {
      "type": "color_background",
      "id": "background_gradient",
      "label": "Gradiente de fundo",
      "visible_if": "{{ section.settings.background_type == 'gradient' }}"
    },
    {
      "type": "image_picker",
      "id": "background_image_mobile",
      "label": "Imagem de fundo mobile",
      "visible_if": "{{ section.settings.background_type == 'image' }}"
    },
    {
      "type": "image_picker",
      "id": "background_image_desktop",
      "label": "Imagem de fundo desktop",
      "visible_if": "{{ section.settings.background_type == 'image' }}"
    },
    {
      "type": "header",
      "content": "Espaçamento"
    },
    {
      "type": "range",
      "id": "pad_top_min",
      "label": "Padding superior mínimo (px)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 48
    },
    {
      "type": "range",
      "id": "pad_top_max",
      "label": "Padding superior máximo (px)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 96
    },
    {
      "type": "range",
      "id": "pad_bottom_min",
      "label": "Padding inferior mínimo (px)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 48
    },
    {
      "type": "range",
      "id": "pad_bottom_max",
      "label": "Padding inferior máximo (px)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 96
    },
    {
      "type": "header",
      "content": "Sobrescrita de espaçamento (opcional)"
    },
    {
      "type": "checkbox",
      "id": "enable_pad_top_mobile",
      "label": "Ativar padding superior no mobile",
      "default": false
    },
    {
      "type": "range",
      "id": "pad_top_mobile",
      "label": "Padding superior no mobile (px)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 0,
      "visible_if": "{{ section.settings.enable_pad_top_mobile }}"
    },
    {
      "type": "checkbox",
      "id": "enable_pad_bottom_mobile",
      "label": "Ativar padding inferior no mobile",
      "default": false
    },
    {
      "type": "range",
      "id": "pad_bottom_mobile",
      "label": "Padding inferior no mobile (px)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 0,
      "visible_if": "{{ section.settings.enable_pad_bottom_mobile }}"
    },
    {
      "type": "checkbox",
      "id": "enable_pad_top_desktop",
      "label": "Ativar padding superior no desktop",
      "default": false
    },
    {
      "type": "range",
      "id": "pad_top_desktop",
      "label": "Padding superior no desktop (px)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 0,
      "visible_if": "{{ section.settings.enable_pad_top_desktop }}"
    },
    {
      "type": "checkbox",
      "id": "enable_pad_bottom_desktop",
      "label": "Ativar padding inferior no desktop",
      "default": false
    },
    {
      "type": "range",
      "id": "pad_bottom_desktop",
      "label": "Padding inferior no desktop (px)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 0,
      "visible_if": "{{ section.settings.enable_pad_bottom_desktop }}"
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefício",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Ícone"
        },
        {
          "type": "richtext",
          "id": "richtext",
          "label": "Texto",
          "default": "<p>Descreva o benefício</p>"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Imagem com Benefícios V2",
      "category": "Images and text",
      "settings": {
        "title": "<h2>Imagem com benefícios</h2>",
        "background_color": "#FFFFFF"
      },
      "blocks": [
        { "type": "benefit", "settings": { "richtext": "<p><strong>Benefício 1</strong></p><p>Descreva o benefício aqui</p>" } },
        { "type": "benefit", "settings": { "richtext": "<p><strong>Benefício 2</strong></p><p>Descreva o benefício aqui</p>" } },
        { "type": "benefit", "settings": { "richtext": "<p><strong>Benefício 3</strong></p><p>Descreva o benefício aqui</p>" } },
        { "type": "benefit", "settings": { "richtext": "<p><strong>Benefício 4</strong></p><p>Descreva o benefício aqui</p>" } }
      ]
    }
  ]
}
{% endschema %}