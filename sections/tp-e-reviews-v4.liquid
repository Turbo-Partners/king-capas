{{ 'tp-e-reviews-v4.css' | asset_url | stylesheet_tag }}

{% render 'tp-section-padding',
  pad_top_min: section.settings.pad_top_min,
  pad_top_max: section.settings.pad_top_max,
  pad_bottom_min: section.settings.pad_bottom_min,
  pad_bottom_max: section.settings.pad_bottom_max,
  enable_pad_top_mobile: section.settings.enable_pad_top_mobile,
  pad_top_mobile: section.settings.pad_top_mobile,
  enable_pad_bottom_mobile: section.settings.enable_pad_bottom_mobile,
  pad_bottom_mobile: section.settings.pad_bottom_mobile,
  enable_pad_top_desktop: section.settings.enable_pad_top_desktop,
  pad_top_desktop: section.settings.pad_top_desktop,
  enable_pad_bottom_desktop: section.settings.enable_pad_bottom_desktop,
  pad_bottom_desktop: section.settings.pad_bottom_desktop
%}

{% liquid
  assign background_type = section.settings.background_type
  assign pagination = section.settings.pagination
  assign navigation = section.settings.navigation
%}

{% style %}
  .{{ section.id }} {
    background-size: cover;
    background-repeat: no-repeat;
    background-position: center;
    {% if background_type == "color" and section.settings.background_color != blank %}
      background: {{ section.settings.background_color }};
    {% elsif background_type == "gradient" and section.settings.background_gradient != blank %}
      background: {{ section.settings.background_gradient }};
    {% elsif background_type == "image" and section.settings.background_image_mobile != blank %}
      background-image: url('{{ section.settings.background_image_mobile | image_url }}');
    {% endif %}
  }

  {% if background_type == "image" and section.settings.background_image_desktop != blank %}
    @media screen and (min-width: 750px) {
      .{{ section.id }} {
        background-image: url('{{ section.settings.background_image_desktop | image_url }}');
      }
    }
  {% endif %}

  {% if section.settings.title_bar %}
    .{{ section.id }} .tp-e-reviews-v4__bar {
      display: block;
      width: 64px;
      height: 2px;
      background: {{ section.settings.title_bar_color }};
    }
  {% endif %}

  {% for block in section.blocks %}
    {% if block.type == 'review' %}
      .{{ section.id }} .tp-e-reviews-v4__review--{{ block.id }} {
        {% if block.settings.bg_type == 'color' and block.settings.bg_color != blank %}
          background: {{ block.settings.bg_color }};
        {% elsif block.settings.bg_type == 'gradient' and block.settings.bg_gradient != blank %}
          background: {{ block.settings.bg_gradient }};
        {% endif %}
        {% if block.settings.show_border %}
          border: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
        {% endif %}
        border-radius: {% if block.settings.card_radius == 'none' %}0{% else %}var(--tp-radius-{{ block.settings.card_radius }}){% endif %};
      }
    {% endif %}
  {% endfor %}

  {% if section.settings.title_custom %}
    .{{ section.id }} .tp-e-reviews-v4__header h2 {
      color: {{ section.settings.title_color }};
      font-size: {{ section.settings.title_font_size_mobile }}px;
    }
    @media screen and (min-width: 750px) {
      .{{ section.id }} .tp-e-reviews-v4__header h2 {
        font-size: {{ section.settings.title_font_size_desktop }}px;
      }
    }
  {% endif %}

  {% if pagination %}
    .{{ section.id }} .swiper-pagination-bullet {
      background: {{ section.settings.pagination_color }};
      opacity: 1;
    }
    .{{ section.id }} .swiper-pagination-bullet-active {
      background: {{ section.settings.pagination_color_active }};
    }
  {% endif %}

  {% if navigation %}
    .{{ section.id }} .swiper-button-prev,
    .{{ section.id }} .swiper-button-next {
      width: clamp(2.4rem, 2.1029rem + 0.7619vw, 3.2rem);
    }
    .{{ section.id }} .swiper-button-prev svg,
    .{{ section.id }} .swiper-button-next svg {
      fill: none;
    }
    .{{ section.id }} .swiper-button-prev::after,
    .{{ section.id }} .swiper-button-next::after {
      content: '';
      color: transparent;
    }
  {% endif %}
{% endstyle %}

<section class="tp-e-reviews-v4 {{ section.id }} scroll-trigger animate--fade-in" id="section-wrapper-{{ section.id }}">

  {% if section.settings.title != blank or section.settings.title_image != blank %}
    <div class="tp-wrapper">
      <div class="tp-e-reviews-v4__header">
        {% if section.settings.title_image != blank %}
          {{ section.settings.title_image | image_url: width: 200 | image_tag:
            class: 'tp-e-reviews-v4__header-image',
            loading: 'lazy',
            widths: '96, 128, 200',
            alt: section.settings.title_image.alt | default: ''
          }}
        {% endif %}
        {% if section.settings.title_bar %}
          <span class="tp-e-reviews-v4__bar" aria-hidden="true"></span>
        {% endif %}
        {% if section.settings.title != blank %}
          {{ section.settings.title }}
        {% endif %}
      </div>
    </div>
  {% endif %}

  {% if section.blocks.size > 0 %}
    <div class="tp-e-reviews-v4__carousel">
      <div class="swiper tp-e-reviews-v4__swiper">
        <div class="swiper-wrapper">
          {% for block in section.blocks %}
            <div class="swiper-slide" {{ block.shopify_attributes }}>

              {% if block.type == 'image' %}
                <div class="tp-e-reviews-v4__image">
                  {% if block.settings.image != blank %}
                    {{ block.settings.image | image_url: width: 800 | image_tag:
                      loading: 'lazy',
                      widths: '375, 600, 800',
                      sizes: '(min-width: 750px) 33vw, 80vw',
                      alt: block.settings.image.alt | default: ''
                    }}
                  {% endif %}
                </div>

              {% elsif block.type == 'testimonial' %}
                <div class="tp-e-reviews-v4__testimonial">
                  {% if block.settings.image != blank %}
                    {{ block.settings.image | image_url: width: 200 | image_tag:
                      class: 'tp-e-reviews-v4__testimonial-logo',
                      loading: 'lazy',
                      widths: '72, 96, 144, 200',
                      alt: block.settings.image.alt | default: ''
                    }}
                  {% endif %}
                  {% if block.settings.richtext != blank %}
                    <div class="tp-e-reviews-v4__testimonial-text">
                      {{ block.settings.richtext }}
                    </div>
                  {% endif %}
                  {% if block.settings.author %}
                    <div class="tp-e-reviews-v4__author">
                      {% if block.settings.author_image != blank %}
                        {{ block.settings.author_image | image_url: width: 128 | image_tag:
                          class: 'tp-e-reviews-v4__author-avatar',
                          loading: 'lazy',
                          widths: '48, 64, 96, 128',
                          sizes: '64px',
                          alt: block.settings.author_name | default: ''
                        }}
                      {% endif %}
                      <div class="tp-e-reviews-v4__author-info">
                        {% if block.settings.author_name != blank %}
                          <p class="tp-e-reviews-v4__author-name">{{ block.settings.author_name | escape }}</p>
                        {% endif %}
                        {% if block.settings.author_instagram != blank %}
                          <p class="tp-e-reviews-v4__author-handle">{{ block.settings.author_instagram | escape }}</p>
                        {% endif %}
                      </div>
                    </div>
                  {% endif %}
                </div>

              {% elsif block.type == 'review' %}
                <div class="tp-e-reviews-v4__review tp-e-reviews-v4__review--{{ block.id }}">
                  {% if block.settings.stars > 0 %}
                    <div class="tp-e-reviews-v4__review-stars">
                      {% for i in (1..block.settings.stars) %}
                        <span class="tp-e-reviews-v4__star" aria-hidden="true">
                          {% if section.settings.star_icon != blank %}
                            {{ section.settings.star_icon | image_url: width: 32 | image_tag:
                              loading: 'lazy',
                              widths: '16, 24, 32',
                              sizes: '16px',
                              alt: 'estrelas de avaliações'
                            }}
                          {% else %}
                            {{ 'icon-star.svg' | inline_asset_content }}
                          {% endif %}
                        </span>
                      {% endfor %}
                    </div>
                  {% endif %}
                  {% if block.settings.title != blank %}
                    <p class="tp-e-reviews-v4__review-title">{{ block.settings.title | escape }}</p>
                  {% endif %}
                  {% if block.settings.subtitle != blank %}
                    <p class="tp-e-reviews-v4__review-subtitle">{{ block.settings.subtitle | escape }}</p>
                  {% endif %}
                  {% if block.settings.text != blank %}
                    <div class="tp-e-reviews-v4__review-text">{{ block.settings.text }}</div>
                  {% endif %}
                  <div class="tp-e-reviews-v4__review-footer">
                    <div class="tp-e-reviews-v4__review-author">
                      {% if block.settings.name != blank %}
                        <p class="tp-e-reviews-v4__review-name">{{ block.settings.name | escape }}</p>
                      {% endif %}
                      {% if block.settings.profession != blank %}
                        <p class="tp-e-reviews-v4__review-profession">{{ block.settings.profession | escape }}</p>
                      {% endif %}
                    </div>
                    {% if block.settings.purchase_text != blank or block.settings.purchase_icon != blank %}
                      <div class="tp-e-reviews-v4__purchase">
                        {% if block.settings.purchase_icon != blank %}
                          {{ block.settings.purchase_icon | image_url: width: 48 | image_tag:
                            loading: 'lazy',
                            widths: '20, 32, 48',
                            sizes: '20px',
                            alt: ''
                          }}
                        {% endif %}
                        {% if block.settings.purchase_text != blank %}
                          <span>{{ block.settings.purchase_text | escape }}</span>
                        {% endif %}
                      </div>
                    {% endif %}
                  </div>
                </div>

              {% endif %}
            </div>
          {% endfor %}
        </div>

        {% if navigation %}
          <div class="swiper-button-prev">
            {% if section.settings.navigation_prev_image != blank %}
              {{ section.settings.navigation_prev_image | image_url: width: 64 | image_tag:
                loading: 'lazy',
                widths: '32, 48, 64',
                alt: ''
              }}
            {% else %}
              {{ 'tp-button-prev.svg' | inline_asset_content }}
            {% endif %}
          </div>
          <div class="swiper-button-next">
            {% if section.settings.navigation_next_image != blank %}
              {{ section.settings.navigation_next_image | image_url: width: 64 | image_tag:
                loading: 'lazy',
                widths: '32, 48, 64',
                alt: ''
              }}
            {% else %}
              {{ 'tp-button-next.svg' | inline_asset_content }}
            {% endif %}
          </div>
        {% endif %}
      </div>

      {% if pagination %}
        <div class="swiper-pagination"></div>
      {% endif %}
    </div>
  {% endif %}

</section>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    new Swiper('.{{ section.id }} .tp-e-reviews-v4__swiper', {
      slidesPerView: 1.2,
      spaceBetween: 16,
      centeredSlides: true,
      initialSlide: 2,
      breakpoints: {
        640: {
          slidesPerView: 1.8,
          centeredSlides: false
        },
        1024: {
          slidesPerView: 2.8,
          centeredSlides: false,
          spaceBetween: 24
        },
        1280: {
          slidesPerView: 3.5,
          centeredSlides: true,
          spaceBetween: 32
        }
      },
      {% if pagination %}
        pagination: {
          el: '.{{ section.id }} .swiper-pagination',
          clickable: true
        },
      {% endif %}
      {% if navigation %}
        navigation: {
          prevEl: '.{{ section.id }} .swiper-button-prev',
          nextEl: '.{{ section.id }} .swiper-button-next'
        },
      {% endif %}
    });
  });
</script>

{% schema %}
