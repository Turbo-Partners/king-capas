{{ 'tp-e-banner-slides-v1.css' | asset_url | stylesheet_tag }}

{% render 'tp-section-padding',
  pad_top_min: section.settings.pad_top_min,
  pad_top_max: section.settings.pad_top_max,
  pad_bottom_min: section.settings.pad_bottom_min,
  pad_bottom_max: section.settings.pad_bottom_max,
  enable_pad_top_mobile: section.settings.enable_pad_top_mobile,
  pad_top_mobile: section.settings.pad_top_mobile,
  enable_pad_bottom_mobile: section.settings.enable_pad_bottom_mobile,
  pad_bottom_mobile: section.settings.pad_bottom_mobile,
  enable_pad_top_desktop: section.settings.enable_pad_top_desktop,
  pad_top_desktop: section.settings.pad_top_desktop,
  enable_pad_bottom_desktop: section.settings.enable_pad_bottom_desktop,
  pad_bottom_desktop: section.settings.pad_bottom_desktop
%}

{% liquid
    assign background_type = section.settings.background_type

    assign autoplay = section.settings.autoplay
    assign autoplay_time = section.settings.tempo_autoplay | times: 1000
    assign pagination = section.settings.pagination
%}

{% style %}
.{{ section.id }} {
	background-size: cover;
	background-repeat: no-repeat;
	background-position: center;

	{% if background_type == "image" and section.settings.background_image_mobile != blank %}
		background-image: url('{{ section.settings.background_image_mobile | image_url }}');

		{% if section.settings.background_image_desktop != blank %}
			@media screen and (min-width: 1024px) {
				background-image: url('{{ section.settings.background_image_desktop | image_url }}');
			}
		{% endif %}
	{% elsif background_type == "color" and section.settings.background_color != blank %}
		background: {{ section.settings.background_color }};
	{% elsif background_type == "gradient" and section.settings.background_gradient != blank %}
		background: {{ section.settings.background_gradient }};
	{% endif %}

    {% if pagination %}
        .swiper-pagination {
            .swiper-pagination-bullet {
                background: {{ section.settings.pagination_color }};
                opacity: 1;
            }

            .swiper-pagination-bullet-active {
                background: {{ section.settings.pagination_color_active }};
            }
        }
    {% endif %}
}

.{{ section.id }} .swiper-pagination .swiper-pagination-bullet {
  background: {{ section.settings.pagination_color }};
  opacity: 1;
} 

.{{ section.id }} .swiper-pagination .swiper-pagination-bullet-active {
  background: {{ section.settings.pagination_color_active }};
}
{% endstyle %}

<section class="tp-e-banner-slides-v1 {{ section.id }}">
    <div class="tp-wrapper--full-width tp-e-banner-slides-v1__wrapper" id="section-wrapper-{{ section.id }}">
        <div class="swiper tp-e-banner-slides-v1__swiper">
            <div class="swiper-wrapper tp-e-banner-slides-v1__swiper-wrapper">
                {% for block in section.blocks %}
                  {% liquid
                    assign richtext_mobile_class = 'tp-e-banner-slides-v1__text-wrapper--left-mobile'
                    if block.settings.text_position_horizontal_mobile == 'center'
                      assign richtext_mobile_class = 'tp-e-banner-slides-v1__text-wrapper--center-mobile'
                    elsif block.settings.text_position_horizontal_mobile == 'right'
                      assign richtext_mobile_class = 'tp-e-banner-slides-v1__text-wrapper--right-mobile'
                    endif

                    assign richtext_desktop_class = 'tp-e-banner-slides-v1__text-wrapper--left-desktop'
                    if block.settings.text_position_horizontal_desktop == 'center'
                      assign richtext_desktop_class = 'tp-e-banner-slides-v1__text-wrapper--center-desktop'
                    elsif block.settings.text_position_horizontal_desktop == 'right'
                      assign richtext_desktop_class = 'tp-e-banner-slides-v1__text-wrapper--right-desktop'
                    endif

                    assign richtext_vertical_mobile_class = 'tp-e-banner-slides-v1__text-wrapper--bottom-mobile'
                    if block.settings.text_position_vertical_mobile == 'top'
                      assign richtext_vertical_mobile_class = 'tp-e-banner-slides-v1__text-wrapper--top-mobile'
                    elsif block.settings.text_position_vertical_mobile == 'center'
                      assign richtext_vertical_mobile_class = 'tp-e-banner-slides-v1__text-wrapper--middle-mobile'
                    elsif block.settings.text_position_vertical_mobile == 'space_between'
                      assign richtext_vertical_mobile_class = 'tp-e-banner-slides-v1__text-wrapper--space-between-mobile'
                    endif

                    assign richtext_vertical_desktop_class = 'tp-e-banner-slides-v1__text-wrapper--bottom-desktop'
                    if block.settings.text_position_vertical_desktop == 'top'
                      assign richtext_vertical_desktop_class = 'tp-e-banner-slides-v1__text-wrapper--top-desktop'
                    elsif block.settings.text_position_vertical_desktop == 'center'
                      assign richtext_vertical_desktop_class = 'tp-e-banner-slides-v1__text-wrapper--middle-desktop'
                    elsif block.settings.text_position_vertical_desktop == 'space_between'
                      assign richtext_vertical_desktop_class = 'tp-e-banner-slides-v1__text-wrapper--space-between-desktop'
                    endif

                    assign text_align_mobile = block.settings.text_alignment_mobile | default: 'left'
                    assign text_align_desktop = block.settings.text_alignment_desktop | default: 'left'

                    assign items_align_mobile = 'flex-start'
                    if text_align_mobile == 'center'
                      assign items_align_mobile = 'center'
                    elsif text_align_mobile == 'right'
                      assign items_align_mobile = 'flex-end'
                    endif

                    assign items_align_desktop = 'flex-start'
                    if text_align_desktop == 'center'
                      assign items_align_desktop = 'center'
                    elsif text_align_desktop == 'right'
                      assign items_align_desktop = 'flex-end'
                    endif

                  %}

                    {% liquid
                      assign slide_is_link = false
                      if block.settings.link != blank and block.settings.media_type == 'image' and block.settings.button_link == blank
                        assign slide_is_link = true
                      endif
                    %}
                    {% style %}
                      {% if block.settings.button_custom %}
                        .{{ block.id }} .tp-e-banner-slides-v1__button {
                          {% if block.settings.button_bg_color != blank %}
                            background: {{ block.settings.button_bg_color }};
                          {% endif %}
                          {% if block.settings.button_text_color != blank %}
                            color: {{ block.settings.button_text_color }};
                          {% endif %}
                          {% if block.settings.button_border_radius != "default" %}
                            {% if block.settings.button_border_radius == "none" %}
                              border-radius: 0;
                            {% else %}
                              border-radius: var(--tp-radius-{{ block.settings.button_border_radius }});
                            {% endif %}
                          {% endif %}
                          font-size: {{ block.settings.button_font_size }}px;
                          font-weight: {{ block.settings.button_font_weight }};
                        }
                      {% endif %}

                      {% if block.settings.description_custom %}
                        .{{ block.id }} .tp-e-banner-slides-v1__text {
                          color: {{ block.settings.description_color }};
                          font-size: {{ block.settings.description_font_size_mobile }}px;
                          font-weight: {{ block.settings.description_font_weight }};
                        }

                        @media screen and (min-width: 768px) {
                          .{{ block.id }} .tp-e-banner-slides-v1__text {
                            font-size: {{ block.settings.description_font_size_desktop }}px;
                          }
                        }
                      {% endif %}

                      {% if block.settings.title_custom %}
                        .{{ block.id }} .tp-e-banner-slides-v1__title {
                          color: {{ block.settings.title_color }};
                          font-size: {{ block.settings.title_font_size_mobile }}px;
                          font-weight: {{ block.settings.title_font_weight }};
                        }

                        @media screen and (min-width: 768px) {
                          .{{ block.id }} .tp-e-banner-slides-v1__title {
                            font-size: {{ block.settings.title_font_size_desktop }}px;
                          }
                        }
                      {% endif %}
                    {% endstyle %}
                    <div class="swiper-slide tp-e-banner-slides-v1__swiper-slide {{ block.id }}" {{ block.shopify_attributes }}>
                        {% if slide_is_link %}
                            <a href="{{ block.settings.link }}" class="tp-e-banner-slides-v1__slide">
                        {% else %}
                            <div class="tp-e-banner-slides-v1__slide">
                        {% endif %}
                                <div class="tp-e-banner-slides-v1__media">
                                    {% if block.settings.media_type == 'video' %}
                                        {% if block.settings.video_mobile != blank %}
                                            {{ block.settings.video_mobile | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false, class: 'tp-e-banner-slides-v1__video--mobile tp-e-banner-slides-v1__video' }}
                                        {% elsif block.settings.video_desktop != blank %}
                                            {{ block.settings.video_desktop | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false, class: 'tp-e-banner-slides-v1__video--mobile tp-e-banner-slides-v1__video' }}
                                        {% endif %}
                                        {% if block.settings.video_desktop != blank %}
                                            {{ block.settings.video_desktop | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false, class: 'tp-e-banner-slides-v1__video--desktop tp-e-banner-slides-v1__video' }}
                                        {% elsif block.settings.video_mobile != blank %}
                                            {{ block.settings.video_mobile | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false, class: 'tp-e-banner-slides-v1__video--desktop tp-e-banner-slides-v1__video' }}
                                        {% endif %}
                                        {% if block.settings.video_mobile == blank and block.settings.video_desktop == blank %}
                                            <div class="tp-e-banner-slides-v1__placeholder" aria-hidden="true">
                                                {{ 'lifestyle-2' | placeholder_svg_tag: 'tp-e-banner-slides-v1__placeholder-svg' }}
                                            </div>
                                        {% endif %}
                                    {% elsif block.settings.media_type == 'image' %}
                                        {% if block.settings.image_mobile != blank or block.settings.image_desktop != blank %}
                                          
                                            {% assign mobile_image = block.settings.image_mobile | default: block.settings.image_desktop %}
                                            {% assign desktop_image = block.settings.image_desktop | default: block.settings.image_mobile %}
                                            {% assign image_loading = 'lazy' %}
                                            {% if forloop.first %}
                                              {% assign image_loading = 'eager' %}
                                            {% endif %}
                                            <img
                                                class="tp-e-banner-slides-v1__image tp-e-banner-slides-v1__image--mobile"
                                                src="{{ mobile_image | image_url: width: 768 }}"
                                                alt="{{ mobile_image.alt | escape }}"
                                                loading="{{ image_loading }}">
                                            <img
                                                class="tp-e-banner-slides-v1__image tp-e-banner-slides-v1__image--desktop"
                                                src="{{ desktop_image | image_url: width: 1920 }}"
                                                alt="{{ desktop_image.alt | escape }}"
                                                loading="lazy">
                                        {% else %}
                                            <div class="tp-e-banner-slides-v1__placeholder" aria-hidden="true">
                                                {{ 'lifestyle-2' | placeholder_svg_tag: 'tp-e-banner-slides-v1__placeholder-svg' }}
                                            </div>
                                        {% endif %}

                                    {% endif %}
                                </div>
                                {% if block.settings.richtext != blank 
                                or block.settings.button_text != blank
                                or block.settings.title != blank %}

                                    <div
                                      class="tp-e-banner-slides-v1__text-wrapper {{ richtext_desktop_class }} {{ richtext_mobile_class }} {{ richtext_vertical_mobile_class }} {{ richtext_vertical_desktop_class }}"
                                      style="
                                        --tp-text-width-mobile: {{ block.settings.text_width_mobile }}px;
                                        --tp-text-width-desktop: {{ block.settings.text_width_desktop }}px;
                                        --tp-text-top-mobile: {{ block.settings.top_mobile }}px;
                                        --tp-text-top-desktop: {{ block.settings.top_desktop }}px;
                                        --tp-text-bottom-mobile: {{ block.settings.bottom_mobile }}px;
                                        --tp-text-bottom-desktop: {{ block.settings.bottom_desktop }}px;
                                        --tp-text-align-mobile: {{ text_align_mobile }};
                                        --tp-text-align-desktop: {{ text_align_desktop }};
                                        --tp-items-align-mobile: {{ items_align_mobile }};
                                        --tp-items-align-desktop: {{ items_align_desktop }};
                                      "
                                    >
                                        <div class="tp-e-banner-slides-v1__richtext">
                                            <div class="tp-e-banner-slides-v1__title">
                                              {{ block.settings.title }}
                                            </div>
                                            <div class="tp-e-banner-slides-v1__text">
                                              {{ block.settings.richtext }}
                                            </div>
                                        </div>
                                        {% if block.settings.button_text != blank%}
                                          {% if block.settings.button_link != blank %}
                                            <a class="tp-button tp-e-banner-slides-v1__button {% if block.settings.button_animation != 'none' %} tp-e-banner-slides-v1__button--{{ block.settings.button_animation }}{% endif %}" href="{{ block.settings.button_link }}">
                                          {% else %}
                                            <div class="tp-button tp-e-banner-slides-v1__button">
                                          {% endif %}
                                            {{ block.settings.button_text }}
                                          {% if block.settings.button_link != blank %}
                                            </a>
                                          {% else %}
                                            </div>
                                          {% endif %}
                                        {% endif %}
                                    </div>
                                {% endif %}

                        {% if slide_is_link %}
                            </a>
                        {% else %}
                            </div>
                        {% endif %}
                    </div>
                {% endfor %}
            </div>
            {% if pagination %}
                <div class="swiper-pagination tp-e-banner-slides-v1__swiper-pagination">

                </div>
            {% endif %}
        </div>
    </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const swiper_{{ section.id | replace: '-', '_' }} = new Swiper('.{{ section.id }} .swiper', {
        slidesPerView: 1,
        {% if autoplay %}   
            autoplay: {
                delay: {{ autoplay_time }},
            },
        {% endif %}
        {% if pagination %}
            pagination: {
                el: '.{{ section.id }} .swiper-pagination',
                clickable: true,
            }
        {% endif %}
    })
  });
</script>

{% schema %}
{
  "name": "Banner Slides",
  "class": "E__BANNER_SLIDES__V1",
  "settings": [
    {
      "type": "header",
      "content": "Slider"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay",
      "default": true
    },
    {
      "type": "range",
      "id": "tempo_autoplay",
      "label": "Tempo de autoplay",
      "default": 4,
      "min": 2,
      "max": 10,
      "step": 1,
      "unit": "s",
      "visible_if": "{{ section.settings.autoplay }}"
    },
    {
      "type": "checkbox",
      "id": "pagination",
      "label": "Paginação",
      "default": true
    },
    {
      "type": "color",
      "label": "Cor da Paginação",
      "default": "#B1BFAB",
      "id": "pagination_color",
      "visible_if": "{{ section.settings.pagination }}"
    },
    {
      "type": "color",
      "label": "Cor da Paginação Ativa",
      "default": "#000",
      "id": "pagination_color_active",
      "visible_if": "{{ section.settings.pagination }}"
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "select",
      "id": "background_type",
      "label": "Tipo de Background",
      "default": "color",
      "options": [
        { "label": "Cor", "value": "color" },
        { "label": "Gradiente", "value": "gradient" },
        { "label": "Imagem", "value": "image" }
      ]
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Cor do Background",
      "default": "#FFFFFF",
      "visible_if": "{{ section.settings.background_type == 'color' }}"
    },
    {
      "type": "color_background",
      "id": "background_gradient",
      "label": "Gradiente do Background",
      "visible_if": "{{ section.settings.background_type == 'gradient' }}"
    },
    {
      "type": "image_picker",
      "id": "background_image_mobile",
      "label": "Imagem Mobile do Background",
      "visible_if": "{{ section.settings.background_type == 'image' }}"
    },
    {
      "type": "image_picker",
      "id": "background_image_desktop",
      "label": "Imagem Desktop do Background",
      "visible_if": "{{ section.settings.background_type == 'image' }}"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "pad_top_min",
      "label": "Padding TOP min (px)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 48
    },
    {
      "type": "range",
      "id": "pad_top_max",
      "label": "Padding TOP max (px)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 96
    },
    {
      "type": "range",
      "id": "pad_bottom_min",
      "label": "Padding BOTTOM min (px)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 48
    },
    {
      "type": "range",
      "id": "pad_bottom_max",
      "label": "Padding BOTTOM max (px)",
      "min": 0,
      "max": 120,
      "step": 8,
      "default": 96
    },
    {
      "type": "header",
      "content": "Spacing Overrides (opcional)"
    },
    {
      "type": "checkbox",
      "id": "enable_pad_top_mobile",
      "label": "Ativar padding TOP no mobile",
      "default": false
    },
    {
      "type": "range",
      "id": "pad_top_mobile",
      "label": "Padding TOP mobile (px)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 0,
      "visible_if": "{{ section.settings.enable_pad_top_mobile }}"
    },
    {
      "type": "checkbox",
      "id": "enable_pad_bottom_mobile",
      "label": "Ativar padding BOTTOM no mobile",
      "default": false
    },
    {
      "type": "range",
      "id": "pad_bottom_mobile",
      "label": "Padding BOTTOM mobile (px)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 0,
      "visible_if": "{{ section.settings.enable_pad_bottom_mobile }}"
    },
    {
      "type": "checkbox",
      "id": "enable_pad_top_desktop",
      "label": "Ativar padding TOP no desktop",
      "default": false
    },
    {
      "type": "range",
      "id": "pad_top_desktop",
      "label": "Padding TOP desktop (px)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 0,
      "visible_if": "{{ section.settings.enable_pad_top_desktop }}"
    },
    {
      "type": "checkbox",
      "id": "enable_pad_bottom_desktop",
      "label": "Ativar padding BOTTOM no desktop",
      "default": false
    },
    {
      "type": "range",
      "id": "pad_bottom_desktop",
      "label": "Padding BOTTOM desktop (px)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 0,
      "visible_if": "{{ section.settings.enable_pad_bottom_desktop }}"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "select",
          "id": "media_type",
          "label": "Tipo de mídia",
          "default": "image",
          "options": [
            { "label": "Imagem", "value": "image" },
            { "label": "Vídeo", "value": "video" }
          ]
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Imagem mobile",
          "visible_if": "{{ block.settings.media_type == 'image' }}"
        },
        {
          "type": "image_picker",
          "id": "image_desktop",
          "label": "Imagem desktop",
          "visible_if": "{{ block.settings.media_type == 'image' }}"
        },
        {
          "type": "video",
          "id": "video_mobile",
          "label": "Vídeo mobile",
          "visible_if": "{{ block.settings.media_type == 'video' }}"
        },
        {
          "type": "video",
          "id": "video_desktop",
          "label": "Vídeo desktop",
          "visible_if": "{{ block.settings.media_type == 'video' }}"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link do slide",
          "visible_if": "{{ block.settings.button_link == blank }}"
        },
        {
          "type": "richtext",
          "label": "Título",
          "id": "title",
          "default": "<h2>Título</h2>"
        },
        {
          "type": "richtext",
          "id": "richtext",
          "label": "Texto",
          "default": "<p>texto</p>"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Link do botão",
          "visible_if": "{{ block.settings.link == blank }}"
        },
        {
          "type": "header",
          "content": "Botão"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Texto",
          "default": "CTA"
        },
        {
          "type": "select",
          "id": "button_animation",
          "label": "Animação",
          "default": "none",
          "options": [
            { "label": "Nenhuma", "value": "none" },
            { "label": "Zoom", "value": "zoom" },
            { "label": "Troca de background", "value": "swap-bg" },
            { "label": "Translate Y", "value": "translate-y" }
          ]
        },
        {
          "type": "checkbox",
          "id": "button_custom",
          "label": "Personalizar",
          "default": false
        },
        {
          "type": "color",
          "id": "button_bg_color",
          "label": "Cor de fundo",
          "visible_if": "{{ block.settings.button_custom }}"
        },
        {
          "type": "color",
          "id": "button_text_color",
          "label": "Cor do texto",
          "visible_if": "{{ block.settings.button_custom }}"
        },
        {
          "type": "select",
          "id": "button_border_radius",
          "label": "Arredondamento",
          "default": "default",
          "visible_if": "{{ block.settings.button_custom }}",
          "options": [
            { "label": "Padrão (Design System)", "value": "default" },
            { "label": "Nenhum", "value": "none" },
            { "label": "Pequeno", "value": "sm" },
            { "label": "Médio", "value": "md" },
            { "label": "Grande", "value": "lg" },
            { "label": "Extra Grande", "value": "xl" },
            { "label": "Completo", "value": "full" }
          ]
        },
        {
          "type": "range",
          "id": "button_font_size",
          "label": "Tamanho do texto",
          "min": 12,
          "max": 24,
          "step": 1,
          "default": 16,
          "unit": "px",
          "visible_if": "{{ block.settings.button_custom }}"
        },
        {
          "type": "select",
          "id": "button_font_weight",
          "label": "Peso do texto",
          "default": "600",
          "visible_if": "{{ block.settings.button_custom }}",
          "options": [
            { "label": "Regular", "value": "400" },
            { "label": "Medium", "value": "500" },
            { "label": "Semi Bold", "value": "600" },
            { "label": "Bold", "value": "700" }
          ]
        },
        {
          "type": "header",
          "content": "Tipografia"
        },
        {
          "type": "checkbox",
          "id": "title_custom",
          "label": "Personalizar título",
          "default": false
        },
        {
          "type": "color",
          "id": "title_color",
          "label": "Cor",
          "default": "#2B2B2B",
          "visible_if": "{{ block.settings.title_custom }}"
        },
        {
          "type": "range",
          "id": "title_font_size_mobile",
          "label": "Tamanho (mobile)",
          "min": 16,
          "max": 72,
          "step": 2,
          "default": 36,
          "unit": "px",
