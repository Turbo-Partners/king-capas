{{ 'tp-e-categories-v5.css' | asset_url | stylesheet_tag }}

{% render 'tp-section-padding',
  pad_top_min: section.settings.pad_top_min,
  pad_top_max: section.settings.pad_top_max,
  pad_bottom_min: section.settings.pad_bottom_min,
  pad_bottom_max: section.settings.pad_bottom_max,
  enable_pad_top_mobile: section.settings.enable_pad_top_mobile,
  pad_top_mobile: section.settings.pad_top_mobile,
  enable_pad_bottom_mobile: section.settings.enable_pad_bottom_mobile,
  pad_bottom_mobile: section.settings.pad_bottom_mobile,
  enable_pad_top_desktop: section.settings.enable_pad_top_desktop,
  pad_top_desktop: section.settings.pad_top_desktop,
  enable_pad_bottom_desktop: section.settings.enable_pad_bottom_desktop,
  pad_bottom_desktop: section.settings.pad_bottom_desktop
%}

{% liquid
  assign slant = section.settings.slant_percent
  assign margin_desktop = section.settings.card_width_desktop | times: slant | divided_by: 100.0 | times: -1 | round: 0
  assign margin_mobile = section.settings.card_width_mobile | times: slant | divided_by: 100.0 | times: -1 | round: 0

  if section.settings.lazy_loading
    assign loading = 'lazy'
    assign fetch_priority = 'low'
  else
    assign loading = 'eager'
    assign fetch_priority = 'high'
  endif
%}

{% style %}
  .{{ section.id }} {
    --tp-cats-slant: {{ slant }}%;
    --tp-cats-card-w-mobile: {{ section.settings.card_width_mobile }}px;
    --tp-cats-card-h-mobile: {{ section.settings.card_height_mobile }}px;
    --tp-cats-card-w-desktop: {{ section.settings.card_width_desktop }}px;
    --tp-cats-card-h-desktop: {{ section.settings.card_height_desktop }}px;
    --tp-cats-margin-mobile: {{ margin_mobile }}px;
    --tp-cats-margin-desktop: {{ margin_desktop }}px;
    --tp-e-categories-v5-accent-color: {{ section.settings.accent_color }};
  }

  {% assign bg = section.settings.background_type %}
  {% if bg == 'color' and section.settings.background_color != blank %}
    .{{ section.id }} { background: {{ section.settings.background_color }}; }
  {% elsif bg == 'gradient' and section.settings.background_gradient != blank %}
    .{{ section.id }} { background: {{ section.settings.background_gradient }}; }
  {% endif %}

  {% if section.settings.overlay_custom %}
    .{{ section.id }} {
      --tp-e-categories-v5-overlay: linear-gradient(180deg, {{ section.settings.overlay_color_from }} 55%, {{ section.settings.overlay_color_to }} 100%);
    }
  {% endif %}

  {% if section.settings.label_custom %}
    .{{ section.id }} {
      --tp-e-categories-v5-label-color: {{ section.settings.label_color }};
      --tp-e-categories-v5-label-size-mobile: {{ section.settings.label_size_mobile }}px;
      --tp-e-categories-v5-label-size-desktop: {{ section.settings.label_size_desktop }}px;
    }
  {% endif %}

  {% if section.settings.title_custom %}
    .{{ section.id }} .tp-e-categories-v5__title * {
      color: {{ section.settings.title_color }};
      font-size: {{ section.settings.title_size_mobile }}px;
      font-weight: {{ section.settings.title_weight }};
    }
    @media screen and (min-width: 768px) {
      .{{ section.id }} .tp-e-categories-v5__title * {
        font-size: {{ section.settings.title_size_desktop }}px;
      }
    }
  {% endif %}
{% endstyle %}

<tp-categories-v5
  data-navigation="{{ section.settings.navigation }}"
  data-autoplay="{{ section.settings.autoplay }}"
  data-autoplay-delay="{{ section.settings.autoplay_delay }}"
>
  <section class="tp-e-categories-v5 {{ section.id }} scroll-trigger animate--fade-in">
    <div class="tp-wrapper tp-e-categories-v5__wrapper" id="section-wrapper-{{ section.id }}">
      <div class="tp-e-categories-v5__header">
        {% if section.settings.title != blank %}
          <div class="tp-e-categories-v5__title">
            {{ section.settings.title }}
          </div>
        {% endif %}
        <div class="tp-e-categories-v5__accent" aria-hidden="true"></div>
      </div>

      {% if section.blocks.size > 0 %}
        <div class="tp-e-categories-v5__swiper swiper">
          <div class="swiper-wrapper">
            {% for block in section.blocks %}
              {% liquid
                assign img = block.settings.image_desktop
                assign img_mobile = block.settings.image_mobile | default: img
              %}
              <div class="swiper-slide tp-e-categories-v5__slide" {{ block.shopify_attributes }}>
                {% if block.settings.link != blank %}
                  <a class="tp-e-categories-v5__slide-link" href="{{ block.settings.link }}" aria-label="{{ block.settings.title | escape }}"></a>
                {% endif %}

                {% if img != blank %}
                  <div class="medium-hide small-hide">
                    {{ img | image_url: width: 800 | image_tag:
                      class: 'tp-e-categories-v5__image',
                      loading: loading,
                      fetchpriority: fetch_priority,
                      widths: '400, 600, 800',
                      sizes: '400px',
                      alt: block.settings.title
                    }}
                  </div>
                  <div class="large-up-hide">
                    {{ img_mobile | image_url: width: 600 | image_tag:
                      class: 'tp-e-categories-v5__image',
                      loading: loading,
                      fetchpriority: fetch_priority,
                      widths: '300, 450, 600',
                      sizes: '313px',
                      alt: block.settings.title
                    }}
                  </div>
                {% else %}
                  <div class="tp-e-categories-v5__placeholder"></div>
                {% endif %}

                <div class="tp-e-categories-v5__overlay" aria-hidden="true"></div>

                {% if block.settings.title != blank %}
                  <p class="tp-e-categories-v5__label">{{ block.settings.title }}</p>
                {% endif %}
              </div>
            {% endfor %}
          </div>

          {% if section.settings.navigation %}
            <div class="swiper-button-prev tp-e-categories-v5__nav-btn tp-e-categories-v5__nav-btn--prev">
              {{ 'tp-button-prev.svg' | inline_asset_content }}
            </div>
            <div class="swiper-button-next tp-e-categories-v5__nav-btn tp-e-categories-v5__nav-btn--next">
              {{ 'tp-button-next.svg' | inline_asset_content }}
            </div>
          {% endif %}
        </div>
      {% endif %}
    </div>
  </section>
</tp-categories-v5>

<script>
  (function () {
    class TpCategoriesV5 extends HTMLElement {
      connectedCallback() {
        if (!window.Swiper) return;

        const hasNavigation = this.dataset.navigation === 'true';
        const hasAutoplay = this.dataset.autoplay === 'true';
        const autoplayDelay = parseInt(this.dataset.autoplayDelay, 10) || 3000;

        const config = {
          slidesPerView: 'auto',
          spaceBetween: 0,
          loop: false,
          watchOverflow: true,
        };

        if (hasNavigation) {
          config.navigation = {
            prevEl: this.querySelector('.tp-e-categories-v5__nav-btn--prev'),
            nextEl: this.querySelector('.tp-e-categories-v5__nav-btn--next'),
          };
        }

        if (hasAutoplay) {
          config.autoplay = {
            delay: autoplayDelay,
            disableOnInteraction: false,
            pauseOnMouseEnter: true,
          };
          config.loop = true;
        }

        this._swiper = new Swiper(this.querySelector('.tp-e-categories-v5__swiper'), config);
      }

      disconnectedCallback() {
        if (this._swiper) this._swiper.destroy(true, true);
      }
    }

    if (!customElements.get('tp-categories-v5')) {
      customElements.define('tp-categories-v5', TpCategoriesV5);
    }
  })();
</script>

{% schema %}
{
  "name": "Categorias Diagonal",
  "class": "E__CATEGORIES__V5",
  "settings": [
    {
      "type": "header",
      "content": "Conteúdo"
    },
    {
      "type": "richtext",
      "id": "title",
      "label": "Título",
      "default": "<p>Explore por categoria</p>"
