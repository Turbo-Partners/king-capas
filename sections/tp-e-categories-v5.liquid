    {
      "type": "header",
      "content": "Slider"
    },
    {
      "type": "range",
      "id": "slant_percent",
      "label": "Inclinação dos cards (%)",
      "min": 0,
      "max": 25,
      "step": 1,
      "default": 14
    },
    {
      "type": "range",
      "id": "card_width_desktop",
      "label": "Largura do card — Desktop (px)",
      "min": 240,
      "max": 520,
      "step": 4,
      "default": 400
    },
    {
      "type": "range",
      "id": "card_height_desktop",
      "label": "Altura do card — Desktop (px)",
      "min": 280,
      "max": 640,
      "step": 4,
      "default": 460
    },
    {
      "type": "range",
      "id": "card_width_mobile",
      "label": "Largura do card — Mobile (px)",
      "min": 180,
      "max": 400,
      "step": 4,
      "default": 313
    },
    {
      "type": "range",
      "id": "card_height_mobile",
      "label": "Altura do card — Mobile (px)",
      "min": 220,
      "max": 480,
      "step": 4,
      "default": 360
    },
    {
      "type": "checkbox",
      "id": "lazy_loading",
      "label": "Lazy loading nas imagens",
      "default": true
    },
    {
      "type": "header",
      "content": "Navegação e Autoplay"
    },
    {
      "type": "checkbox",
      "id": "navigation",
      "label": "Exibir setas de navegação",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Ativar autoplay",
      "default": false
