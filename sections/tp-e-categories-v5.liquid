    {
      "type": "checkbox",
      "id": "title_custom",
      "label": "Personalizar",
      "default": false
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Cor",
      "visible_if": "{{ section.settings.title_custom }}"
    },
    {
      "type": "range",
