{{ 'tp-e-collection-v1.css' | asset_url | stylesheet_tag }}

{% render 'tp-section-padding',
  pad_top_min: section.settings.pad_top_min,
  pad_top_max: section.settings.pad_top_max,
  pad_bottom_min: section.settings.pad_bottom_min,
  pad_bottom_max: section.settings.pad_bottom_max,
  enable_pad_top_mobile: section.settings.enable_pad_top_mobile,
  pad_top_mobile: section.settings.pad_top_mobile,
  enable_pad_bottom_mobile: section.settings.enable_pad_bottom_mobile,
  pad_bottom_mobile: section.settings.pad_bottom_mobile,
  enable_pad_top_desktop: section.settings.enable_pad_top_desktop,
  pad_top_desktop: section.settings.pad_top_desktop,
  enable_pad_bottom_desktop: section.settings.enable_pad_bottom_desktop,
  pad_bottom_desktop: section.settings.pad_bottom_desktop
%}

{% style %}
{% if section.settings.title_custom %}
  .{{ section.id }} .tp-e-collection-v1__title {
    color: {{ section.settings.title_color }};
    font-size: {{ section.settings.title_size_mobile }}px;
    font-weight: {{ section.settings.title_weight }};
  }

  @media screen and (min-width: 768px) {
    .{{ section.id }} .tp-e-collection-v1__title {
      font-size: {{ section.settings.title_size_desktop }}px;
    }
  }
{% endif %}

{% if section.settings.subtitle_custom %}
  .{{ section.id }} .tp-e-collection-v1__subtitle {
    color: {{ section.settings.subtitle_color }};
    font-size: {{ section.settings.subtitle_size_mobile }}px;
    font-weight: {{ section.settings.subtitle_weight }};
  }

  @media screen and (min-width: 768px) {
    .{{ section.id }} .tp-e-collection-v1__subtitle {
      font-size: {{ section.settings.subtitle_size_desktop }}px;
    }
  }
{% endif %}
{% endstyle %}

<section class="tp-e-collection-v1 {{ section.id }} scroll-trigger animate--fade-in">
  <div class="tp-wrapper tp-e-collection-v1__wrapper">
    <tp-collection-gallery class="tp-e-collection-v1__gallery" data-per-page="2">
      <div class="tp-e-collection-v1__main-image">
        {% if section.settings.main_image != blank %}
          {{ section.settings.main_image | image_url: width: 1500 | image_tag:
            class: 'tp-e-collection-v1__main-img',
            loading: 'lazy',
            sizes: '(min-width: 768px) 50vw, 100vw',
            widths: '375, 750, 1100, 1500'
          }}
        {% else %}
          <div class="tp-e-collection-v1__main-placeholder">
            {{ 'image' | placeholder_svg_tag }}
          </div>
        {% endif %}
      </div>

      <div class="tp-e-collection-v1__content">
        <div class="tp-e-collection-v1__text">
          {% if section.settings.title != blank %}
            <h2 class="tp-e-collection-v1__title">{{ section.settings.title | escape }}</h2>
          {% endif %}

          {% if section.settings.subtitle != blank %}
            <p class="tp-e-collection-v1__subtitle">{{ section.settings.subtitle | escape }}</p>
          {% endif %}
        </div>

        <div class="tp-e-collection-v1__carousel-wrapper">
          <div class="tp-e-collection-v1__carousel">
            <div class="tp-e-collection-v1__slides" data-slides>
              {% for block in section.blocks %}
                <div class="tp-e-collection-v1__slide" {{ block.shopify_attributes }}>
                  {% if block.settings.image != blank %}
                    {{ block.settings.image | image_url: width: 800 | image_tag:
                      class: 'tp-e-collection-v1__slide-img',
                      loading: 'lazy',
                      sizes: '(min-width: 768px) 25vw, 50vw',
                      widths: '200, 400, 600, 800'
                    }}
                  {% else %}
                    <div class="tp-e-collection-v1__slide-placeholder">
                      {{ 'image' | placeholder_svg_tag }}
                    </div>
                  {% endif %}
                </div>
              {% endfor %}
            </div>
          </div>

          {% if section.blocks.size > 2 %}
            <div class="tp-e-collection-v1__nav">
              <button class="tp-e-collection-v1__nav-btn tp-e-collection-v1__nav-btn--prev" data-prev aria-label="Anterior" disabled>
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="7 4 13 10 7 16"/></svg>
              </button>
              <span class="tp-e-collection-v1__nav-counter" data-counter>1/{{ section.blocks.size | divided_by: 2 | ceil }}</span>
              <button class="tp-e-collection-v1__nav-btn tp-e-collection-v1__nav-btn--next" data-next aria-label="Próximo">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="7 4 13 10 7 16"/></svg>
              </button>
            </div>
          {% endif %}
        </div>
      </div>
    </tp-collection-gallery>
  </div>
</section>

<script defer>
  if (!customElements.get('tp-collection-gallery')) {
    class TpCollectionGallery extends HTMLElement {
      connectedCallback() {
        this.perPage = parseInt(this.dataset.perPage) || 2;
        this.slides = this.querySelector('[data-slides]');
        this.carousel = this.querySelector('.tp-e-collection-v1__carousel');
        this.prevBtn = this.querySelector('[data-prev]');
        this.nextBtn = this.querySelector('[data-next]');
        this.counter = this.querySelector('[data-counter]');
        this.currentPage = 0;
        this.totalSlides = this.slides ? this.slides.children.length : 0;
        this.totalPages = Math.ceil(this.totalSlides / this.perPage);
        this.isNavScrolling = false;

        if (this.prevBtn) this.prevBtn.addEventListener('click', () => this.go(-1));
        if (this.nextBtn) this.nextBtn.addEventListener('click', () => this.go(1));

        if (this.carousel) {
          var self = this;
          var scrollTimer;
          this.carousel.addEventListener('scroll', function() {
            if (self.isNavScrolling) return;
            clearTimeout(scrollTimer);
            scrollTimer = setTimeout(function() { self.onScroll(); }, 150);
          }, { passive: true });
        }
      }

      getSlideOffset(slide) {
        var slideRect = slide.getBoundingClientRect();
        var carouselRect = this.carousel.getBoundingClientRect();
        return slideRect.left - carouselRect.left + this.carousel.scrollLeft;
      }

      getPageWidth() {
        var s = this.slides.children;
        if (s.length < 2) return this.carousel.clientWidth;
        var slideWidth = s[0].offsetWidth;
        var gap = s[1].getBoundingClientRect().left - s[0].getBoundingClientRect().right;
        return this.perPage * slideWidth + (this.perPage - 1) * gap;
      }

      onScroll() {
        if (!this.carousel || !this.slides.children.length) return;
        var pageWidth = this.getPageWidth();
        var newPage = Math.round(this.carousel.scrollLeft / pageWidth);
        newPage = Math.max(0, Math.min(newPage, this.totalPages - 1));

        if (newPage !== this.currentPage) {
          this.currentPage = newPage;
          this.updateNav();
        }
      }

      go(dir) {
        this.currentPage = Math.max(0, Math.min(this.currentPage + dir, this.totalPages - 1));
        var targetSlide = this.slides.children[this.currentPage * this.perPage];
        if (targetSlide && this.carousel) {
          var self = this;
          this.isNavScrolling = true;
          var offset = this.getSlideOffset(targetSlide);
          this.carousel.scrollTo({ left: offset, behavior: 'smooth' });
          setTimeout(function() { self.isNavScrolling = false; }, 500);
        }
        this.updateNav();
      }

      updateNav() {
        if (this.counter) this.counter.textContent = (this.currentPage + 1) + '/' + this.totalPages;
        if (this.prevBtn) this.prevBtn.disabled = this.currentPage === 0;
        if (this.nextBtn) this.nextBtn.disabled = this.currentPage >= this.totalPages - 1;
      }
    }
    customElements.define('tp-collection-gallery', TpCollectionGallery);
  }
</script>

{% schema %}
{
  "name": "Galeria de Coleção",
  "class": "E__COLLECTION__V1",
  "settings": [
