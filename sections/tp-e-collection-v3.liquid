{{ 'tp-e-collection-v3.css' | asset_url | stylesheet_tag }}

{% render 'tp-section-padding',
  pad_top_min: section.settings.pad_top_min,
  pad_top_max: section.settings.pad_top_max,
  pad_bottom_min: section.settings.pad_bottom_min,
  pad_bottom_max: section.settings.pad_bottom_max,
  enable_pad_top_mobile: section.settings.enable_pad_top_mobile,
  pad_top_mobile: section.settings.pad_top_mobile,
  enable_pad_bottom_mobile: section.settings.enable_pad_bottom_mobile,
  pad_bottom_mobile: section.settings.pad_bottom_mobile,
  enable_pad_top_desktop: section.settings.enable_pad_top_desktop,
  pad_top_desktop: section.settings.pad_top_desktop,
  enable_pad_bottom_desktop: section.settings.enable_pad_bottom_desktop,
  pad_bottom_desktop: section.settings.pad_bottom_desktop
%}

{% style %}
  .{{ section.id }} .tp-e-collection-v3__grid {
    --cols-desktop: {{ section.settings.cols_desktop }};
    --cols-mobile: {{ section.settings.cols_mobile }};
    --grid-gap: {{ section.settings.gap }}px;
  }

  {% for block in section.blocks %}
    .{{ section.id }} .tp-e-collection-v3__item--{{ block.id }} {
      --card-radius: {% if block.settings.card_radius == 'none' %}0{% else %}var(--tp-radius-{{ block.settings.card_radius }}){% endif %};
    }

    {% if block.settings.custom_position %}
      @media screen and (min-width: 750px) {
        .{{ section.id }} .tp-e-collection-v3__item--{{ block.id }} {
          grid-column: {{ block.settings.col_start }} / {{ block.settings.col_end }};
          grid-row: {{ block.settings.row_start }} / {{ block.settings.row_end }};
        }
      }
    {% endif %}
  {% endfor %}
{% endstyle %}

<section class="tp-e-collection-v3 {{ section.id }} scroll-trigger animate--fade-in">
  <div class="tp-wrapper">
    <div class="tp-e-collection-v3__grid">

      {% for block in section.blocks %}
        <a
          class="tp-e-collection-v3__item tp-e-collection-v3__item--{{ block.id }}"
          href="{{ block.settings.url | default: '#' }}"
          {% if block.settings.url == blank %}aria-hidden="true" tabindex="-1"{% endif %}
          {{ block.shopify_attributes }}
        >
          {% if block.settings.image != blank %}
            {{ block.settings.image | image_url: width: 1200 | image_tag:
              loading: 'lazy',
              widths: '375, 750, 1100, 1200',
              sizes: '(min-width: 750px) 50vw, 100vw',
              alt: block.settings.image.alt | default: ''
            }}
          {% else %}
            {{ 'image' | placeholder_svg_tag: 'tp-e-collection-v3__placeholder' }}
          {% endif %}
        </a>
      {% endfor %}

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Grid de Coleção V3",
  "class": "E__COLLECTION__V3",
  "settings": [
    {
      "type": "header",
      "content": "Grid"
    },
    {
      "type": "range",
      "id": "cols_desktop",
      "label": "Colunas (desktop)",
      "min": 1,
      "max": 10,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "cols_mobile",
      "label": "Colunas (mobile)",
      "min": 1,
      "max": 10,
      "step": 1,
      "default": 1
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Espaçamento entre imagens (px)",
      "min": 0,
      "max": 64,
      "step": 4,
      "default": 16,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Espaçamento"
    },
    {
      "type": "range",
      "id": "pad_top_min",
      "label": "Padding superior mínimo (px)",
      "min": 0,
      "max": 200,
      "step": 4,
      "default": 40
    },
    {
      "type": "range",
      "id": "pad_top_max",
      "label": "Padding superior máximo (px)",
      "min": 0,
      "max": 200,
      "step": 4,
      "default": 80
    },
    {
      "type": "range",
      "id": "pad_bottom_min",
      "label": "Padding inferior mínimo (px)",
      "min": 0,
      "max": 200,
      "step": 4,
      "default": 40
    },
    {
      "type": "range",
      "id": "pad_bottom_max",
      "label": "Padding inferior máximo (px)",
      "min": 0,
      "max": 200,
      "step": 4,
      "default": 80
    },
    {
      "type": "header",
      "content": "Sobrescrita de espaçamento (opcional)"
    },
    {
      "type": "checkbox",
      "id": "enable_pad_top_mobile",
      "label": "Personalizar padding superior no mobile",
      "default": false
    },
    {
      "type": "range",
      "id": "pad_top_mobile",
      "label": "Padding superior mobile (px)",
      "min": 0,
      "max": 200,
      "step": 4,
      "default": 0,
      "visible_if": "{{ section.settings.enable_pad_top_mobile }}"
    },
    {
      "type": "checkbox",
      "id": "enable_pad_bottom_mobile",
      "label": "Personalizar padding inferior no mobile",
      "default": false
    },
    {
      "type": "range",
      "id": "pad_bottom_mobile",
      "label": "Padding inferior mobile (px)",
      "min": 0,
      "max": 200,
      "step": 4,
      "default": 0,
      "visible_if": "{{ section.settings.enable_pad_bottom_mobile }}"
    },
    {
      "type": "checkbox",
      "id": "enable_pad_top_desktop",
      "label": "Personalizar padding superior no desktop",
      "default": false
    },
    {
      "type": "range",
      "id": "pad_top_desktop",
      "label": "Padding superior desktop (px)",
      "min": 0,
      "max": 200,
      "step": 4,
      "default": 0,
      "visible_if": "{{ section.settings.enable_pad_top_desktop }}"
    },
    {
      "type": "checkbox",
      "id": "enable_pad_bottom_desktop",
      "label": "Personalizar padding inferior no desktop",
      "default": false
    },
    {
      "type": "range",
      "id": "pad_bottom_desktop",
      "label": "Padding inferior desktop (px)",
      "min": 0,
      "max": 200,
      "step": 4,
      "default": 0,
      "visible_if": "{{ section.settings.enable_pad_bottom_desktop }}"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Imagem",
      "settings": [
        {
          "type": "header",
          "content": "Conteúdo"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagem"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link"
        },
        {
          "type": "header",
          "content": "Posição no Grid (desktop)"
        },
        {
          "type": "checkbox",
          "id": "custom_position",
          "label": "Posicionamento personalizado",
          "default": false,
          "info": "Ative para definir linha e coluna exatas no grid."
        },
        {
          "type": "range",
          "id": "col_start",
          "label": "Coluna — início",
          "min": 1,
          "max": 10,
          "step": 1,
          "default": 1,
          "visible_if": "{{ block.settings.custom_position }}"
        },
        {
          "type": "range",
          "id": "col_end",
          "label": "Coluna — fim",
          "min": 2,
          "max": 11,
          "step": 1,
          "default": 2,
          "info": "Ex: início 1 + fim 3 = ocupa 2 colunas.",
          "visible_if": "{{ block.settings.custom_position }}"
        },
        {
          "type": "range",
          "id": "row_start",
          "label": "Linha — início",
          "min": 1,
          "max": 10,
          "step": 1,
          "default": 1,
          "visible_if": "{{ block.settings.custom_position }}"
        },
        {
          "type": "range",
          "id": "row_end",
          "label": "Linha — fim",
          "min": 2,
          "max": 11,
          "step": 1,
          "default": 2,
          "info": "Ex: início 1 + fim 3 = ocupa 2 linhas.",
          "visible_if": "{{ block.settings.custom_position }}"
        },
        {
          "type": "header",
          "content": "Aparência"
        },
        {
          "type": "select",
          "id": "card_radius",
          "label": "Arredondamento",
          "default": "lg",
          "options": [
            { "label": "Nenhum", "value": "none" },
            { "label": "Pequeno", "value": "sm" },
            { "label": "Médio", "value": "md" },
            { "label": "Grande", "value": "lg" },
            { "label": "Extra Grande", "value": "xl" },
            { "label": "Completo", "value": "full" }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Grid de Coleção V3",
      "category": "Coleção",
      "settings": {
        "cols_desktop": 2,
        "cols_mobile": 1,
        "gap": 16
      },
      "blocks": [
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
