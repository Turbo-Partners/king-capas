{{ 'tp-feat-prod-slider.css' | asset_url | stylesheet_tag }}

{% render 'tp-section-padding',
  pad_top_min: section.settings.pad_top_min,
  pad_top_max: section.settings.pad_top_max,
  pad_bottom_min: section.settings.pad_bottom_min,
  pad_bottom_max: section.settings.pad_bottom_max,
  enable_pad_top_mobile: section.settings.enable_pad_top_mobile,
  pad_top_mobile: section.settings.pad_top_mobile,
  enable_pad_bottom_mobile: section.settings.enable_pad_bottom_mobile,
  pad_bottom_mobile: section.settings.pad_bottom_mobile,
  enable_pad_top_desktop: section.settings.enable_pad_top_desktop,
  pad_top_desktop: section.settings.pad_top_desktop,
  enable_pad_bottom_desktop: section.settings.enable_pad_bottom_desktop,
  pad_bottom_desktop: section.settings.pad_bottom_desktop
%}

{% liquid
  assign background_type = section.settings.background_type
  assign image_position_desktop = section.settings.image_position_desktop
  assign image_position_mobile = section.settings.image_position_mobile

  if section.settings.lazy_loading
    assign loading = 'lazy'
    assign fetch_priority = 'low'
  else
    assign loading = 'eager'
    assign fetch_priority = 'high'
  endif
%}

{% style %}
  .{{ section.id }} {
    background-size: cover;
    background-repeat: no-repeat;
    background-position: center;
  }

  {% if background_type == "image" and section.settings.background_image_mobile != blank %}
    .{{ section.id }} { background-image: url('{{ section.settings.background_image_mobile | image_url }}'); }
    {% if section.settings.background_image_desktop != blank %}
      @media screen and (min-width: 1024px) {
        .{{ section.id }} { background-image: url('{{ section.settings.background_image_desktop | image_url }}'); }
      }
    {% endif %}
  {% elsif background_type == "color" and section.settings.background_color != blank %}
    .{{ section.id }} { background: {{ section.settings.background_color }}; }
  {% elsif background_type == "gradient" and section.settings.background_gradient != blank %}
    .{{ section.id }} { background: {{ section.settings.background_gradient }}; }
  {% endif %}

  .{{ section.id }} .tp-feat-prod-slider__swiper {
    height: {{ section.settings.swiper_height }}px;
  }


  {% if section.settings.title_custom %}
    .{{ section.id }} .tp-feat-prod-slider__title * {
      color: {{ section.settings.title_color }};
      font-weight: {{ section.settings.title_font_weight }};
      font-size: {{ section.settings.title_font_size_desktop }}px;
      text-align: {{ section.settings.title_align_desktop }};
    }
    @media (max-width: 767px) {
      .{{ section.id }} .tp-feat-prod-slider__title * {
        font-size: {{ section.settings.title_font_size_mobile }}px;
        text-align: {{ section.settings.title_align_mobile }};
      }
    }
  {% endif %}

  {% if section.settings.pagination %}
    .{{ section.id }} .tp-feat-prod-slider__swiper .swiper-pagination-bullet {
      width: {{ section.settings.pagination_size }}px;
      height: {{ section.settings.pagination_size }}px;
      background-color: {{ section.settings.pagination_color }};
      opacity: 1;
      margin-inline:auto
    }
    {% if section.settings.pagination_border %}
      .{{ section.id }} .tp-feat-prod-slider__swiper .swiper-pagination-bullet {
        border: {{ section.settings.pagination_border_width }}px solid {{ section.settings.pagination_border_color }};
      }
    {% endif %}

    .{{ section.id }} .tp-feat-prod-slider__swiper .swiper-pagination-bullet-active {
      width: {{ section.settings.pagination_size_active }}px;
      height: {{ section.settings.pagination_size_active }}px;
      background-color: {{ section.settings.pagination_color_active }};
    }
    {% if section.settings.pagination_border_active %}
      .{{ section.id }} .tp-feat-prod-slider__swiper .swiper-pagination-bullet-active {
        border: {{ section.settings.pagination_border_width_active }}px solid {{ section.settings.pagination_border_color_active }};
      }
    {% endif %}
  {% endif %}
{% endstyle %}

<tp-feat-prod-slider
  data-pagination="{{ section.settings.pagination }}"
  data-navigation="{{ section.settings.navigation }}"
>
  <section class="tp-feat-prod-slider {{ section.id }}">
    <div class="tp-feat-prod-slider__wrapper">

      {% if section.settings.show_title and section.settings.title != blank %}
        <div class="tp-feat-prod-slider__header">
          <div class="tp-feat-prod-slider__title">
            {{ section.settings.title }}
          </div>
        </div>
      {% endif %}

      {% if section.blocks.size > 0 %}
        <div class="tp-feat-prod-slider__swiper swiper">
          <div class="swiper-wrapper">
            {% for block in section.blocks %}
              <div
                class="
                  swiper-slide
                  tp-feat-prod-slider__slide
                  tp-feat-prod-slider__slide--image-{{ image_position_desktop }}
                  tp-feat-prod-slider__slide--mobile-{{ image_position_mobile }}
                "
                {{ block.shopify_attributes }}
              >
                <div class="tp-feat-prod-slider__media">
                  {% if block.settings.image_desktop != blank %}
                    <div class="tp-feat-prod-slider__media-desktop medium-hide small-hide">
                      {{- block.settings.image_desktop | image_url: width: 1200 | image_tag:
                        class: 'tp-feat-prod-slider__img',
                        loading: loading,
                        fetchpriority: fetch_priority,
                        widths: '375, 550, 750, 1100, 1500',
                        sizes: '(min-width: 768px) 50vw, 100vw'
                      -}}
                    </div>
                  {% else %}
                    <div class="tp-feat-prod-slider__media-desktop tp-feat-prod-slider__media-desktop--preview medium-hide small-hide">
                      <img
                        src="{{ 'preview-image-720-600.png' | asset_url }}"
                        alt=""
                        aria-hidden="true"
                        class="tp-feat-prod-slider__img tp-feat-prod-slider__img--preview"
                        width="720"
                        height="600"
                        loading="{{ loading }}"
                        fetchpriority="{{ fetch_priority }}"
                      >
                    </div>
                  {% endif %}

                  {% if block.settings.image_mobile != blank %}
                    <div class="tp-feat-prod-slider__media-mobile large-up-hide">
                      {{- block.settings.image_mobile | image_url: width: 750 | image_tag:
                        class: 'tp-feat-prod-slider__img',
                        loading: loading,
                        fetchpriority: fetch_priority,
                        widths: '375, 550, 750',
                        sizes: '100vw'
                      -}}
                    </div>
                  {% elsif block.settings.image_desktop != blank %}
                    <div class="tp-feat-prod-slider__media-mobile large-up-hide">
                      {{- block.settings.image_desktop | image_url: width: 750 | image_tag:
                        class: 'tp-feat-prod-slider__img',
                        loading: loading,
                        fetchpriority: fetch_priority,
                        widths: '375, 550, 750',
                        sizes: '100vw'
                      -}}
                    </div>
                  {% else %}
                    <div class="tp-feat-prod-slider__media-mobile tp-feat-prod-slider__media-mobile--preview large-up-hide">
                      <img
                        src="{{ 'preview-image-720-600.png' | asset_url }}"
                        alt=""
                        aria-hidden="true"
                        class="tp-feat-prod-slider__img tp-feat-prod-slider__img--preview"
                        width="480"
                        height="400"
                        loading="{{ loading }}"
                        fetchpriority="{{ fetch_priority }}"
                      >
                    </div>
                  {% endif %}
                </div>

                <div class="tp-feat-prod-slider__product">
                  {% render 'tp-product-card',
                    tp_product: block.settings.product,
                    show_price: true,
                    show_button: true,
                    add_to_cart: true,
                    show_badges: true,
                    change_image_hover: true,
                    show_installments: true
                  %}
                </div>
              </div>
            {% endfor %}
          </div>

          {% if section.settings.navigation %}
            <div class="swiper-button-prev tp-feat-prod-slider__nav-btn tp-feat-prod-slider__nav-btn--prev">
              {% if section.settings.navigation_prev_image != blank %}
                <img
                  src="{{ section.settings.navigation_prev_image | image_url }}"
                  alt=""
                  aria-hidden="true"
                  width="{{ section.settings.navigation_prev_image.width }}"
                  height="{{ section.settings.navigation_prev_image.height }}"
                >
              {% else %}
                {{ 'tp-button-prev.svg' | inline_asset_content }}
              {% endif %}
            </div>
            <div class="swiper-button-next tp-feat-prod-slider__nav-btn tp-feat-prod-slider__nav-btn--next">
              {% if section.settings.navigation_next_image != blank %}
                <img
                  src="{{ section.settings.navigation_next_image | image_url }}"
                  alt=""
                  aria-hidden="true"
                  width="{{ section.settings.navigation_next_image.width }}"
                  height="{{ section.settings.navigation_next_image.height }}"
                >
              {% else %}
                {{ 'tp-button-next.svg' | inline_asset_content }}
              {% endif %}
            </div>
          {% endif %}

          {% if section.settings.pagination %}
            <div class="swiper-pagination tp-feat-prod-slider__pagination"></div>
          {% endif %}
        </div>
      {% endif %}

    </div>
  </section>
</tp-feat-prod-slider>

<script>
  (function () {
    class TpFeatProdSlider extends HTMLElement {
      connectedCallback() {
        if (!window.Swiper) return;

        this._hasPagination = this.dataset.pagination === 'true';
        this._hasNavigation = this.dataset.navigation === 'true';
        this._swiper = null;

        this._mq = window.matchMedia('(max-width: 767px)');
        this._mqListener = () => this._initSwiper();
        this._mq.addEventListener('change', this._mqListener);

        this._initSwiper();
      }

      disconnectedCallback() {
        if (this._mq) this._mq.removeEventListener('change', this._mqListener);
        if (this._swiper) this._swiper.destroy(true, true);
      }

      _initSwiper() {
        if (this._swiper) {
          this._swiper.destroy(true, true);
          this._swiper = null;
        }

        const isMobile = this._mq.matches;

        const config = {
          direction: isMobile ? 'horizontal' : 'vertical',
          slidesPerView: 1,
          spaceBetween: 10,
          loop: false,
        };

        if (this._hasPagination) {
          config.pagination = {
            el: this.querySelector('.tp-feat-prod-slider__pagination'),
            clickable: true,
          };
        }

        if (this._hasNavigation) {
          config.navigation = {
            prevEl: this.querySelector('.tp-feat-prod-slider__nav-btn--prev'),
            nextEl: this.querySelector('.tp-feat-prod-slider__nav-btn--next'),
          };
        }

        this._swiper = new Swiper(this.querySelector('.tp-feat-prod-slider__swiper'), config);
      }
    }

    if (!customElements.get('tp-feat-prod-slider')) {
      customElements.define('tp-feat-prod-slider', TpFeatProdSlider);
    }
  })();
</script>

