{{ 'tp-feat-col.css' | asset_url | stylesheet_tag }}

{% render 'tp-section-padding',
  pad_top_min: section.settings.pad_top_min,
  pad_top_max: section.settings.pad_top_max,
  pad_bottom_min: section.settings.pad_bottom_min,
  pad_bottom_max: section.settings.pad_bottom_max,
  enable_pad_top_mobile: section.settings.enable_pad_top_mobile,
  pad_top_mobile: section.settings.pad_top_mobile,
  enable_pad_bottom_mobile: section.settings.enable_pad_bottom_mobile,
  pad_bottom_mobile: section.settings.pad_bottom_mobile,
  enable_pad_top_desktop: section.settings.enable_pad_top_desktop,
  pad_top_desktop: section.settings.pad_top_desktop,
  enable_pad_bottom_desktop: section.settings.enable_pad_bottom_desktop,
  pad_bottom_desktop: section.settings.pad_bottom_desktop
%}

{% liquid
  assign background_type = section.settings.background_type
  assign autoplay = section.settings.autoplay
  assign autoplay_time = section.settings.autoplay_time | times: 1000
  assign pagination = section.settings.pagination
  assign navigation = section.settings.navigation
  assign mobile_columns = section.settings.mobile_columns
  assign title_alignment = section.settings.title_alignment
  if title_alignment == 'left'
    assign title_align_items = 'flex-start'
  elsif title_alignment == 'right'
    assign title_align_items = 'flex-end'
  else
    assign title_align_items = 'center'
  endif
  assign button_below_mobile = section.settings.button_below_mobile
%}

{% style %}
  .{{ section.id }} {
    background-size: cover;
    background-repeat: no-repeat;
    background-position: center;

    .tp-featured-collection__heading {
      padding-bottom:3rem;
    }

    {% if background_type == "image" and section.settings.background_image_mobile != blank %}
      background-image: url('{{ section.settings.background_image_mobile | image_url }}');

      {% if section.settings.background_image_desktop != blank %}
        @media screen and (min-width: 1024px) {
          background-image: url('{{ section.settings.background_image_desktop | image_url }}');
        }
      {% endif %}
    {% elsif background_type == "color" and section.settings.background_color != blank %}
      background: {{ section.settings.background_color }};
    {% elsif background_type == "gradient" and section.settings.background_gradient != blank %}
      background: {{ section.settings.background_gradient }};
    {% endif %}

    {% if pagination %}
      .swiper-pagination {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;

        @media screen and (min-width: 768px) {
          display: none;
        }

        .swiper-pagination-bullet {
          margin: 0;
          background: {{ section.settings.pagination_color }};
          opacity: 1;
        }

        .swiper-pagination-bullet-active {
          width: 14px;
          height: 14px;
          {% if section.settings.pagination_custom_bullet %}
            background: transparent;
            border: {{ section.settings.pagination_bullet_border_width }}px solid {{ section.settings.pagination_bullet_border_color }};
          {% else %}
            background: {{ section.settings.pagination_color_active }};
          {% endif %}
        }
      }
    {% endif %}

    {% if navigation %}
      .swiper-button-prev, .swiper-button-next {
        width: clamp(2.4rem, 2.1029rem + 0.7619vw, 3.2rem);
        display: none;

        @media screen and (min-width: 768px) {
          display: flex;
        }

        &.with-image svg {
          display: none;
        }

        svg {
          fill: none;
        }

        &::after {
          content: '';
          color: transparent;
        }
      }

      .swiper-button-prev {
        left: 16px;

        @media screen and (min-width: 768px) {
          left: 32px;
        }

        @media screen and (min-width: 1024px) {
          left: 40px;
        }
      }

      .swiper-button-next {
        right: 16px;

        @media screen and (min-width: 768px) {
          right: 32px;
        }

        @media screen and (min-width: 1024px) {
          right: 40px;
        }
      }
    {% endif %}

    {% if section.settings.title_bar %}
      .tp-featured-collection__bar {
        display: block;
        width: 64px;
        height: 2px;
        background: {{ section.settings.title_bar_color }};
      }
    {% endif %}

    .tp-featured-collection__heading {
      align-items: {{ title_align_items }};
      text-align: {{ title_alignment }};
    }
  }
{% endstyle %}

<section class="tp-featured-collection {{ section.id }}">
  <div class="tp-wrapper--full-width" id="section-wrapper-{{ section.id }}">
    {% if section.settings.title != blank %}
      <div class="tp-title-wrapper tp-wrapper" style="padding-block: 0;">
        <div class="tp-featured-collection__heading">
          {% if section.settings.title_bar %}
            <span class="tp-featured-collection__bar" aria-hidden="true"></span>
          {% endif %}
          <h2>{{ section.settings.title }}</h2>
        </div>
        {% if section.settings.button_text != blank and section.settings.button_url != blank %}
          <a
            class="tp-button {% if button_below_mobile %}tp-button--desktop{% endif %}"
            href="{{ section.settings.button_url }}"
          >
            {{ section.settings.button_text }}
          </a>
        {% endif %}
      </div>
    {% endif %}

    <tp-related-products
      data-url="{{ routes.product_recommendations_url }}?limit={{ section.settings.products_to_show }}"
      data-section-id="{{ section.id }}"
      data-product-id="{{ product.id }}"
      data-mobile-columns="{{ mobile_columns }}"
      data-autoplay="{{ autoplay }}"
      data-autoplay-time="{{ autoplay_time }}"
      data-pagination="{{ pagination }}"
      data-navigation="{{ navigation }}"
    >
      {% if recommendations.performed and recommendations.products_count > 0 %}
        <div class="swiper">
          <div class="swiper-wrapper">
            {% for recommendation in recommendations.products %}
              <div class="swiper-slide">
                {% render 'tp-product-card',
                  tp_product: recommendation,
                  show_price: true,
                  show_button: true,
                  add_to_cart: true,
                  show_badges: true,
                  change_image_hover: true,
                  show_installments: true
                %}
              </div>
            {% endfor %}
          </div>
          {% if navigation %}
            <div class="swiper-button-prev {% if section.settings.navigation_prev_image != blank %}with-image{% endif %}">
              {% if section.settings.navigation_prev_image != blank %}
                <img src="{{ section.settings.navigation_prev_image | image_url }}" alt="">
              {% else %}
                {{ 'tp-button-prev.svg' | inline_asset_content }}
              {% endif %}
            </div>
            <div class="swiper-button-next {% if section.settings.navigation_next_image != blank %}with-image{% endif %}">
              {% if section.settings.navigation_next_image != blank %}
                <img src="{{ section.settings.navigation_next_image | image_url }}" alt="">
              {% else %}
                {{ 'tp-button-next.svg' | inline_asset_content }}
              {% endif %}
            </div>
          {% endif %}
        </div>
        {% if pagination %}
          <div class="swiper-pagination"></div>
        {% endif %}
      {% endif %}
    </tp-related-products>

    {% if button_below_mobile %}
      <a class="tp-button tp-button--mobile" href="{{ section.settings.button_url }}">
        {{ section.settings.button_text }}
      </a>
    {% endif %}
  </div>
</section>

<script>
  if (!customElements.get('tp-related-products')) {
    class TpRelatedProducts extends HTMLElement {
      connectedCallback() {
        const productId = this.dataset.productId;
        if (!productId) return;

        const url = `${this.dataset.url}&section_id=${this.dataset.sectionId}&product_id=${productId}`;

        fetch(url)
          .then((r) => r.text())
          .then((text) => {
            const doc = new DOMParser().parseFromString(text, 'text/html');
            const source = doc.querySelector('tp-related-products');
            if (!source) return;

            const swiperWrapper = source.querySelector('.swiper-wrapper');
            if (!swiperWrapper || swiperWrapper.children.length === 0) return;

            this.innerHTML = source.innerHTML;
            this.initSwiper();
          });
      }

      initSwiper() {
        const swiperEl = this.querySelector('.swiper');
        if (!swiperEl) return;

        const mobileColumns = this.dataset.mobileColumns;
        const autoplay = this.dataset.autoplay === 'true';
        const autoplayTime = parseInt(this.dataset.autoplayTime) || 3000;
        const pagination = this.dataset.pagination === 'true';
        const navigation = this.dataset.navigation === 'true';

        const gridRows2 = mobileColumns === '2' ? { rows: 2, fill: 'row' } : undefined;
        const gridRows1 = mobileColumns === '2' ? { rows: 1 } : undefined;

        const config = {
          slidesPerView: mobileColumns === '2' ? 2 : 1.2,
          spaceBetween: 12,
          slidesOffsetBefore: 16,
          slidesOffsetAfter: 16,
          ...(gridRows2 ? { grid: gridRows2 } : {}),
          breakpoints: {
            728: { slidesPerView: 2.2, spaceBetween: 16, slidesOffsetBefore: 32, ...(gridRows1 ? { grid: gridRows1 } : {}) },
            1024: { slidesPerView: 4, spaceBetween: 16, slidesOffsetBefore: 40, ...(gridRows1 ? { grid: gridRows1 } : {}) },
            1280: { slidesPerView: 4.2, spaceBetween: 16, slidesOffsetBefore: 40, ...(gridRows1 ? { grid: gridRows1 } : {}) },
          },
        };

        if (autoplay) {
          config.autoplay = { delay: autoplayTime };
        }

        if (pagination) {
          config.pagination = { el: this.querySelector('.swiper-pagination'), clickable: true };
        }

        if (navigation) {
          config.navigation = {
            prevEl: this.querySelector('.swiper-button-prev'),
            nextEl: this.querySelector('.swiper-button-next'),
          };
        }

        new Swiper(swiperEl, config);
      }
    }

    customElements.define('tp-related-products', TpRelatedProducts);
  }
</script>

{% schema %}
{
  "name": "Produtos Relacionados",
  "class": "E__RELATED_PRODUCTS__V1",
  "settings": [
    {
      "type": "header",
