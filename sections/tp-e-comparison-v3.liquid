      "max": 200,
      "step": 4,
      "default": 0,
      "visible_if": "{{ section.settings.enable_pad_bottom_mobile }}"
    },
    {
      "type": "checkbox",
      "id": "enable_pad_top_desktop",
      "label": "Personalizar padding TOP desktop",
      "default": false
    },
    {
      "type": "range",
      "id": "pad_top_desktop",
      "label": "Padding TOP desktop (px)",
      "min": 0,
      "max": 200,
      "step": 4,
      "default": 0,
      "visible_if": "{{ section.settings.enable_pad_top_desktop }}"
    },
    {
      "type": "checkbox",
      "id": "enable_pad_bottom_desktop",
      "label": "Personalizar padding BOTTOM desktop",
      "default": false
    },
    {
      "type": "range",
      "id": "pad_bottom_desktop",
      "label": "Padding BOTTOM desktop (px)",
      "min": 0,
      "max": 200,
      "step": 4,
      "default": 0,
      "visible_if": "{{ section.settings.enable_pad_bottom_desktop }}"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Recurso",
      "settings": [
        {
          "type": "text",
          "id": "feature_text",
          "label": "Texto",
          "default": "Lorem ipsum dolor sit amet"
        },
        {
          "type": "checkbox",
          "id": "brand_has",
          "label": "Marca possui",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "competitor_has",
          "label": "Concorrente possui",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Tabela Comparativa V3",
      "category": "Texto",
      "settings": {
        "title": "<h2>Lorem ipsum dolor sit amet</h2>",
        "subtitle": "Lorem ipsum dolor sit amet",
        "brand_title": "LOGO",
        "competitor_title": "Outros",
        "brand_color": "#443FD2",
        "button_text": "CTA",
        "button_url": "/"
      },
      "blocks": [
