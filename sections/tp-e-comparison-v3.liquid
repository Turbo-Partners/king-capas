{{ 'tp-e-comparison-v3.css' | asset_url | stylesheet_tag }}

{% render 'tp-section-padding',
  pad_top_min: section.settings.pad_top_min,
  pad_top_max: section.settings.pad_top_max,
  pad_bottom_min: section.settings.pad_bottom_min,
  pad_bottom_max: section.settings.pad_bottom_max,
  enable_pad_top_mobile: section.settings.enable_pad_top_mobile,
  pad_top_mobile: section.settings.pad_top_mobile,
  enable_pad_bottom_mobile: section.settings.enable_pad_bottom_mobile,
  pad_bottom_mobile: section.settings.pad_bottom_mobile,
  enable_pad_top_desktop: section.settings.enable_pad_top_desktop,
  pad_top_desktop: section.settings.pad_top_desktop,
  enable_pad_bottom_desktop: section.settings.enable_pad_bottom_desktop,
  pad_bottom_desktop: section.settings.pad_bottom_desktop
%}

{% liquid
  assign background_type = section.settings.background_type
  assign brand_title = section.settings.brand_title
  assign competitor_title = section.settings.competitor_title
%}

{% style %}
.{{ section.id }} {
  background-size: cover;
  background-repeat: no-repeat;
  background-position: center;

  {% if section.settings.brand_color != blank %}
    --tp-e-cv3-brand-bg: {{ section.settings.brand_color }};
  {% endif %}
  {% if section.settings.brand_header_color != blank %}
    --tp-e-cv3-brand-header-color: {{ section.settings.brand_header_color }};
  {% endif %}
  {% if section.settings.brand_logo_height > 0 %}
    --tp-e-cv3-brand-logo-height: {{ section.settings.brand_logo_height }}px;
  {% endif %}

  {% if section.settings.title_custom %}
    {% if section.settings.title_color != blank %}
      --tp-e-cv3-title-color: {{ section.settings.title_color }};
    {% endif %}
    --tp-e-cv3-title-size: {{ section.settings.title_size_desktop }}px;
    --tp-e-cv3-title-size-mobile: {{ section.settings.title_size_mobile }}px;
    --tp-e-cv3-title-weight: {{ section.settings.title_weight }};
  {% endif %}

  {% if section.settings.subtitle_custom %}
    {% if section.settings.subtitle_color != blank %}
      --tp-e-cv3-subtitle-color: {{ section.settings.subtitle_color }};
    {% endif %}
    --tp-e-cv3-subtitle-size: {{ section.settings.subtitle_size_desktop }}px;
    --tp-e-cv3-subtitle-size-mobile: {{ section.settings.subtitle_size_mobile }}px;
  {% endif %}

  {% if section.settings.row_custom %}
    {% if section.settings.row_color != blank %}
      --tp-e-cv3-row-color: {{ section.settings.row_color }};
    {% endif %}
    --tp-e-cv3-row-size: {{ section.settings.row_size_desktop }}px;
    --tp-e-cv3-row-size-mobile: {{ section.settings.row_size_mobile }}px;
    --tp-e-cv3-row-weight: {{ section.settings.row_weight }};
  {% endif %}

  {% if section.settings.button_custom %}
    {% if section.settings.button_bg_color != blank %}
      --tp-e-cv3-btn-bg: {{ section.settings.button_bg_color }};
    {% endif %}
    {% if section.settings.button_text_color != blank %}
      --tp-e-cv3-btn-color: {{ section.settings.button_text_color }};
    {% endif %}
    {% case section.settings.button_radius %}
      {% when 'none' %}
        --tp-e-cv3-btn-radius: 0;
      {% when 'sm' %}
        --tp-e-cv3-btn-radius: var(--tp-radius-sm);
      {% when 'md' %}
        --tp-e-cv3-btn-radius: var(--tp-radius-md);
      {% when 'lg' %}
        --tp-e-cv3-btn-radius: var(--tp-radius-lg);
      {% when 'xl' %}
        --tp-e-cv3-btn-radius: var(--tp-radius-xl);
      {% when 'full' %}
        --tp-e-cv3-btn-radius: 9999px;
    {% endcase %}
    --tp-e-cv3-btn-font-size: {{ section.settings.button_font_size }}px;
    --tp-e-cv3-btn-font-weight: {{ section.settings.button_font_weight }};
  {% endif %}

  {% case section.settings.table_radius %}
    {% when 'none' %}
      --tp-e-cv3-radius: 0;
    {% when 'sm' %}
      --tp-e-cv3-radius: var(--tp-radius-sm);
    {% when 'md' %}
      --tp-e-cv3-radius: var(--tp-radius-md);
    {% when 'lg' %}
      --tp-e-cv3-radius: var(--tp-radius-lg);
    {% when 'xl' %}
      --tp-e-cv3-radius: var(--tp-radius-xl);
  {% endcase %}

  {% if background_type == "image" and section.settings.background_image_mobile != blank %}
    background-image: url('{{ section.settings.background_image_mobile | image_url }}');
    {% if section.settings.background_image_desktop != blank %}
      @media screen and (min-width: 1024px) {
        background-image: url('{{ section.settings.background_image_desktop | image_url }}');
      }
    {% endif %}
  {% elsif background_type == "color" and section.settings.background_color != blank %}
    background: {{ section.settings.background_color }};
  {% elsif background_type == "gradient" and section.settings.background_gradient != blank %}
    background: {{ section.settings.background_gradient }};
  {% endif %}
}
{% endstyle %}

<section class="tp-e-comparison-v3 {{ section.id }} scroll-trigger animate--slide-in">
  <div class="tp-wrapper tp-e-comparison-v3__wrapper">

    {%- comment -%} Left: text content {%- endcomment -%}
    <div class="tp-e-comparison-v3__text-content">
      <div class="tp-e-comparison-v3__header">
        {% if section.settings.title != blank %}
          <div class="tp-e-comparison-v3__title">{{ section.settings.title }}</div>
        {% endif %}
        {% if section.settings.subtitle != blank %}
          <p class="tp-e-comparison-v3__subtitle">{{ section.settings.subtitle | escape }}</p>
        {% endif %}
      </div>
      {% if section.settings.button_text != blank and section.settings.button_url != blank %}
        <a href="{{ section.settings.button_url }}" class="tp-e-comparison-v3__button">
          {{ section.settings.button_text | escape }}
        </a>
      {% endif %}
    </div>

    {%- comment -%} Right: comparison table {%- endcomment -%}
    <div class="tp-e-comparison-v3__table-area">
      <div class="tp-e-comparison-v3__grid" role="table">
        {%- comment -%} Header row {%- endcomment -%}
        <div class="tp-e-comparison-v3__row" role="row">
          <div class="tp-e-comparison-v3__header-feature" role="columnheader">
            <span class="visually-hidden">Recurso</span>
          </div>
          <div class="tp-e-comparison-v3__header-brand" role="columnheader">
            {% if section.settings.brand_logo != blank %}
              {{ section.settings.brand_logo | image_url: width: 200 | image_tag:
                loading: 'lazy',
                class: 'tp-e-comparison-v3__brand-logo',
                alt: brand_title
              }}
            {% else %}
              <span class="tp-e-comparison-v3__brand-label">{{ brand_title | escape }}</span>
            {% endif %}
            {% if section.settings.brand_image != blank %}
              {{ section.settings.brand_image | image_url: width: 300 | image_tag:
                loading: 'lazy',
                class: 'tp-e-comparison-v3__header-image',
                alt: brand_title
              }}
            {% endif %}
          </div>
          <div class="tp-e-comparison-v3__header-competitor" role="columnheader">
            <span class="tp-e-comparison-v3__competitor-label">{{ competitor_title | escape }}</span>
            {% if section.settings.competitor_image != blank %}
              {{ section.settings.competitor_image | image_url: width: 300 | image_tag:
                loading: 'lazy',
                class: 'tp-e-comparison-v3__competitor-image',
                alt: competitor_title
              }}
            {% endif %}
          </div>
        </div>

        {%- comment -%} Body rows {%- endcomment -%}
        {% for block in section.blocks %}
          <div class="tp-e-comparison-v3__row" role="row" {{ block.shopify_attributes }}>
            <div class="tp-e-comparison-v3__cell tp-e-comparison-v3__cell--feature" role="cell">
              {{ block.settings.feature_text | escape }}
            </div>
            <div class="tp-e-comparison-v3__cell tp-e-comparison-v3__cell--brand" role="cell">
              {% if block.settings.brand_has %}
                <span class="tp-e-comparison-v3__icon" aria-label="Sim">
                  {% if section.settings.check_icon != blank %}
                    <img src="{{ section.settings.check_icon | image_url }}" alt="">
                  {% else %}
                    <img src="{{ 'tp-placeholder-check.svg' | asset_url }}" alt="">
                  {% endif %}
                </span>
              {% else %}
                <span class="tp-e-comparison-v3__icon" aria-label="Não">
                  {% if section.settings.false_icon != blank %}
                    <img src="{{ section.settings.false_icon | image_url }}" alt="">
                  {% else %}
                    <img src="{{ 'tp-placeholder-false.svg' | asset_url }}" alt="">
                  {% endif %}
                </span>
              {% endif %}
            </div>
            <div class="tp-e-comparison-v3__cell tp-e-comparison-v3__cell--competitor" role="cell">
              {% if block.settings.competitor_has %}
                <span class="tp-e-comparison-v3__icon" aria-label="Sim">
                  {% if section.settings.check_icon != blank %}
                    <img src="{{ section.settings.check_icon | image_url }}" alt="">
                  {% else %}
                    <img src="{{ 'tp-placeholder-check.svg' | asset_url }}" alt="">
                  {% endif %}
                </span>
              {% else %}
                <span class="tp-e-comparison-v3__icon" aria-label="Não">
                  {% if section.settings.false_icon != blank %}
                    <img src="{{ section.settings.false_icon | image_url }}" alt="">
                  {% else %}
                    <img src="{{ 'tp-placeholder-false.svg' | asset_url }}" alt="">
                  {% endif %}
                </span>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>
    </div>

  </div>

  {%- comment -%} Mobile CTA (below table) {%- endcomment -%}
  {% if section.settings.button_text != blank and section.settings.button_url != blank %}
    <div class="tp-wrapper">
      <a href="{{ section.settings.button_url }}" class="tp-e-comparison-v3__button--mobile">
        {{ section.settings.button_text | escape }}
      </a>
    </div>
  {% endif %}
</section>

{% schema %}
{
  "name": "Tabela Comparativa V3",
  "class": "E__COMPARISON__V3",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Conteúdo"
    },
    {
      "type": "richtext",
      "id": "title",
      "label": "Título",
      "default": "<h2>Lorem ipsum dolor sit amet</h2>"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtítulo",
      "default": "Lorem ipsum dolor sit amet"
    },
    {
      "type": "header",
      "content": "Marca"
    },
    {
      "type": "text",
      "id": "brand_title",
      "label": "Nome",
      "default": "LOGO"
    },
    {
      "type": "image_picker",
      "id": "brand_logo",
      "label": "Logo (opcional)"
    },
    {
      "type": "range",
      "id": "brand_logo_height",
      "label": "Altura da logo (px)",
      "min": 16,
      "max": 120,
      "step": 2,
      "default": 32
    },
    {
      "type": "image_picker",
      "id": "brand_image",
      "label": "Imagem do produto"
    },
    {
      "type": "header",
      "content": "Concorrente"
    },
    {
      "type": "text",
      "id": "competitor_title",
      "label": "Nome",
      "default": "Outros"
    },
    {
      "type": "image_picker",
      "id": "competitor_image",
      "label": "Imagem do produto"
    },
    {
      "type": "header",
      "content": "Ícones"
    },
    {
      "type": "image_picker",
      "id": "check_icon",
      "label": "Ícone de check (opcional)"
    },
    {
      "type": "image_picker",
      "id": "false_icon",
      "label": "Ícone de negação (opcional)"
    },
    {
      "type": "header",
      "content": "Botão"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Texto",
      "default": "CTA"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Link"
    },
    {
      "type": "checkbox",
      "id": "button_custom",
      "label": "Personalizar",
      "default": false
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Cor de fundo",
      "visible_if": "{{ section.settings.button_custom }}"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Cor do texto",
      "visible_if": "{{ section.settings.button_custom }}"
    },
    {
      "type": "select",
      "id": "button_radius",
      "label": "Arredondamento",
      "default": "full",
      "visible_if": "{{ section.settings.button_custom }}",
      "options": [
        { "label": "Nenhum", "value": "none" },
        { "label": "Pequeno", "value": "sm" },
        { "label": "Médio", "value": "md" },
        { "label": "Grande", "value": "lg" },
        { "label": "Extra grande", "value": "xl" },
        { "label": "Completo", "value": "full" }
      ]
    },
    {
      "type": "range",
      "id": "button_font_size",
      "label": "Tamanho do texto (px)",
      "min": 12,
      "max": 24,
      "step": 1,
      "default": 16,
      "visible_if": "{{ section.settings.button_custom }}"
    },
    {
      "type": "select",
      "id": "button_font_weight",
      "label": "Peso do texto",
      "default": "600",
      "visible_if": "{{ section.settings.button_custom }}",
      "options": [
        { "value": "400", "label": "Regular (400)" },
        { "value": "500", "label": "Medium (500)" },
        { "value": "600", "label": "Semibold (600)" },
        { "value": "700", "label": "Bold (700)" }
      ]
    },
    {
      "type": "header",
      "content": "Aparência"
    },
    {
      "type": "select",
      "id": "background_type",
      "label": "Tipo de background",
      "default": "color",
      "options": [
        { "label": "Cor", "value": "color" },
        { "label": "Gradiente", "value": "gradient" },
        { "label": "Imagem", "value": "image" }
      ]
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Cor",
      "default": "#FFFFFF",
      "visible_if": "{{ section.settings.background_type == 'color' }}"
    },
    {
      "type": "color_background",
      "id": "background_gradient",
      "label": "Gradiente",
      "visible_if": "{{ section.settings.background_type == 'gradient' }}"
    },
    {
      "type": "image_picker",
      "id": "background_image_mobile",
      "label": "Imagem mobile",
      "visible_if": "{{ section.settings.background_type == 'image' }}"
    },
    {
      "type": "image_picker",
      "id": "background_image_desktop",
      "label": "Imagem desktop",
      "visible_if": "{{ section.settings.background_type == 'image' }}"
    },
    {
      "type": "color",
      "id": "brand_color",
      "label": "Cor da coluna da marca",
      "default": "#443FD2"
    },
    {
      "type": "color",
      "id": "brand_header_color",
      "label": "Cor do texto da marca",
      "default": "#FFFFFF"
    },
    {
      "type": "select",
      "id": "table_radius",
      "label": "Arredondamento da coluna marca",
      "default": "lg",
      "options": [
        { "label": "Nenhum", "value": "none" },
        { "label": "Pequeno", "value": "sm" },
        { "label": "Médio", "value": "md" },
        { "label": "Grande", "value": "lg" },
        { "label": "Extra grande", "value": "xl" }
      ]
    },
    {
      "type": "header",
      "content": "Tipografia"
    },
    {
      "type": "checkbox",
      "id": "title_custom",
      "label": "Personalizar título",
      "default": false
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Cor",
      "default": "#101828",
      "visible_if": "{{ section.settings.title_custom }}"
    },
    {
      "type": "range",
      "id": "title_size_mobile",
      "label": "Tamanho mobile (px)",
      "min": 16,
      "max": 80,
      "step": 1,
      "default": 32,
      "visible_if": "{{ section.settings.title_custom }}"
    },
    {
      "type": "range",
      "id": "title_size_desktop",
      "label": "Tamanho desktop (px)",
      "min": 16,
      "max": 100,
      "step": 1,
      "default": 48,
      "visible_if": "{{ section.settings.title_custom }}"
    },
    {
      "type": "select",
      "id": "title_weight",
      "label": "Peso",
      "default": "700",
      "visible_if": "{{ section.settings.title_custom }}",
      "options": [
        { "value": "400", "label": "Regular (400)" },
        { "value": "500", "label": "Medium (500)" },
        { "value": "600", "label": "Semibold (600)" },
        { "value": "700", "label": "Bold (700)" }
      ]
    },
    {
      "type": "checkbox",
      "id": "subtitle_custom",
      "label": "Personalizar subtítulo",
      "default": false
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "Cor",
      "visible_if": "{{ section.settings.subtitle_custom }}"
    },
    {
      "type": "range",
      "id": "subtitle_size_mobile",
      "label": "Tamanho mobile (px)",
      "min": 12,
      "max": 40,
      "step": 1,
      "default": 16,
      "visible_if": "{{ section.settings.subtitle_custom }}"
    },
    {
      "type": "range",
      "id": "subtitle_size_desktop",
      "label": "Tamanho desktop (px)",
      "min": 12,
      "max": 40,
      "step": 1,
      "default": 18,
      "visible_if": "{{ section.settings.subtitle_custom }}"
    },
    {
      "type": "checkbox",
      "id": "row_custom",
      "label": "Personalizar texto das linhas",
      "default": false
    },
    {
      "type": "color",
      "id": "row_color",
      "label": "Cor",
      "visible_if": "{{ section.settings.row_custom }}"
    },
    {
      "type": "range",
      "id": "row_size_mobile",
      "label": "Tamanho mobile (px)",
      "min": 10,
      "max": 40,
      "step": 1,
      "default": 14,
      "visible_if": "{{ section.settings.row_custom }}"
    },
    {
      "type": "range",
      "id": "row_size_desktop",
      "label": "Tamanho desktop (px)",
      "min": 10,
      "max": 40,
      "step": 1,
      "default": 18,
      "visible_if": "{{ section.settings.row_custom }}"
    },
    {
      "type": "select",
      "id": "row_weight",
      "label": "Peso",
      "default": "600",
      "visible_if": "{{ section.settings.row_custom }}",
      "options": [
        { "value": "400", "label": "Regular (400)" },
        { "value": "500", "label": "Medium (500)" },
