{{ 'tp-e-review-v2.css' | asset_url | stylesheet_tag }}

{% render 'tp-section-padding',
  pad_top_min: section.settings.pad_top_min,
  pad_top_max: section.settings.pad_top_max,
  pad_bottom_min: section.settings.pad_bottom_min,
  pad_bottom_max: section.settings.pad_bottom_max,
  enable_pad_top_mobile: section.settings.enable_pad_top_mobile,
  pad_top_mobile: section.settings.pad_top_mobile,
  enable_pad_bottom_mobile: section.settings.enable_pad_bottom_mobile,
  pad_bottom_mobile: section.settings.pad_bottom_mobile,
  enable_pad_top_desktop: section.settings.enable_pad_top_desktop,
  pad_top_desktop: section.settings.pad_top_desktop,
  enable_pad_bottom_desktop: section.settings.enable_pad_bottom_desktop,
  pad_bottom_desktop: section.settings.pad_bottom_desktop
%}

{% liquid
  assign background_type = section.settings.background_type
  assign columns_desktop = section.settings.columns_desktop
  assign gap = section.settings.gap
%}

{% style %}
  .{{ section.id }} {
    --tp-review-cols: {{ columns_desktop }};
    --tp-review-gap: {{ gap }}px;

    {% if background_type == 'color' and section.settings.background_color != blank %}
      background: {{ section.settings.background_color }};
    {% elsif background_type == 'gradient' and section.settings.background_gradient != blank %}
      background: {{ section.settings.background_gradient }};
    {% elsif background_type == 'image' and section.settings.background_image_mobile != blank %}
      background-image: url('{{ section.settings.background_image_mobile | image_url }}');
      background-size: cover;
      background-repeat: no-repeat;
      background-position: center;
    {% endif %}
  }

  {% if background_type == 'image' and section.settings.background_image_desktop != blank %}
    @media screen and (min-width: 1024px) {
      .{{ section.id }} {
        background-image: url('{{ section.settings.background_image_desktop | image_url }}');
      }
    }
  {% endif %}

  .{{ section.id }} .tp-e-review-v2__title {
    text-align: {{ section.settings.section_align }};
    margin-bottom: {{ section.settings.title_gap_mobile }}px;

    {% if section.settings.title_custom %}
      color: {{ section.settings.title_color }};
      font-size: {{ section.settings.title_size_mobile }}px;
      font-weight: {{ section.settings.title_weight }};
    {% endif %}
  }

  @media screen and (min-width: 768px) {
    .{{ section.id }} .tp-e-review-v2__title {
      margin-bottom: {{ section.settings.title_gap_desktop }}px;
      {% if section.settings.title_custom %}
        font-size: {{ section.settings.title_size_desktop }}px;
      {% endif %}
    }
  }

  {% assign show_pagination = false %}
  {% if section.settings.pagination_mobile or section.settings.pagination_desktop %}
    {% assign show_pagination = true %}
  {% endif %}

  {% if show_pagination %}
    .{{ section.id }} .swiper-pagination-bullet {
      width: {{ section.settings.pagination_size }}px;
      height: {{ section.settings.pagination_size }}px;
      background-color: {{ section.settings.pagination_color }};
      opacity: 1;
    }
    {% if section.settings.pagination_border %}
      .{{ section.id }} .swiper-pagination-bullet {
        border: {{ section.settings.pagination_border_width }}px solid {{ section.settings.pagination_border_color }};
      }
    {% endif %}

    .{{ section.id }} .swiper-pagination-bullet-active {
      width: {{ section.settings.pagination_size_active }}px;
      height: {{ section.settings.pagination_size_active }}px;
      background-color: {{ section.settings.pagination_color_active }};
    }
    {% if section.settings.pagination_border_active %}
      .{{ section.id }} .swiper-pagination-bullet-active {
        border: {{ section.settings.pagination_border_width_active }}px solid {{ section.settings.pagination_border_color_active }};
      }
    {% endif %}

    {% unless section.settings.pagination_mobile %}
      @media screen and (max-width: 767px) {
        .{{ section.id }} .swiper-pagination { display: none; }
      }
    {% endunless %}

    {% unless section.settings.pagination_desktop %}
      @media screen and (min-width: 768px) {
        .{{ section.id }} .swiper-pagination { display: none; }
      }
    {% endunless %}
  {% endif %}

{% endstyle %}

<section class="tp-e-review-v2 {{ section.id }} scroll-trigger animate--slide-in">
  <div
    class="{% if section.settings.fullscreen %}tp-e-review-v2__wrapper--full {% else %}tp-wrapper {% endif %}tp-e-review-v2__wrapper"
    id="section-wrapper-{{ section.id }}"
  >
    {% if section.settings.title != blank %}
      <div class="tp-e-review-v2__title">
        {{ section.settings.title }}
      </div>
    {% endif %}

    <div class="tp-e-review-v2__swiper-container">
      <div class="swiper tp-e-review-v2__swiper">
        <div class="swiper-wrapper">
          {% for block in section.blocks %}
            {% liquid
              assign card_style = ''

              if block.settings.card_bg != blank
                assign card_style = card_style | append: '--card-bg:' | append: block.settings.card_bg | append: ';'
              endif

              if block.settings.card_border_color != blank
                assign card_style = card_style | append: '--card-border-color:' | append: block.settings.card_border_color | append: ';'
              endif

              assign card_style = card_style | append: '--card-border-width:' | append: block.settings.card_border_width | append: 'px;'
              assign card_style = card_style | append: '--card-radius:' | append: block.settings.card_radius | append: ';'
              assign card_style = card_style | append: '--card-align:' | append: block.settings.card_align | append: ';'

              if block.settings.impact_custom
                assign card_style = card_style | append: '--impact-color:' | append: block.settings.impact_color | append: ';'
                assign card_style = card_style | append: '--impact-size:' | append: block.settings.impact_size | append: 'px;'
                assign card_style = card_style | append: '--impact-weight:' | append: block.settings.impact_weight | append: ';'
              endif

              if block.settings.content_custom
                assign card_style = card_style | append: '--content-color:' | append: block.settings.content_color | append: ';'
                assign card_style = card_style | append: '--content-size:' | append: block.settings.content_size | append: 'px;'
                assign card_style = card_style | append: '--content-weight:' | append: block.settings.content_weight | append: ';'
              endif

              if block.settings.name_custom
                assign card_style = card_style | append: '--name-color:' | append: block.settings.name_color | append: ';'
                assign card_style = card_style | append: '--name-size:' | append: block.settings.name_size | append: 'px;'
                assign card_style = card_style | append: '--name-weight:' | append: block.settings.name_weight | append: ';'
              endif

              if block.settings.extra_custom
                assign card_style = card_style | append: '--extra-color:' | append: block.settings.extra_color | append: ';'
                assign card_style = card_style | append: '--extra-size:' | append: block.settings.extra_size | append: 'px;'
                assign card_style = card_style | append: '--extra-weight:' | append: block.settings.extra_weight | append: ';'
              endif
            %}
            <div class="swiper-slide tp-e-review-v2__slide" {{ block.shopify_attributes }}>
              <div class="tp-e-review-v2__card" style="{{ card_style }}">
                {% if block.settings.impact != blank %}
                  <p class="tp-e-review-v2__impact">{{ block.settings.impact | escape }}</p>
                {% endif %}

                {% if block.settings.content != blank %}
                  <div class="tp-e-review-v2__content">
                    {{ block.settings.content }}
                  </div>
                {% endif %}

                <div class="tp-e-review-v2__identity">
                  {% if block.settings.name != blank %}
                    <span class="tp-e-review-v2__name">{{ block.settings.name | escape }}</span>
                  {% endif %}
                  {% if block.settings.extra_info != blank %}
                    <span class="tp-e-review-v2__extra">{{ block.settings.extra_info | escape }}</span>
                  {% endif %}
                  {% if block.settings.star_image != blank %}
                    <div class="tp-e-review-v2__card-stars-wrapper">
                      {% for star in (1..block.settings.star_quantity) %}
                        <img class="tp-e-review-v2__card-star" src="{{ block.settings.star_image | image_url }}">
                      {% endfor %}
                    </div>
                    
                  {% endif %}
                </div>
              </div>
            </div>
          {% endfor %}
        </div>
      </div>

      {% if section.settings.navigation %}
        <div class="tp-e-review-v2__nav tp-e-review-v2__nav--prev swiper-button-prev">
          {{ 'tp-button-prev.svg' | inline_asset_content }}
        </div>
        <div class="tp-e-review-v2__nav tp-e-review-v2__nav--next swiper-button-next">
          {{ 'tp-button-next.svg' | inline_asset_content }}
        </div>
      {% endif %}
    </div>

    {% if show_pagination %}
      <div class="tp-e-review-v2__pagination swiper-pagination"></div>
    {% endif %}
  </div>
</section>

<script>
  (function () {
    var sectionEl = document.querySelector('.{{ section.id }} .tp-e-review-v2__swiper');
    if (!sectionEl) return;

    var autoplayConfig = false;
    {% if section.settings.autoplay %}
      autoplayConfig = { delay: {{ section.settings.autoplay_time | times: 1000 }}, disableOnInteraction: false };
    {% endif %}

    var paginationConfig = false;
    {% if show_pagination %}
      paginationConfig = {
        el: '.{{ section.id }} .swiper-pagination',
        clickable: true
      };
    {% endif %}

    var navigationConfig = false;
    {% if section.settings.navigation %}
      navigationConfig = {
        prevEl: '.{{ section.id }} .swiper-button-prev',
        nextEl: '.{{ section.id }} .swiper-button-next'
      };
    {% endif %}

    var isMobile = window.innerWidth < 768;

    {% assign centered = section.settings.centered_slides %}

    new Swiper(sectionEl, {
      slidesPerView: 1,
      spaceBetween: 16,
      centeredSlides: {{ centered }},
      centeredSlidesBounds: {{ centered }},
      autoplay: autoplayConfig,
      pagination: paginationConfig,
      navigation: navigationConfig,
      breakpoints: {
        768: {
          slidesPerView: {{ centered }} ? {{ columns_desktop }} - 1 - 0.8 : {{ columns_desktop }} - 1,
          spaceBetween: {{ gap }},
          centeredSlides: {{ centered }},
          centeredSlidesBounds: {{ centered }}
        },
        1024: {
          slidesPerView: {{ centered }} ? {{ columns_desktop }} + 0.8 : {{ columns_desktop }},
          spaceBetween: {{ gap }},
          centeredSlides: {{ centered }},
          centeredSlidesBounds: {{ centered }}
        }
      }
    });
  })();
</script>

