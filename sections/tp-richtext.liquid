{{ 'tp-richtext.css' | asset_url | stylesheet_tag }}

{% render 'tp-section-padding',
  pad_top_min: section.settings.pad_top_min,
  pad_top_max: section.settings.pad_top_max,
  pad_bottom_min: section.settings.pad_bottom_min,
  pad_bottom_max: section.settings.pad_bottom_max,
  enable_pad_top_mobile: section.settings.enable_pad_top_mobile,
  pad_top_mobile: section.settings.pad_top_mobile,
  enable_pad_bottom_mobile: section.settings.enable_pad_bottom_mobile,
  pad_bottom_mobile: section.settings.pad_bottom_mobile,
  enable_pad_top_desktop: section.settings.enable_pad_top_desktop,
  pad_top_desktop: section.settings.pad_top_desktop,
  enable_pad_bottom_desktop: section.settings.enable_pad_bottom_desktop,
  pad_bottom_desktop: section.settings.pad_bottom_desktop
%}

{% liquid
  assign background_type = section.settings.background_type
%}

{% style %}
.{{ section.id }} {
	background-size: cover;
	background-repeat: no-repeat;
	background-position: center;

	{% if background_type == "image" and section.settings.background_image_mobile != blank %}
		background-image: url('{{ section.settings.background_image_mobile | image_url }}');

		{% if section.settings.background_image_desktop != blank %}
			@media screen and (min-width: 1024px) {
				background-image: url('{{ section.settings.background_image_desktop | image_url }}');
			}
		{% endif %}
	{% elsif background_type == "color" and section.settings.background_color != blank %}
		background: {{ section.settings.background_color }};
	{% elsif background_type == "gradient" and section.settings.background_gradient != blank %}
		background: {{ section.settings.background_gradient }};
	{% endif %}
}
{% endstyle %}

<section class="tp-richtext {{ section.id }}">
    <div class="tp-wrapper tp-richtext__wrapper" id="section-wrapper-{{ section.id }}">
        {% if section.settings.image != blank %}
            <div class="tp-richtext__image">
                <img src="{{ section.settings.image | image_url }}">
            </div>
        {% endif %}
        <div class="tp-richtext__text-wrapper">
            {{ section.settings.richtext }}
        </div>
    </div>
</section>

{% schema %}
{
    "name": "TP Richtet",
    "settings": [
        {
            "type": "select",
            "id": "background_type",
            "label": "Tipo de Background",
            "default": "color",
            "options": [
                { "label": "Cor", "value": "color" },
                { "label": "Gradiente", "value": "gradient" },
                { "label": "Imagem", "value": "image" }
            ]
        },
        {
            "type": "color",
            "id": "background_color",
            "label": "Cor do Background",
            "default": "#FFFFFF",
            "visible_if": "{{ section.settings.background_type == 'color' }}"
        },
        {
            "type": "color_background",
            "id": "background_gradient",
            "label": "Gradiente do Background",
            "visible_if": "{{ section.settings.background_type == 'gradient' }}"
        },
        {
            "type": "image_picker",
            "id": "background_image_mobile",
            "label": "Imagem Mobile do Background",
            "visible_if": "{{ section.settings.background_type == 'image' }}"
        },
        {
            "type": "image_picker",
            "id": "background_image_desktop",
            "label": "Imagem Desktop do Background",
            "visible_if": "{{ section.settings.background_type == 'image' }}"
        },
        {
            "type": "header",
            "content": "Spacing"
        },
        {
            "type": "range",
            "id": "pad_top_min",
            "label": "Padding TOP min (px)",
            "min": 0,
            "max": 120,
            "step": 4,
            "default": 48
        },
        {
            "type": "range",
            "id": "pad_top_max",
            "label": "Padding TOP max (px)",
            "min": 0,
            "max": 120,
            "step": 4,
            "default": 96
        },
        {
            "type": "range",
            "id": "pad_bottom_min",
            "label": "Padding BOTTOM min (px)",
            "min": 0,
            "max": 120,
            "step": 4,
            "default": 48
        },
        {
            "type": "range",
            "id": "pad_bottom_max",
            "label": "Padding BOTTOM max (px)",
            "min": 0,
            "max": 120,
            "step": 8,
            "default": 96
        },
        {
            "type": "header",
            "content": "Spacing Overrides (opcional)"
        },
        {
            "type": "checkbox",
            "id": "enable_pad_top_mobile",
            "label": "Ativar padding TOP no mobile",
            "default": false
        },
        {
            "type": "range",
            "id": "pad_top_mobile",
            "label": "Padding TOP mobile (px)",
            "min": 0,
            "max": 120,
            "step": 4,
            "default": 0,
            "visible_if": "{{ section.settings.enable_pad_top_mobile }}"
        },
        {
            "type": "checkbox",
            "id": "enable_pad_bottom_mobile",
            "label": "Ativar padding BOTTOM no mobile",
            "default": false
        },
        {
            "type": "range",
            "id": "pad_bottom_mobile",
            "label": "Padding BOTTOM mobile (px)",
            "min": 0,
            "max": 120,
            "step": 4,
            "default": 0,
            "visible_if": "{{ section.settings.enable_pad_bottom_mobile }}"
        },
        {
            "type": "checkbox",
            "id": "enable_pad_top_desktop",
            "label": "Ativar padding TOP no desktop",
            "default": false
        },
        {
            "type": "range",
            "id": "pad_top_desktop",
            "label": "Padding TOP desktop (px)",
            "min": 0,
            "max": 120,
            "step": 4,
            "default": 0,
            "visible_if": "{{ section.settings.enable_pad_top_desktop }}"
        },
        {
            "type": "checkbox",
            "id": "enable_pad_bottom_desktop",
            "label": "Ativar padding BOTTOM no desktop",
            "default": false
        },
        {
            "type": "range",
            "id": "pad_bottom_desktop",
            "label": "Padding BOTTOM desktop (px)",
            "min": 0,
            "max": 120,
            "step": 4,
            "default": 0,
            "visible_if": "{{ section.settings.enable_pad_bottom_desktop }}"
        }
    ],
    "presets": [
        {
            "name": "TP - Richtext",
            "category": "TP - Seções"
        }
    ]
}
{% endschema %}