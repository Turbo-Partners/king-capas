{% comment %}
  Seção global de mapeamento de cores para variantes de produto.
  Adicionar em layout/theme.liquid com: {% section 'tp-e-color-swatches-v1' %}
  Não renderiza conteúdo visível — apenas gera CSS com o mapa de cores.
{% endcomment %}

{%- if section.blocks.size > 0 -%}
  <style>
    {%- for block in section.blocks -%}
      {%- liquid
        assign slug = block.settings.color_name | downcase | replace: 'á', 'a' | replace: 'à', 'a' | replace: 'ã', 'a' | replace: 'â', 'a' | replace: 'é', 'e' | replace: 'ê', 'e' | replace: 'í', 'i' | replace: 'ó', 'o' | replace: 'ô', 'o' | replace: 'õ', 'o' | replace: 'ú', 'u' | replace: 'ü', 'u' | replace: 'ç', 'c' | replace: ' ', '-' | replace: '_', '-' | replace: '/', '-'
      -%}
      {%- if slug != blank -%}
        {%- if block.settings.color_image != blank -%}
          .tp-swatch--{{ slug }} {
            background-image: url('{{ block.settings.color_image | image_url: width: 48 }}');
            background-size: cover;
            background-position: center;
          }
          .tp-swatch--{{ slug }}.swatch,
          label.tp-swatch--{{ slug }} {
            background-image: url('{{ block.settings.color_image | image_url: width: 48 }}');
            background-size: cover;
            background-position: center;
          }
        {%- else -%}
          .tp-swatch--{{ slug }},
          .tp-swatch--{{ slug }}.swatch,
          label.tp-swatch--{{ slug }} {
            background-color: {{ block.settings.color_value }} !important;
          }
        {%- endif -%}
        label.tp-swatch--{{ slug }} {
          width: 2rem;
          height: 2rem;
          border-radius: 50%;
          padding: 0;
          font-size: 0;
          border: 2px solid transparent;
          outline-offset: 2px;
          cursor: pointer;
        }
        label.tp-swatch--{{ slug }}:hover {
          border-color: rgba(0,0,0,0.3);
        }
        input:checked + label.tp-swatch--{{ slug }} {
          border-color: rgba(0,0,0,0.7);
          outline: 1px solid rgba(0,0,0,0.7);
        }
      {%- endif -%}
    {%- endfor -%}
  </style>
{%- endif -%}

{% schema %}
{
  "name": "Mapa de Cores",
  "class": "E__COLOR_SWATCHES__V1",
  "settings": [],
  "blocks": [
    {
      "type": "color_entry",
      "name": "Cor",
      "settings": [
        {
          "type": "text",
          "id": "color_name",
          "label": "Nome da variante",
          "info": "Exatamente como cadastrado no produto. Ex: Azul Royal"
        },
        {
          "type": "color",
          "id": "color_value",
          "label": "Cor"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Mapa de Cores",
      "category": "Personalizado",
      "blocks": [
        {
          "type": "color_entry",
          "settings": {
            "color_name": "Preto",
            "color_value": "#1a1a1a"
          }
        },
        {
          "type": "color_entry",
          "settings": {
            "color_name": "Branco",
            "color_value": "#ffffff"
          }
        },
        {
          "type": "color_entry",
          "settings": {
            "color_name": "Azul",
            "color_value": "#1e40af"
          }
        }
      ]
    }
  ]
}
{% endschema %}
