{{ 'tp-e-reviews-v3.css' | asset_url | stylesheet_tag }}

{% render 'tp-section-padding',
  pad_top_min: section.settings.pad_top_min,
  pad_top_max: section.settings.pad_top_max,
  pad_bottom_min: section.settings.pad_bottom_min,
  pad_bottom_max: section.settings.pad_bottom_max,
  enable_pad_top_mobile: section.settings.enable_pad_top_mobile,
  pad_top_mobile: section.settings.pad_top_mobile,
  enable_pad_bottom_mobile: section.settings.enable_pad_bottom_mobile,
  pad_bottom_mobile: section.settings.pad_bottom_mobile,
  enable_pad_top_desktop: section.settings.enable_pad_top_desktop,
  pad_top_desktop: section.settings.pad_top_desktop,
  enable_pad_bottom_desktop: section.settings.enable_pad_bottom_desktop,
  pad_bottom_desktop: section.settings.pad_bottom_desktop
%}

{% liquid
  assign background_type = section.settings.background_type
  assign pagination = section.settings.pagination
  assign navigation = section.settings.navigation
%}

{% style %}
.{{ section.id }} {
  background-size: cover;
  background-repeat: no-repeat;
  background-position: center;

  {% if background_type == "image" and section.settings.background_image_mobile != blank %}
    background-image: url('{{ section.settings.background_image_mobile | image_url }}');

    {% if section.settings.background_image_desktop != blank %}
      @media screen and (min-width: 1024px) {
        background-image: url('{{ section.settings.background_image_desktop | image_url }}');
      }
    {% endif %}
  {% elsif background_type == "color" and section.settings.background_color != blank %}
    background: {{ section.settings.background_color }};
  {% elsif background_type == "gradient" and section.settings.background_gradient != blank %}
    background: {{ section.settings.background_gradient }};
  {% endif %}

  {% if pagination %}
    .swiper-pagination {
      position: relative;

      .swiper-pagination-bullet {
        background: {{ section.settings.pagination_color }};
      }

      .swiper-pagination-bullet-active {
        background: {{ section.settings.pagination_color_active }};
      }
    }
  {% endif %}

  {% if navigation %}
    .swiper-button-prev, .swiper-button-next {
      width: clamp(2.4rem, 2.1029rem + 0.7619vw, 3.2rem);

      svg { fill: none; }

      &::after {
        content: '';
        color: transparent;
      }
    }
  {% endif %}
}

{% if section.settings.title_custom %}
  .{{ section.id }} .tp-testimonials__title p,
  .{{ section.id }} .tp-testimonials__title h1,
  .{{ section.id }} .tp-testimonials__title h2,
  .{{ section.id }} .tp-testimonials__title h3,
  .{{ section.id }} .tp-testimonials__title h4,
  .{{ section.id }} .tp-testimonials__title h5,
  .{{ section.id }} .tp-testimonials__title h6 {
    color: {{ section.settings.title_color }};
    font-size: {{ section.settings.title_size_mobile }}px;
    font-weight: {{ section.settings.title_weight }};
  }
  @media screen and (min-width: 750px) {
    .{{ section.id }} .tp-testimonials__title p,
    .{{ section.id }} .tp-testimonials__title h1,
    .{{ section.id }} .tp-testimonials__title h2,
    .{{ section.id }} .tp-testimonials__title h3,
    .{{ section.id }} .tp-testimonials__title h4,
    .{{ section.id }} .tp-testimonials__title h5,
    .{{ section.id }} .tp-testimonials__title h6 {
      font-size: {{ section.settings.title_size_desktop }}px;
    }
  }
{% endif %}

{% if section.settings.subtitle_custom %}
  .{{ section.id }} .tp-testimonials__subtitle {
    color: {{ section.settings.subtitle_color }};
    font-size: {{ section.settings.subtitle_size_mobile }}px;
    font-weight: {{ section.settings.subtitle_weight }};
  }
  @media screen and (min-width: 750px) {
    .{{ section.id }} .tp-testimonials__subtitle {
      font-size: {{ section.settings.subtitle_size_desktop }}px;
    }
  }
{% endif %}
{% endstyle %}

{% capture block_styles %}
  {% for block in section.blocks %}
    {% if block.type == 'testimonial' %}
      .tp-review-{{ block.id }} {
        {% if block.settings.card_bg_color != blank %}background: {{ block.settings.card_bg_color }};{% endif %}
        {% if block.settings.card_border %}border: {{ block.settings.card_border_width }}px solid {{ block.settings.card_border_color }};{% endif %}
        {% case block.settings.card_radius %}
          {% when 'sm' %}border-radius: var(--tp-radius-sm);
          {% when 'md' %}border-radius: var(--tp-radius-md);
          {% when 'lg' %}border-radius: var(--tp-radius-lg);
          {% when 'xl' %}border-radius: var(--tp-radius-xl);
          {% when 'full' %}border-radius: var(--tp-radius-full);
          {% else %}border-radius: 0;
        {% endcase %}
        --tp-review-icon-size-mobile: {{ block.settings.icon_size_mobile }}px;
        --tp-review-icon-size-desktop: {{ block.settings.icon_size_desktop }}px;
        --tp-review-author-img-mobile: {{ block.settings.author_img_size_mobile }}px;
        --tp-review-author-img-desktop: {{ block.settings.author_img_size_desktop }}px;
      }
      {% if block.settings.content_custom %}
        .tp-review-{{ block.id }} .tp-text-wrapper p,
        .tp-review-{{ block.id }} .tp-text-wrapper h4 {
          font-size: {{ block.settings.content_size_mobile }}px;
          font-weight: {{ block.settings.content_weight }};
          color: {{ block.settings.content_color }};
        }
        @media screen and (min-width: 750px) {
          .tp-review-{{ block.id }} .tp-text-wrapper p,
          .tp-review-{{ block.id }} .tp-text-wrapper h4 {
            font-size: {{ block.settings.content_size_desktop }}px;
          }
        }
      {% endif %}
      {% if block.settings.author_name_custom %}
        .tp-review-{{ block.id }} .tp-author__name {
          font-size: {{ block.settings.author_name_size_mobile }}px;
          font-weight: {{ block.settings.author_name_weight }};
          color: {{ block.settings.author_name_color }};
        }
        @media screen and (min-width: 750px) {
          .tp-review-{{ block.id }} .tp-author__name {
            font-size: {{ block.settings.author_name_size_desktop }}px;
          }
        }
      {% endif %}
      {% if block.settings.author_handle_custom %}
        .tp-review-{{ block.id }} .tp-author__handle {
          font-size: {{ block.settings.author_handle_size_mobile }}px;
          font-weight: {{ block.settings.author_handle_weight }};
          color: {{ block.settings.author_handle_color }};
        }
        @media screen and (min-width: 750px) {
          .tp-review-{{ block.id }} .tp-author__handle {
            font-size: {{ block.settings.author_handle_size_desktop }}px;
          }
        }
      {% endif %}
    {% endif %}
  {% endfor %}
{% endcapture %}
{% assign block_styles_clean = block_styles | strip %}
{% if block_styles_clean != blank %}
  <style>{{ block_styles_clean }}</style>
{% endif %}

<section class="tp-testimonials {{ section.id }}">
  <div class="tp-wrapper" id="section-wrapper-{{ section.id }}">

    {% if section.settings.title != blank or section.settings.subtitle != blank or section.settings.title_image != blank %}
      <div class="tp-testimonials__header">
        {% if section.settings.title_image != blank %}
          <img
            src="{{ section.settings.title_image | image_url: width: 400 }}"
            class="tp-testimonials__header-image"
            loading="lazy"
            alt=""
            aria-hidden="true"
          >
        {% endif %}
                {% if section.settings.subtitle != blank %}
          <p class="tp-testimonials__subtitle">{{ section.settings.subtitle | escape }}</p>
        {% endif %}
        {% if section.settings.title != blank %}
          <div class="tp-testimonials__title">{{ section.settings.title }}</div>
        {% endif %}

      </div>
    {% endif %}

    <div class="swiper">
      <div class="swiper-wrapper">
        {% for block in section.blocks %}
          <div class="swiper-slide" {{ block.shopify_attributes }}>
            {% if block.type == 'image' %}
              <div class="tp-image">
                {% if block.settings.image != blank %}
                  {{ block.settings.image | image_url: width: 1200 | image_tag:
                    loading: 'lazy',
                    widths: '375, 750, 1100',
                    alt: ''
                  }}
                {% endif %}
              </div>

            {% elsif block.type == 'testimonial' %}
              <div class="tp-testimonial-block tp-review-{{ block.id }}">
                {% if block.settings.image != blank %}
                  <img
                    src="{{ block.settings.image | image_url: width: 200 }}"
                    class="tp-testimonial-block__icon"
                    loading="lazy"
                    alt=""
                    aria-hidden="true"
                  >
                {% endif %}

                {% if block.settings.richtext != blank %}
                  <div class="tp-text-wrapper">
                    {{ block.settings.richtext }}
                  </div>
                {% endif %}

                {% if block.settings.author %}
                  <div class="tp-author">
                    {% if block.settings.author_image != blank %}
                      <img
                        src="{{ block.settings.author_image | image_url: width: 120 }}"
                        class="tp-author__image"
                        loading="lazy"
                        alt="{{ block.settings.author_name | escape }}"
                        width="{{ block.settings.author_img_size_desktop }}"
                        height="{{ block.settings.author_img_size_desktop }}"
                      >
                    {% endif %}
                    <div class="tp-author__text-wrapper">
                      {% if block.settings.author_name != blank %}
                        <p class="tp-author__name">{{ block.settings.author_name | escape }}</p>
                      {% endif %}
                      {% if block.settings.author_instagram != blank %}
                        <p class="tp-author__handle">{{ block.settings.author_instagram | escape }}</p>
                      {% endif %}
                    </div>
                  </div>
                {% endif %}
              </div>
            {% endif %}
          </div>
        {% endfor %}
      </div>

      {% if navigation %}
        <div class="swiper-button-prev">
          {% if section.settings.navigation_prev_image != blank %}
            <img src="{{ section.settings.navigation_prev_image | image_url }}" alt="" loading="lazy">
          {% else %}
            {{ 'tp-button-prev.svg' | inline_asset_content }}
          {% endif %}
        </div>
        <div class="swiper-button-next">
          {% if section.settings.navigation_next_image != blank %}
            <img src="{{ section.settings.navigation_next_image | image_url }}" alt="" loading="lazy">
          {% else %}
            {{ 'tp-button-next.svg' | inline_asset_content }}
          {% endif %}
        </div>
      {% endif %}
    </div>

    {% if pagination %}
      <div class="swiper-pagination"></div>
    {% endif %}

  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const swiper_{{ section.id | replace: '-', '_' }} = new Swiper('.{{ section.id }} .swiper', {
      slidesPerView: 1.2,
      spaceBetween: 12,
      centerInsufficientSlides:true,
      centeredSlides:true,
      breakpoints: {
        768: { slidesPerView: 2.2, spaceBetween: 16, centeredSlides:false },
        1024: { slidesPerView: 3.2, spaceBetween: 24, centeredSlides:false },
        1280: { slidesPerView: 3.2, spaceBetween: 32, centeredSlides:false }
      },
      {% if pagination %}
        pagination: {
          el: '.{{ section.id }} .swiper-pagination',
          clickable: true
        },
      {% endif %}
      {% if navigation %}
        navigation: {
          prevEl: '.{{ section.id }} .swiper-button-prev',
          nextEl: '.{{ section.id }} .swiper-button-next'
        },
      {% endif %}
    });
  });
</script>

