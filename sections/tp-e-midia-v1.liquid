{{ 'tp-e-midia-v1.css' | asset_url | stylesheet_tag }}

{% render 'tp-section-padding',
  pad_top_min: section.settings.pad_top_min,
  pad_top_max: section.settings.pad_top_max,
  pad_bottom_min: section.settings.pad_bottom_min,
  pad_bottom_max: section.settings.pad_bottom_max,
  enable_pad_top_mobile: section.settings.enable_pad_top_mobile,
  pad_top_mobile: section.settings.pad_top_mobile,
  enable_pad_bottom_mobile: section.settings.enable_pad_bottom_mobile,
  pad_bottom_mobile: section.settings.pad_bottom_mobile,
  enable_pad_top_desktop: section.settings.enable_pad_top_desktop,
  pad_top_desktop: section.settings.pad_top_desktop,
  enable_pad_bottom_desktop: section.settings.enable_pad_bottom_desktop,
  pad_bottom_desktop: section.settings.pad_bottom_desktop
%}

{% style %}
.{{ section.id }} {
  {% if section.settings.background_type == 'color' and section.settings.background_color != blank %}
    background: {{ section.settings.background_color }};
  {% elsif section.settings.background_type == 'gradient' and section.settings.background_gradient != blank %}
    background: {{ section.settings.background_gradient }};
  {% endif %}
}

.{{ section.id }} .tp-e-midia-v1__track {
  --tp-midia-gap: {{ section.settings.gap }}px;
  --tp-midia-logo-width: {{ section.settings.logo_width }}px;
  --tp-midia-logo-height: {{ section.settings.logo_height }}px;
  --tp-midia-logo-width-mobile: {{ section.settings.logo_width_mobile }}px;
  --tp-midia-divider-color: {{ section.settings.divider_color }};
  --tp-midia-speed: {{ section.settings.speed }}s;
  {% if section.settings.pause_on_hover %}
    --tp-midia-pause-hover: paused;
  {% endif %}
}

{% if section.settings.title_custom %}
  .{{ section.id }} .tp-e-midia-v1__title {
    color: {{ section.settings.title_color }};
    font-size: {{ section.settings.title_size_mobile }}px;
    font-weight: {{ section.settings.title_weight }};
  }

  @media screen and (min-width: 768px) {
    .{{ section.id }} .tp-e-midia-v1__title {
      font-size: {{ section.settings.title_size_desktop }}px;
    }
  }
{% endif %}
{% endstyle %}

<section class="tp-e-midia-v1 {{ section.id }} scroll-trigger animate--fade-in">
  <div class="tp-wrapper tp-e-midia-v1__wrapper" id="section-wrapper-{{ section.id }}">
    {% if section.settings.title != blank %}
      <h2 class="tp-e-midia-v1__title tp-h4">{{ section.settings.title | escape }}</h2>
    {% endif %}

    {%- capture logo_items -%}
      {% for block in section.blocks %}
        {% if section.settings.show_divider %}
          <span class="tp-e-midia-v1__divider" aria-hidden="true"></span>
        {% endif %}

        <div class="tp-e-midia-v1__item" {{ block.shopify_attributes }}>
          {% if block.settings.url != blank %}
            <a href="{{ block.settings.url }}" class="tp-e-midia-v1__logo-link" target="_blank" rel="noopener noreferrer">
          {% endif %}

          {% if block.settings.logo != blank %}
            {{ block.settings.logo | image_url: width: 400 | image_tag:
              class: 'tp-e-midia-v1__logo',
              loading: 'lazy',
              widths: '100, 200, 300, 400',
              sizes: '(min-width: 768px) 160px, 100px'
            }}
          {% else %}
            <div class="tp-e-midia-v1__logo-placeholder">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          {% endif %}

          {% if block.settings.url != blank %}
            </a>
          {% endif %}
        </div>
      {% endfor %}
    {%- endcapture -%}

    <div class="tp-e-midia-v1__track" aria-label="Logos na mídia">
      <div class="tp-e-midia-v1__logos">
        {{ logo_items }}{{ logo_items }}{{ logo_items }}{{ logo_items }}{{ logo_items }}
      </div>
      <div class="tp-e-midia-v1__logos" aria-hidden="true">
        {{ logo_items }}{{ logo_items }}{{ logo_items }}{{ logo_items }}{{ logo_items }}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Na Mídia",
  "class": "E__MIDIA__V1",
  "settings": [
    {
      "type": "header",
      "content": "Conteúdo"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Título",
      "default": "na mídia"
    },
    {
      "type": "checkbox",
      "id": "show_divider",
      "label": "Exibir divisor entre logos",
      "default": true
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Largura do logo (desktop)",
      "min": 60,
      "max": 300,
      "step": 5,
      "default": 160,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "logo_width_mobile",
      "label": "Largura do logo (mobile)",
      "min": 60,
      "max": 200,
      "step": 5,
      "default": 100,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "logo_height",
      "label": "Altura do logo",
      "min": 24,
      "max": 120,
      "step": 4,
      "default": 48,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Espaço entre logos",
      "min": 8,
      "max": 64,
      "step": 4,
      "default": 24,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Velocidade da animação",
      "min": 5,
      "max": 60,
      "step": 5,
      "default": 20,
      "unit": "s"
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pausar ao passar o mouse",
      "default": true
    },
    {
      "type": "header",
      "content": "Aparência"
    },
    {
      "type": "select",
      "id": "background_type",
      "label": "Tipo de fundo",
      "default": "color",
      "options": [
        { "label": "Cor sólida", "value": "color" },
        { "label": "Gradiente", "value": "gradient" }
      ]
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Cor de fundo",
      "default": "#FFFFFF",
      "visible_if": "{{ section.settings.background_type == 'color' }}"
    },
    {
      "type": "color_background",
      "id": "background_gradient",
      "label": "Gradiente",
      "visible_if": "{{ section.settings.background_type == 'gradient' }}"
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Cor do divisor",
      "default": "#E5E5E5"
    },
    {
      "type": "header",
      "content": "Tipografia — Título"
    },
    {
      "type": "checkbox",
      "id": "title_custom",
      "label": "Personalizar",
      "default": false
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Cor",
      "default": "#101828",
      "visible_if": "{{ section.settings.title_custom }}"
    },
    {
      "type": "range",
      "id": "title_size_desktop",
      "label": "Tamanho desktop (px)",
      "min": 14,
      "max": 56,
      "step": 2,
      "default": 24,
      "visible_if": "{{ section.settings.title_custom }}"
    },
    {
      "type": "range",
      "id": "title_size_mobile",
      "label": "Tamanho mobile (px)",
      "min": 14,
      "max": 40,
      "step": 2,
      "default": 20,
      "visible_if": "{{ section.settings.title_custom }}"
    },
    {
      "type": "select",
      "id": "title_weight",
      "label": "Peso",
      "default": "500",
      "options": [
        { "label": "Regular (400)", "value": "400" },
        { "label": "Médio (500)", "value": "500" },
        { "label": "Semi-negrito (600)", "value": "600" },
        { "label": "Negrito (700)", "value": "700" }
      ],
      "visible_if": "{{ section.settings.title_custom }}"
    },
    {
      "type": "header",
      "content": "Espaçamento"
    },
    {
      "type": "range",
      "id": "pad_top_min",
      "label": "Padding superior mínimo (px)",
      "min": 0,
      "max": 200,
      "step": 4,
      "default": 48
    },
    {
      "type": "range",
      "id": "pad_top_max",
      "label": "Padding superior máximo (px)",
      "min": 0,
      "max": 200,
      "step": 4,
      "default": 96
    },
    {
      "type": "range",
      "id": "pad_bottom_min",
      "label": "Padding inferior mínimo (px)",
      "min": 0,
      "max": 200,
      "step": 4,
      "default": 48
    },
    {
      "type": "range",
      "id": "pad_bottom_max",
      "label": "Padding inferior máximo (px)",
      "min": 0,
      "max": 200,
      "step": 4,
      "default": 96
    },
    {
      "type": "header",
      "content": "Personalizar espaçamento por dispositivo"
    },
    {
      "type": "checkbox",
      "id": "enable_pad_top_mobile",
      "label": "Ativar padding superior no mobile",
      "default": false
    },
    {
      "type": "range",
      "id": "pad_top_mobile",
      "label": "Padding superior mobile (px)",
      "min": 0,
      "max": 200,
      "step": 4,
      "default": 0,
      "visible_if": "{{ section.settings.enable_pad_top_mobile }}"
    },
    {
      "type": "checkbox",
      "id": "enable_pad_bottom_mobile",
      "label": "Ativar padding inferior no mobile",
      "default": false
    },
    {
      "type": "range",
      "id": "pad_bottom_mobile",
      "label": "Padding inferior mobile (px)",
      "min": 0,
      "max": 200,
      "step": 4,
      "default": 0,
      "visible_if": "{{ section.settings.enable_pad_bottom_mobile }}"
    },
    {
      "type": "checkbox",
      "id": "enable_pad_top_desktop",
      "label": "Ativar padding superior no desktop",
      "default": false
    },
    {
      "type": "range",
      "id": "pad_top_desktop",
      "label": "Padding superior desktop (px)",
      "min": 0,
      "max": 200,
      "step": 4,
      "default": 0,
      "visible_if": "{{ section.settings.enable_pad_top_desktop }}"
    },
    {
      "type": "checkbox",
      "id": "enable_pad_bottom_desktop",
      "label": "Ativar padding inferior no desktop",
      "default": false
    },
    {
      "type": "range",
      "id": "pad_bottom_desktop",
      "label": "Padding inferior desktop (px)",
      "min": 0,
      "max": 200,
      "step": 4,
      "default": 0,
      "visible_if": "{{ section.settings.enable_pad_bottom_desktop }}"
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Imagem"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Na Mídia",
      "category": "Imagem",
      "settings": {
        "title": "na mídia",
        "show_divider": true,
        "background_color": "#FFFFFF"
      },
      "blocks": [
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" }
      ]
    }
  ]
}
{% endschema %}
