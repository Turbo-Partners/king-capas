        {
            "type": "color_background",
            "id": "background_gradient",
            "label": "Gradiente do Background",
            "visible_if": "{{ section.settings.background_type == 'gradient' }}"
        },
        {
            "type": "image_picker",
            "id": "background_image_mobile",
            "label": "Imagem Mobile do Background",
            "visible_if": "{{ section.settings.background_type == 'image' }}"
        },
        {
            "type": "image_picker",
            "id": "background_image_desktop",
            "label": "Imagem Desktop do Background",
            "visible_if": "{{ section.settings.background_type == 'image' }}"
        },
        {
            "type": "header",
            "content": "Conteúdo"
        },
        {
            "type": "text",
            "id": "title",
            "label": "Titulo",
            "default": "Coleção"
        },
        {
            "type": "text",
            "id": "button_text",
            "label": "Texto do botao",
            "default": "Ver tudo"
        },
        {
            "type": "url",
            "id": "button_url",
            "label": "Link do botao"
        },
        {
            "type": "checkbox",
            "label": "Botão embaixo no Mobile",
            "id": "button_below_mobile",
            "default": true
        },
        {
            "type": "collection",
            "id": "collection",
            "label": "Colecao"
        },
        {
            "type": "product_list",
            "id": "product_list",
            "label": "Lista de produtos"
        },
        {
            "type": "header",
            "content": "Spacing"
        },
        {
            "type": "header",
            "content": "Slider"
        },
        {
            "type": "checkbox",
            "id": "autoplay",
            "label": "Autoplay",
            "default": false
        },
        {
            "type": "range",
            "id": "autoplay_time",
            "label": "Tempo de autoplay",
            "default": 3,
            "min": 2,
            "max": 10,
            "step": 1,
            "unit": "s",
            "visible_if": "{{ section.settings.autoplay }}"
        },
        {
            "type": "checkbox",
            "id": "pagination",
            "label": "Paginação",
