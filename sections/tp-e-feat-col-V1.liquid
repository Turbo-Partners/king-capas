        },
        {
            "type": "color",
            "id": "pagination_color",
            "label": "Cor normal",
            "default": "#B1BFAB",
            "visible_if": "{{ section.settings.pagination }}"
        },
        {
            "type": "color",
            "id": "pagination_color_active",
            "label": "Cor ativa",
            "default": "#000000",
            "visible_if": "{{ section.settings.pagination }}"
        },
        {
            "type": "checkbox",
