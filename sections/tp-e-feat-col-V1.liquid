{{ 'tp-feat-col.css' | asset_url | stylesheet_tag }}

{% render 'tp-section-padding',
  pad_top_min: section.settings.pad_top_min,
  pad_top_max: section.settings.pad_top_max,
  pad_bottom_min: section.settings.pad_bottom_min,
  pad_bottom_max: section.settings.pad_bottom_max,
  enable_pad_top_mobile: section.settings.enable_pad_top_mobile,
  pad_top_mobile: section.settings.pad_top_mobile,
  enable_pad_bottom_mobile: section.settings.enable_pad_bottom_mobile,
  pad_bottom_mobile: section.settings.pad_bottom_mobile,
  enable_pad_top_desktop: section.settings.enable_pad_top_desktop,
  pad_top_desktop: section.settings.pad_top_desktop,
  enable_pad_bottom_desktop: section.settings.enable_pad_bottom_desktop,
  pad_bottom_desktop: section.settings.pad_bottom_desktop
%}

{% liquid
  assign background_type = section.settings.background_type
  assign autoplay = section.settings.autoplay
  assign autoplay_time = section.settings.autoplay_time | times: 1000
  assign pagination = section.settings.pagination
  assign navigation = section.settings.navigation
  assign button_animation = section.settings.button_animation

  if section.settings.product_list.size > 0
    assign tp_featured_collection_products = section.settings.product_list
  else
    assign tp_featured_collection_products = section.settings.collection.products
  endif
%}

{% style %}
.{{ section.id }} {
	background-size: cover;
	background-repeat: no-repeat;
	background-position: center;

	{% if background_type == "image" and section.settings.background_image_mobile != blank %}
		background-image: url('{{ section.settings.background_image_mobile | image_url }}');

		{% if section.settings.background_image_desktop != blank %}
			@media screen and (min-width: 1024px) {
				background-image: url('{{ section.settings.background_image_desktop | image_url }}');
			}
		{% endif %}
	{% elsif background_type == "color" and section.settings.background_color != blank %}
		background: {{ section.settings.background_color }};
	{% elsif background_type == "gradient" and section.settings.background_gradient != blank %}
		background: {{ section.settings.background_gradient }};
	{% endif %}

  .tp-feat-col__accent {
    background: linear-gradient(90deg, {{ section.settings.accent_color_from }} 0%, {{ section.settings.accent_color_via }} 50%, {{ section.settings.accent_color_from }} 100%);
    display: block !important;
    height: clamp(0.4000rem, calc(0.2514rem + 0.3810vw), 0.8000rem);
  }

  {% if section.settings.title_custom %}
    .tp-feat-col__title * {
      color: {{ section.settings.title_color }};
      font-size: {{ section.settings.title_size_mobile }}px;
      font-weight: {{ section.settings.title_weight }};
    }
    @media screen and (min-width: 768px) {
      .tp-feat-col__title * {
        font-size: {{ section.settings.title_size_desktop }}px;
      }
    }
  {% endif %}

    {% if pagination %}
        .swiper-pagination {
            position: relative;
            display:flex;
            align-items:center;
            justify-content:center;
            gap:8px;

            @media screen and (min-width: 768px) {
                display: none;
            }

            .swiper-pagination-bullet {
                margin:0;
            }
        }

        {% if section.settings.pagination_hide_mobile %}
            @media screen and (max-width: 767px) {
                .swiper-pagination { display: none; }
            }
        {% endif %}

        {% if section.settings.pagination_custom %}
            .swiper-pagination-bullet {
                width: {{ section.settings.pagination_size }}px;
                height: {{ section.settings.pagination_size }}px;
                background: {{ section.settings.pagination_color }};
                opacity: 1;
                {% if section.settings.pagination_border %}
                    border: {{ section.settings.pagination_border_width }}px solid {{ section.settings.pagination_border_color }};
                {% else %}
                    border: none;
                {% endif %}
            }

            .swiper-pagination-bullet-active {
                width: {{ section.settings.pagination_size_active }}px;
                height: {{ section.settings.pagination_size_active }}px;
                background: {{ section.settings.pagination_color_active }};
                {% if section.settings.pagination_border %}
                    border: {{ section.settings.pagination_border_width }}px solid {{ section.settings.pagination_border_color_active }};
                {% else %}
                    border: none;
                {% endif %}
            }
        {% else %}
            .swiper-pagination-bullet {
                background: {{ section.settings.pagination_color }};
            }

            .swiper-pagination-bullet-active {
                background: {{ section.settings.pagination_color_active }};
            }
        {% endif %}
    {% endif %}

	{% if navigation %}
		.swiper-button-prev, .swiper-button-next {
			width: clamp(2.4rem, 2.1029rem + 0.7619vw, 3.2rem);
            display: none;

            @media screen and (min-width: 768px) {
                display: flex;
            }

            svg {
                fill: none;
            }

			&::after {
				content: '';
                color: transparent;
			}
		}

        .swiper-button-prev {
            left: 16px;

            @media screen and (min-width: 768px) {
                left: 32px;
            }

            @media screen and (min-width: 1024px) {
                left: 40px;
            }
        }

        .swiper-button-next {
            right: 16px;

            @media screen and (min-width: 768px) {
                right: 32px;
            }

            @media screen and (min-width: 1024px) {
                right: 40px;
            }
        }
	{% endif %}
}

{% if section.settings.button_custom %}
  .{{ section.id }} .tp-feat-col__cta {
    {% if section.settings.button_bg_color != blank %}
      background: {{ section.settings.button_bg_color }};
    {% endif %}
    {% if section.settings.button_text_color != blank %}
      color: {{ section.settings.button_text_color }};
    {% endif %}
    {% if section.settings.button_border_radius != "default" %}
      {% if section.settings.button_border_radius == "none" %}
        border-radius: 0;
      {% else %}
        border-radius: var(--tp-radius-{{ section.settings.button_border_radius }});
      {% endif %}
    {% endif %}
    font-size: {{ section.settings.button_font_size }}px;
    font-weight: {{ section.settings.button_font_weight }};
  }
{% endif %}
{% endstyle %}

<section class="tp-featured-collection {{ section.id }} scroll-trigger animate--fade-in">
    <div class="tp-wrapper tp-featured-collection__wrapper" id="section-wrapper-{{ section.id }}">
        {% if section.settings.title != blank %}
            <div class="tp-feat-col__header">
                <div class="tp-feat-col__title">
                    {{ section.settings.title }}
                </div>
                <div class="tp-feat-col__accent" aria-hidden="true"></div>
            </div>
        {% endif %}

        {% if tp_featured_collection_products != blank %}
            <div class="swiper">
                <div class="swiper-wrapper">
                    {% for product in tp_featured_collection_products %}
                        <div class="swiper-slide">
                            {% render 'tp-product-card',
                                tp_product: product,
                                show_price: true,
                                show_button: false,
                                add_to_cart: true,
                                show_badges: false,
                                change_image_hover: true,
                                show_installments: true
                            %}
                        </div>
                    {% endfor %}
                </div>
                {% if navigation == true %}
                    <div class="swiper-button-prev">
                        {% if section.settings.navigation_prev_image != blank %}
                            <img src="{{ section.settings.navigation_prev_image | image_url }}" alt="">
                        {% else %}
                            {{ 'tp-button-prev.svg' | inline_asset_content }}
                        {% endif %}
                    </div>
                    <div class="swiper-button-next">
                        {% if section.settings.navigation_next_image != blank %}
                            <img src="{{ section.settings.navigation_next_image | image_url }}" alt="">
                        {% else %}
                            {{ 'tp-button-next.svg' | inline_asset_content }}
                        {% endif %}
                    </div>
                {% endif %}
            </div>

            {% if pagination %}
                <div class="swiper-pagination"></div>
            {% endif %}
        {% endif %}

        {% if section.settings.button_text != blank and section.settings.button_url != blank %}
            <a
              class="tp-feat-col__cta{% if button_animation != 'none' %} tp-feat-col__cta--{{ button_animation }}{% endif %}"
              href="{{ section.settings.button_url }}"
            >
                {{ section.settings.button_text }}
            </a>
        {% endif %}
    </div>
</section>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const swiper_{{ section.id | replace: '-', '_' }} = new Swiper('.{{ section.id }} .swiper', {
            slidesPerView: 1.15,
            spaceBetween: 8,
            slidesOffsetBefore: 16,
            slidesOffsetAfter: 16,
            breakpoints: {
                728: {
                    slidesPerView: 2.2,
                    spaceBetween: 16,
                    slidesOffsetBefore: 32
                },
                1024: {
                    slidesPerView: 4,
                    spaceBetween: 16,
                    slidesOffsetBefore: 40
                },
                1280: {
                    slidesPerView: 4.2,
                    spaceBetween: 16,
                    slidesOffsetBefore: 40
                }
            },
            {% if autoplay %}
                autoplay: {
                    delay: {{ autoplay_time }},
                },
            {% endif %}
            {% if pagination %}
                pagination: {
                    el: '.{{ section.id }} .swiper-pagination',
                    clickable: true,
                },
            {% endif %}
            {% if navigation %}
                navigation: {
                    prevEl: '.{{ section.id }} .swiper-button-prev',
                    nextEl: '.{{ section.id }} .swiper-button-next'
                }
            {% endif %}
        });
    });
</script>

