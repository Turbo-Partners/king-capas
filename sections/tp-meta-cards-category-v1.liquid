    }
  ],
  "presets": [
    {
      "name": "Cards category - meta ",
      "category": "Tp - Meta",
      "settings": {
        "bg_color": "#FFFFFF",
        "preview_title": "Tecnologia que cuida de tudo pra você"
      }
    }
  ]
