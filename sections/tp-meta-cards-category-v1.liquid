{{ 'tp-meta-cards-tecnologia-v1.css' | asset_url | stylesheet_tag }}

{% render 'tp-section-padding',
  pad_top_min: section.settings.pad_top_min,
  pad_top_max: section.settings.pad_top_max,
  pad_bottom_min: section.settings.pad_bottom_min,
  pad_bottom_max: section.settings.pad_bottom_max,
  enable_pad_top_mobile: section.settings.enable_pad_top_mobile,
  pad_top_mobile: section.settings.pad_top_mobile,
  enable_pad_bottom_mobile: section.settings.enable_pad_bottom_mobile,
  pad_bottom_mobile: section.settings.pad_bottom_mobile,
  enable_pad_top_desktop: section.settings.enable_pad_top_desktop,
  pad_top_desktop: section.settings.pad_top_desktop,
  enable_pad_bottom_desktop: section.settings.enable_pad_bottom_desktop,
  pad_bottom_desktop: section.settings.pad_bottom_desktop
%}

{% liquid
  assign cards_meta = product.metafields.custom.detalhes_que_elevam_o_padrao.value
  if cards_meta != blank
    assign imagens = cards_meta.imagem_card.value
    assign titulos = cards_meta.titulo.value
    assign textos  = cards_meta.texto.value
    assign titulo_secao = cards_meta.titulo_da_secao
  endif
%}

{% style %}
  .{{ section.id }} {
    background: {{ section.settings.bg_color }};

    {% if section.settings.title_custom %}
      --tp-mct-title-color: {{ section.settings.title_color }};
      --tp-mct-title-size-mobile: {{ section.settings.title_size_mobile }}px;
      --tp-mct-title-size-desktop: {{ section.settings.title_size_desktop }}px;
      --tp-mct-title-weight: {{ section.settings.title_weight }};
    {% endif %}

    {% if section.settings.card_title_custom %}
      --tp-mct-card-title-color: {{ section.settings.card_title_color }};
      --tp-mct-card-title-size-mobile: {{ section.settings.card_title_size_mobile }}px;
      --tp-mct-card-title-size-desktop: {{ section.settings.card_title_size_desktop }}px;
      --tp-mct-card-title-weight: {{ section.settings.card_title_weight }};
    {% endif %}

    {% if section.settings.card_text_custom %}
      --tp-mct-card-text-color: {{ section.settings.card_text_color }};
      --tp-mct-card-text-size-mobile: {{ section.settings.card_text_size_mobile }}px;
      --tp-mct-card-text-size-desktop: {{ section.settings.card_text_size_desktop }}px;
      --tp-mct-card-text-weight: {{ section.settings.card_text_weight }};
    {% endif %}
  }
{% endstyle %}
{% if cards_meta %}

<tp-meta-cards-tecnologia>
  <section class="tp-meta-cards-tecnologia-v1 {{ section.id }} scroll-trigger animate--slide-in" id="section-wrapper-{{ section.id }}">

    <div class="tp-wrapper tp-meta-cards-tecnologia-v1__header">
      {% assign display_title = titulo_secao | default: section.settings.preview_title %}
      {% if display_title != blank %}
        <div class="tp-meta-cards-tecnologia-v1__title-wrapper">
          <div class="tp-meta-cards-tecnologia-v1__title">{{ display_title |  metafield_tag}}</div>
        </div>
      {% endif %}
    </div>

    <div class="tp-meta-cards-tecnologia-v1__swiper-outer">
      <div class="tp-meta-cards-tecnologia-v1__swiper swiper">
        <div class="swiper-wrapper">

          {% if imagens != blank %}
            {% for imagem in imagens %}
              {% assign card_titulo = titulos[forloop.index0] %}
              {% assign card_texto  = textos[forloop.index0] %}
              <div class="swiper-slide tp-meta-cards-tecnologia-v1__slide">
                <article class="tp-meta-cards-tecnologia-v1__card">
                  <div class="tp-meta-cards-tecnologia-v1__image-wrapper">
                    {{ imagem | image_url: width: 800 | image_tag:
                      class: 'tp-meta-cards-tecnologia-v1__image',
                      loading: 'lazy',
                      widths: '400, 600, 800',
                      sizes: '(min-width: 1024px) 30vw, (min-width: 600px) 45vw, 80vw',
                      alt: card_titulo | default: ''
                    }}
                  </div>
                  <div class="tp-meta-cards-tecnologia-v1__content">
                    {% if card_titulo != blank %}
                      <p class="tp-meta-cards-tecnologia-v1__card-title">{{ card_titulo | escape }}</p>
                    {% endif %}
                    {% if card_texto != blank %}
                      <p class="tp-meta-cards-tecnologia-v1__card-text">{{ card_texto | escape }}</p>
                    {% endif %}
                  </div>
                </article>
              </div>
            {% endfor %}

          {% else %}
            {%- comment -%} Preview no Theme Editor — placeholder {%- endcomment -%}
            {% assign preview_titles = 'Babá eletrônica inteligente,Câmera para pets,Segurança dentro de casa,Cuidado 24h' | split: ',' %}
            {% assign preview_texts  = 'Acompanhe o sono do seu bebê em tempo real, direto do celular.,Veja o que seu pet está fazendo quando você não está em casa.,Transforme qualquer ambiente em um ponto de vigilância e veja tudo ao vivo.,Mais tranquilidade para você e sua família, onde quer que você esteja.' | split: ',' %}
            {% for preview_title in preview_titles %}
              <div class="swiper-slide tp-meta-cards-tecnologia-v1__slide">
                <article class="tp-meta-cards-tecnologia-v1__card tp-meta-cards-tecnologia-v1__card--preview">
                  <div class="tp-meta-cards-tecnologia-v1__image-wrapper">
                    {{ 'image' | placeholder_svg_tag: 'tp-meta-cards-tecnologia-v1__image tp-meta-cards-tecnologia-v1__image--placeholder' }}
                  </div>
                  <div class="tp-meta-cards-tecnologia-v1__content">
                    <p class="tp-meta-cards-tecnologia-v1__card-title">{{ preview_title }}</p>
                    <p class="tp-meta-cards-tecnologia-v1__card-text">{{ preview_texts[forloop.index0] }}</p>
                  </div>
                </article>
              </div>
            {% endfor %}
          {% endif %}

        </div>
      </div>
    </div>

  </section>
</tp-meta-cards-tecnologia>

<script>
  (function () {
    class TpMetaCardsTecnologia extends HTMLElement {
      connectedCallback() {
        this._onResize = () => this._adjustOffset();
        window.addEventListener('resize', this._onResize);

        requestAnimationFrame(() => {
          this._adjustOffset();
          this._initSwiper();
        });
      }

      disconnectedCallback() {
        window.removeEventListener('resize', this._onResize);
        if (this._swiper) this._swiper.destroy(true, true);
      }

      _adjustOffset() {
        const header = this.querySelector('.tp-meta-cards-tecnologia-v1__header');
        const swiperOuter = this.querySelector('.tp-meta-cards-tecnologia-v1__swiper-outer');
        if (!header || !swiperOuter) return;

        const rect = header.getBoundingClientRect();
        const paddingLeft = parseFloat(getComputedStyle(header).paddingLeft) || 0;
        const contentLeft = rect.left + paddingLeft;

        swiperOuter.style.paddingLeft = contentLeft + 'px';
      }

      _initSwiper() {
        if (!window.Swiper) return;

        this._swiper = new Swiper(
          this.querySelector('.tp-meta-cards-tecnologia-v1__swiper'),
          {
            slidesPerView: 1.2,
            spaceBetween: 16,
            grabCursor: true,
            breakpoints: {
              600: { slidesPerView: 2.2, spaceBetween: 20 },
              1024: { slidesPerView: 3.5, spaceBetween: 24 },
            },
          }
        );
      }
    }

    if (!customElements.get('tp-meta-cards-tecnologia')) {
      customElements.define('tp-meta-cards-tecnologia', TpMetaCardsTecnologia);
    }
  })();
</script>
        {% endif %}

{% schema %}
{
  "name": "Cards Tecnologia",
  "class": "E__META_CARDS_TECNOLOGIA__V1",
  "settings": [
    {
      "type": "header",
      "content": "Conteúdo"
    },
    {
      "type": "text",
      "id": "preview_title",
      "label": "Título (preview)",
      "info": "Exibido apenas no Theme Editor quando o metafield não está disponível.",
      "default": "Tecnologia que cuida de tudo pra você"
    },
    {
      "type": "header",
      "content": "Aparência"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Cor do fundo",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Tipografia — Título da Seção"
    },
    {
      "type": "checkbox",
      "id": "title_custom",
      "label": "Personalizar",
      "default": false
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Cor",
      "default": "#1A1A1A",
      "visible_if": "{{ section.settings.title_custom }}"
    },
    {
      "type": "range",
      "id": "title_size_mobile",
      "label": "Tamanho (mobile)",
      "min": 16,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 28,
      "visible_if": "{{ section.settings.title_custom }}"
    },
    {
      "type": "range",
      "id": "title_size_desktop",
      "label": "Tamanho (desktop)",
      "min": 16,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 40,
      "visible_if": "{{ section.settings.title_custom }}"
    },
    {
      "type": "select",
      "id": "title_weight",
      "label": "Peso",
      "default": "700",
      "visible_if": "{{ section.settings.title_custom }}",
      "options": [
        { "label": "Normal (400)", "value": "400" },
        { "label": "Médio (500)", "value": "500" },
        { "label": "Semibold (600)", "value": "600" },
