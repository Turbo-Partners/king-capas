        { "label": "Médio (500)", "value": "500" },
        { "label": "Semibold (600)", "value": "600" },
        { "label": "Negrito (700)", "value": "700" },
        { "label": "Extra Negrito (800)", "value": "800" }
      ]
    },
    {
      "type": "header",
      "content": "Tipografia — Texto do Card"
    },
    {
      "type": "checkbox",
      "id": "card_text_custom",
      "label": "Personalizar",
      "default": false
    },
    {
      "type": "color",
      "id": "card_text_color",
      "label": "Cor",
      "default": "#555555",
      "visible_if": "{{ section.settings.card_text_custom }}"
    },
