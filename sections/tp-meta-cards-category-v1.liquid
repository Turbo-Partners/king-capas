      "label": "Personalizar",
      "default": false
    },
    {
      "type": "color",
      "id": "card_title_color",
      "label": "Cor",
      "default": "#1A1A1A",
      "visible_if": "{{ section.settings.card_title_custom }}"
    },
    {
      "type": "range",
      "id": "card_title_size_mobile",
      "label": "Tamanho (mobile)",
      "min": 12,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 16,
      "visible_if": "{{ section.settings.card_title_custom }}"
    },
    {
      "type": "range",
      "id": "card_title_size_desktop",
      "label": "Tamanho (desktop)",
      "min": 12,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 18,
      "visible_if": "{{ section.settings.card_title_custom }}"
